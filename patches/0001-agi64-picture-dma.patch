diff --git a/Source/Teensy/MinimalBoot/tests/agi-picture-conformance.mjs b/Source/Teensy/MinimalBoot/tests/agi-picture-conformance.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5a0a251fdde8e02a2310fe5f1598060e624c2690
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/tests/agi-picture-conformance.mjs
@@ -0,0 +1,335 @@
+#!/usr/bin/env node
+
+// Host-side conformance model for IOH_AGIPicture.c.  This deliberately models
+// the firmware's raw EasyFlash address walk and bounded C64-RLE decoder, so the
+// boundary and fallback contract can be checked without Teensy hardware.
+
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const EASYFLASH_SIZE = 64 * 16_384;
+const PHYSICAL_PREFIX_SIZE = 24 * 16_384;
+const HALF_BANK_SIZE = 8192;
+const ERR_INVALID_SOURCE = 4;
+const ERR_SWAPPED_SOURCE = 5;
+const ERR_MALFORMED_RLE = 6;
+const ERR_DMA_UNAVAILABLE = 8;
+const ERR_DMA_PROBE_MISMATCH = 9;
+const ERR_DMA_TIMEOUT = 10;
+const CMD_DECODE_DMA = 0x01;
+const CMD_DECODE_ONLY = 0x02;
+const CMD_DMA_PROBE = 0x03;
+const CAP_FULL_DMA = 0x01;
+const CAP_DECODE_ONLY = 0x02;
+const CAP_DMA_PROBE = 0x04;
+const CAP_VIDEO_TIMING = 0x08;
+const STATUS_DONE_DMA = 0x80;
+const STATUS_DONE_DECODE_ONLY = 0x81;
+const STATUS_DONE_DMA_PROBE = 0x82;
+const STATUS_ERROR_BASE = 0xe0;
+const DMA_PROBE_ADDRESS = 0x0400;
+const DMA_PROBE_SEED = Uint8Array.from({ length: 16 }, (_, index) => index ^ 0xa5);
+const DMA_PROBE_COMPLEMENT = Uint8Array.from({ length: 16 }, (_, index) => index ^ 0x5a);
+assert.equal(CAP_FULL_DMA | CAP_VIDEO_TIMING, 0x09, 'full DMA requires data path and video timing');
+assert.equal(CAP_DECODE_ONLY, 0x02, 'decode-only must not require a DMA capability');
+assert.equal(CAP_DMA_PROBE | CAP_VIDEO_TIMING, 0x0c, 'DMA probe requires probe and video timing');
+
+// Keep the firmware register ABI in lockstep with the C64 bank-62 helper.
+const firmwareSource = fs.readFileSync(
+  new URL('../Common/IO_Handlers/IOH_AGIPicture.c', import.meta.url), 'utf8');
+const easyFlashSource = fs.readFileSync(
+  new URL('../Common/IO_Handlers/IOH_EasyFlash.c', import.meta.url), 'utf8');
+const minimalConfigSource = fs.readFileSync(
+  new URL('../Min_TeensyROM.h', import.meta.url), 'utf8');
+const dmaSource = fs.readFileSync(
+  new URL('../Common/DMAControl_Minimal.h', import.meta.url), 'utf8');
+const mailboxAssignments = new Map([
+  ['AGIPicReg_ID0', '0xF0'], ['AGIPicReg_ID1', '0xF1'],
+  ['AGIPicReg_ID2', '0xF2'], ['AGIPicReg_ID3', '0xF3'],
+  ['AGIPicReg_Version', '0xF4'], ['AGIPicReg_Capabilities', '0xF5'],
+  ['AGIPicReg_Command', '0xF6'], ['AGIPicReg_Status', '0xF7'],
+  ['AGIPicReg_Source0', '0xF8'], ['AGIPicReg_Source1', '0xF9'],
+  ['AGIPicReg_Source2', '0xFA'], ['AGIPicReg_Error', '0xFB'],
+  ['AGIPicReg_DecodeMS0', '0xFC'], ['AGIPicReg_DecodeMS1', '0xFD'],
+  ['AGIPicReg_VideoStandard', '0xFE'], ['AGIPicReg_Reserved', '0xFF'],
+]);
+for (const [name, value] of mailboxAssignments) {
+  assert.match(firmwareSource, new RegExp(`\\b${name}\\s*=\\s*${value}\\b`));
+}
+assert.match(firmwareSource, /AGIPicReg_ID0[^\n]*= 'A'/);
+assert.match(firmwareSource, /AGIPicReg_ID1[^\n]*= 'G'/);
+assert.match(firmwareSource, /AGIPicReg_ID2[^\n]*= 'I'/);
+assert.match(firmwareSource, /AGIPicReg_ID3[^\n]*= '\+'/);
+assert.match(firmwareSource, /AGIPicProtocolVersion\s*=\s*2/);
+assert.match(firmwareSource, /AGIPicCapability_C64RLE_DMA\s*=\s*0x01/);
+assert.match(firmwareSource, /AGIPicCapability_C64RLE_DecodeOnly\s*=\s*0x02/);
+assert.match(firmwareSource, /AGIPicCapability_DMAProbe\s*=\s*0x04/);
+assert.match(firmwareSource, /AGIPicCapability_VideoTiming\s*=\s*0x08/);
+assert.match(firmwareSource, /AGIPicCmd_DecodeDMA\s*=\s*0x01/);
+assert.match(firmwareSource, /AGIPicCmd_DecodeOnly\s*=\s*0x02/);
+assert.match(firmwareSource, /AGIPicCmd_DMAProbe\s*=\s*0x03/);
+assert.match(firmwareSource, /AGIPicStatus_DoneDMA\s*=\s*0x80/);
+assert.match(firmwareSource, /AGIPicStatus_DoneDecodeOnly\s*=\s*0x81/);
+assert.match(firmwareSource, /AGIPicStatus_DoneDMAProbe\s*=\s*0x82/);
+assert.match(firmwareSource, /AGIPicStatus_ErrorBase\s*=\s*0xE0/);
+assert.match(firmwareSource, /AGIPicError_DMAProbeMismatch\s*=\s*9/);
+assert.match(firmwareSource, /AGIPicError_DMATimeout\s*=\s*10/);
+assert.match(firmwareSource, /volatile uint8_t AGIPicPendingCommand/);
+assert.match(firmwareSource,
+  /AGIPictureApplyVideoTiming\(\)[^]*?nS_DMASetup\s*=\s*NTSC\s*\?\s*Def_nS_DMASetupNTSC\s*:\s*Def_nS_DMASetupPAL[^]*?nS_MaxAdj\s*=\s*NTSC\s*\?\s*Def_nS_MaxAdjNTSC\s*:\s*Def_nS_MaxAdjPAL/);
+assert.match(firmwareSource,
+  /PerformDMA\(true, AGIPicDMAProbeAddress, AGIPicDMAProbeBuffer,[^]*?AGIPicError_DMAProbeMismatch[^]*?PerformDMA\(false, AGIPicDMAProbeAddress, AGIPicDMAProbeBuffer/);
+assert.match(firmwareSource,
+  /Command == AGIPicCmd_DecodeOnly[^]*?AGIPicStatus_DoneDecodeOnly/);
+assert.match(firmwareSource,
+  /AGIPicPhysicalPrefixSize\s*=\s*24u\s*\*\s*16384u/);
+assert.match(easyFlashSource,
+  /case 0x00:[^]*?if \(AGIPictureBusy\(\)\) break;[^]*?Data &= 0x3f;/);
+assert.match(easyFlashSource,
+  /AGIPictureIO2Hndlr\(Address, R_Wn,[^]*?CurrentEasyFlashBank == 62/);
+assert.match(easyFlashSource,
+  /CurrentEasyFlashBank = Data;[^]*?AGIPictureBankChanged\(\);/);
+assert.match(firmwareSource,
+  /AGIPictureBankChanged\(\)[^]*?if \(!AGIPicActive\) AGIPicUnlockStage = 0;/);
+assert.match(firmwareSource,
+  /Address == AGIPicReg_ID2[^]*?AGIPicUnlockStage = 3[^]*?Address == AGIPicReg_ID3[^]*?Data == '\+'[^]*?AGIPicUnlockStage = 4[^]*?Address == AGIPicReg_Version[^]*?AGIPictureActivate/);
+assert.match(dmaSource,
+  /AGIDMA_StateTimeoutCycles[^]*?AGIDMA_Phi2TimeoutCycles[^]*?AGIDMAEmergencyRelease\(\)[^]*?SetRWInput[^]*?SetAddrPortDirIn[^]*?SetAddrBufsIn[^]*?SetDataPortDirIn[^]*?SetDataBufIn[^]*?SetDMADeassert/);
+assert.match(dmaSource,
+  /#include <util\/atomic\.h>[^]*?uint32_t InterruptMask\s*=\s*__get_primask\(\);[^]*?__disable_irq\(\);[^]*?AGIDMA_Failed\s*=\s*true;[^]*?SetDMADeassert;[^]*?DMA_State\s*=\s*DMA_S_DisableReady;[^]*?__set_primask\(InterruptMask\);/);
+assert.match(dmaSource,
+  /SetDataBufIn;[^]*?uint32_t ReleaseStarted\s*=\s*ARM_DWT_CYCCNT;[^]*?while \(GP6_Phi2\(ReadGPIO6\)[^]*?AGIDMA_Phi2TimeoutCycles\)[^]*?SetDMADeassert;/);
+assert.match(dmaSource,
+  /AGIDMAWaitForState\(DMA_S_TransferReady\)[^]*?AGIDMAWaitForState\(DMA_S_TransferComplete\)/);
+assert.match(dmaSource, /AGIDMAWaitForPhi2\(false\)[^]*?AGIDMAWaitForPhi2\(true\)/);
+assert.match(minimalConfigSource,
+  /#define FeatAGIPictureDMA[^]*?#ifndef FeatAGIPictureDMA[^]*?#define FeatTCPListen/);
+
+function encodeC64RLE(input) {
+  const encoded = [];
+  for (let index = 0; index < input.length;) {
+    let run = 1;
+    while (index + run < input.length && input[index + run] === input[index] && run < 130) run++;
+    if (run >= 3) {
+      encoded.push(0x80 | (run - 3), input[index]);
+      index += run;
+      continue;
+    }
+
+    const literalStart = index;
+    index += run;
+    while (index < input.length && index - literalStart < 128) {
+      run = 1;
+      while (index + run < input.length && input[index + run] === input[index] && run < 130) run++;
+      if (run >= 3) break;
+      index += run;
+    }
+    const literalLength = index - literalStart;
+    encoded.push(literalLength - 1, ...input.subarray(literalStart, index));
+  }
+  return Uint8Array.from(encoded);
+}
+
+function makeBankDecode(image) {
+  return Array.from({ length: 64 }, (_, bank) => [0, 1].map((half) => ({
+    kind: 'resident',
+    bytes: image.subarray(bank * 16_384 + half * HALF_BANK_SIZE,
+                          bank * 16_384 + (half + 1) * HALF_BANK_SIZE),
+  })));
+}
+
+function decodePicture(image, bankDecode, start, lengths = [8000, 1000, 1000]) {
+  let rawOffset = start;
+
+  function readByte() {
+    if (rawOffset >= PHYSICAL_PREFIX_SIZE) throw Object.assign(new Error('invalid source'), { code: ERR_INVALID_SOURCE });
+    const bank = rawOffset >>> 14;
+    const half = (rawOffset >>> 13) & 1;
+    let source = bankDecode[bank]?.[half];
+    if (!source) throw Object.assign(new Error('invalid source'), { code: ERR_INVALID_SOURCE });
+    if (source.kind === 'swapped') throw Object.assign(new Error('swapped source'), { code: ERR_SWAPPED_SOURCE });
+    const value = source.bytes[rawOffset & 0x1fff];
+    rawOffset++;
+    return value;
+  }
+
+  function decodePlane(outputLength) {
+    const output = new Uint8Array(outputLength);
+    let produced = 0;
+    while (produced < outputLength) {
+      const control = readByte();
+      if (control & 0x80) {
+        const length = (control & 0x7f) + 3;
+        if (length > outputLength - produced) {
+          throw Object.assign(new Error('run exceeds plane'), { code: ERR_MALFORMED_RLE });
+        }
+        output.fill(readByte(), produced, produced + length);
+        produced += length;
+      } else {
+        const length = control + 1;
+        if (length > outputLength - produced) {
+          throw Object.assign(new Error('literal exceeds plane'), { code: ERR_MALFORMED_RLE });
+        }
+        for (let count = 0; count < length; count++) output[produced++] = readByte();
+      }
+    }
+    return output;
+  }
+
+  return { planes: lengths.map(decodePlane), end: rawOffset };
+}
+
+function executeCommand(command, {
+  image,
+  bankDecode,
+  start = 0,
+  c64Memory = new Uint8Array(65_536),
+  dmaAvailable = true,
+  dmaTimedOut = false,
+  videoStandard = 0,
+}) {
+  const dma = [];
+  const timing = videoStandard !== 0
+    ? { dmaSetupNS: 430, maxAdjustNS: 993, standard: 'NTSC' }
+    : { dmaSetupNS: 440, maxAdjustNS: 1030, standard: 'PAL' };
+  const failure = (error) => ({ status: STATUS_ERROR_BASE | error, error, dma, timing, c64Memory });
+
+  if (command === CMD_DMA_PROBE) {
+    if (!dmaAvailable) return failure(ERR_DMA_UNAVAILABLE);
+    if (dmaTimedOut) return failure(ERR_DMA_TIMEOUT);
+    const incoming = c64Memory.slice(DMA_PROBE_ADDRESS,
+      DMA_PROBE_ADDRESS + DMA_PROBE_SEED.length);
+    dma.push({ direction: 'read', address: DMA_PROBE_ADDRESS, bytes: incoming });
+    if (!incoming.every((value, index) => value === DMA_PROBE_SEED[index])) {
+      return failure(ERR_DMA_PROBE_MISMATCH);
+    }
+    const outgoing = incoming.map((value) => value ^ 0xff);
+    c64Memory.set(outgoing, DMA_PROBE_ADDRESS);
+    dma.push({ direction: 'write', address: DMA_PROBE_ADDRESS, bytes: outgoing });
+    return { status: STATUS_DONE_DMA_PROBE, error: 0, dma, timing, c64Memory };
+  }
+
+  if (command !== CMD_DECODE_DMA && command !== CMD_DECODE_ONLY) {
+    return failure(3);
+  }
+
+  let decoded;
+  try {
+    decoded = decodePicture(image, bankDecode, start);
+  } catch (error) {
+    return failure(error.code ?? ERR_MALFORMED_RLE);
+  }
+  if (command === CMD_DECODE_ONLY) {
+    return { status: STATUS_DONE_DECODE_ONLY, error: 0, dma, timing, c64Memory, decoded };
+  }
+  if (!dmaAvailable) return failure(ERR_DMA_UNAVAILABLE);
+  if (dmaTimedOut) return failure(ERR_DMA_TIMEOUT);
+
+  for (const [index, address] of [0x6000, 0x5c00, 0xd800].entries()) {
+    const bytes = decoded.planes[index];
+    c64Memory.set(bytes, address);
+    dma.push({ direction: 'write', address, bytes });
+  }
+  return { status: STATUS_DONE_DMA, error: 0, dma, timing, c64Memory, decoded };
+}
+
+function deterministicPlane(length, seed) {
+  const data = new Uint8Array(length);
+  let state = seed >>> 0;
+  for (let index = 0; index < length; index++) {
+    state = (Math.imul(state, 1_664_525) + 1_013_904_223) >>> 0;
+    data[index] = state >>> 24;
+  }
+  return data;
+}
+
+function expectError(expected, operation) {
+  assert.throws(operation, (error) => error.code === expected);
+}
+
+const bitmap = deterministicPlane(8000, 0x41474936);
+const screen = deterministicPlane(1000, 0x5343524e);
+const colour = new Uint8Array(1000);
+for (let index = 0; index < colour.length; index++) colour[index] = (index >>> 5) & 0x0f;
+
+const streams = [bitmap, screen, colour].map(encodeC64RLE);
+assert(streams[2].some((byte) => byte & 0x80), 'run form must be exercised');
+
+// Begin just before an 8K boundary; the mostly-literal planes also cross the
+// following 16K bank boundary and exercise both BankDecode indices.
+const start = 0x1ffb;
+const payload = Uint8Array.from(streams.flatMap((stream) => [...stream]));
+const image = new Uint8Array(EASYFLASH_SIZE);
+image.set(payload, start);
+const decode = makeBankDecode(image);
+const result = decodePicture(image, decode, start);
+assert.deepEqual(result.planes, [bitmap, screen, colour]);
+assert.equal(result.end, start + payload.length);
+assert(start < 0x2000 && result.end > 0x4000, 'fixture must cross 8K and 16K boundaries');
+
+const decodeOnly = executeCommand(CMD_DECODE_ONLY, { image, bankDecode: decode, start });
+assert.equal(decodeOnly.status, STATUS_DONE_DECODE_ONLY);
+assert.deepEqual(decodeOnly.decoded.planes, [bitmap, screen, colour]);
+assert.deepEqual(decodeOnly.dma, [], 'decode-only must never invoke DMA');
+
+const fullDMA = executeCommand(CMD_DECODE_DMA, { image, bankDecode: decode, start });
+assert.equal(fullDMA.status, STATUS_DONE_DMA);
+assert.deepEqual(fullDMA.dma.map(({ direction, address, bytes }) =>
+  [direction, address, bytes.length]), [
+  ['write', 0x6000, 8000], ['write', 0x5c00, 1000], ['write', 0xd800, 1000],
+]);
+assert.deepEqual(fullDMA.c64Memory.slice(0x6000, 0x6000 + 8000), bitmap);
+assert.deepEqual(fullDMA.c64Memory.slice(0x5c00, 0x5c00 + 1000), screen);
+assert.deepEqual(fullDMA.c64Memory.slice(0xd800, 0xd800 + 1000), colour);
+
+const probeMemory = new Uint8Array(65_536);
+probeMemory.set(DMA_PROBE_SEED, DMA_PROBE_ADDRESS);
+const dmaProbe = executeCommand(CMD_DMA_PROBE, { image, bankDecode: decode,
+  c64Memory: probeMemory, videoStandard: 1 });
+assert.equal(dmaProbe.status, STATUS_DONE_DMA_PROBE);
+assert.deepEqual(dmaProbe.dma.map(({ direction, address, bytes }) =>
+  [direction, address, bytes.length]), [
+  ['read', DMA_PROBE_ADDRESS, 16], ['write', DMA_PROBE_ADDRESS, 16],
+]);
+assert.deepEqual(dmaProbe.c64Memory.slice(DMA_PROBE_ADDRESS,
+  DMA_PROBE_ADDRESS + DMA_PROBE_SEED.length), DMA_PROBE_COMPLEMENT);
+assert.deepEqual(dmaProbe.timing,
+  { dmaSetupNS: 430, maxAdjustNS: 993, standard: 'NTSC' });
+
+const badProbeMemory = new Uint8Array(65_536);
+const badProbe = executeCommand(CMD_DMA_PROBE, { image, bankDecode: decode,
+  c64Memory: badProbeMemory, videoStandard: 0 });
+assert.equal(badProbe.status, STATUS_ERROR_BASE | ERR_DMA_PROBE_MISMATCH);
+assert.deepEqual(badProbe.dma.map(({ direction }) => direction), ['read'],
+  'probe mismatch must not perform the write');
+assert.deepEqual(badProbe.timing,
+  { dmaSetupNS: 440, maxAdjustNS: 1030, standard: 'PAL' });
+
+const timedOutProbe = executeCommand(CMD_DMA_PROBE, { image, bankDecode: decode,
+  c64Memory: probeMemory.slice(), dmaTimedOut: true });
+assert.equal(timedOutProbe.status, STATUS_ERROR_BASE | ERR_DMA_TIMEOUT);
+assert.deepEqual(timedOutProbe.dma, [], 'timed-out DMA must publish an error after cleanup');
+
+const swapped = makeBankDecode(image);
+const swappedBank = start >>> 14;
+const swappedHalf = (start >>> 13) & 1;
+swapped[swappedBank][swappedHalf] = { kind: 'swapped', offset: 0xef123456 };
+expectError(ERR_SWAPPED_SOURCE, () => decodePicture(image, swapped, start));
+
+const missingAcrossBoundary = makeBankDecode(image);
+missingAcrossBoundary[0][1] = null;
+expectError(ERR_INVALID_SOURCE, () => decodePicture(image, missingAcrossBoundary, start));
+
+const malformedImage = new Uint8Array(EASYFLASH_SIZE);
+malformedImage.set([0xff, 0x42], 0x100);
+expectError(ERR_MALFORMED_RLE,
+            () => decodePicture(malformedImage, makeBankDecode(malformedImage), 0x100, [10]));
+
+expectError(ERR_INVALID_SOURCE,
+            () => decodePicture(image, makeBankDecode(image), PHYSICAL_PREFIX_SIZE, [1]));
+
+console.log('AGI picture conformance: PASS');
+console.log(`  compressed bytes: ${payload.length}`);
+console.log(`  raw range: $${start.toString(16)}-$${(result.end - 1).toString(16)}`);
+console.log('  covered: decode-only/no-DMA, 16-byte DMA roundtrip, full picture DMA');
+console.log('  covered: NTSC/PAL timing, run/literal RLE, 8K/16K crossing, tagged/missing/OOB/malformed fallback');
