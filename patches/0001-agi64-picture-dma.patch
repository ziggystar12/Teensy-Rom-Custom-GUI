+// AGI-64 EasyFlash picture accelerator
+// ------------------------------------
+// This is intentionally a small, dedicated extension rather than a general
+// decompression API.  A matching cartridge gives us the raw 24-bit EasyFlash
+// offset of three consecutive C64-RLE streams.  They expand to the AGI bitmap,
+// screen and colour planes and are copied into C64 memory with TR+ DMA.
+//
+// The implementation borrows two inactive 8K EasyFlash swap-cache slots for
+// its 10K workspace.  That preserves MinimalBoot's configured ROM allocation,
+// but does not turn its SD-backed swap capacity into directly addressable ROM.
+
+#if !defined(MinimumBuild) || !defined(Fab04_FullDMACapable)
+   #error IOH_AGIPicture requires MinimalBoot on DMA-capable TeensyROM+ v0.4 hardware
+#endif
+
+static_assert(Num8kSwapBuffers >= 2, "AGI picture DMA needs two 8K swap buffers");
+
+extern bool PerformDMA(bool RnW, uint16_t StartAddr, uint8_t *Buffer,
+                       uint32_t Length, bool FixC64Addr);
+extern bool CloseDMA();
+
+// IO2 offsets ($DFF0-$DFFF).  Before activation, $F0-$F2 retain normal
+// EasyFlash RAM behaviour while also recognizing the A/G/I write sequence.
+enum enumAGIPictureRegister : uint8_t
+{
+   AGIPicReg_ID0          = 0xF0, // read 'A'; write unlock 'A'
+   AGIPicReg_ID1          = 0xF1, // read 'G'; write unlock 'G'
+   AGIPicReg_ID2          = 0xF2, // read 'I'; write unlock 'I'
+   AGIPicReg_ID3          = 0xF3, // read '+'
+   AGIPicReg_Version      = 0xF4,
+   AGIPicReg_Capabilities = 0xF5,
+   AGIPicReg_Command      = 0xF6, // write command
+   AGIPicReg_Status       = 0xF7, // read status
+   AGIPicReg_Source0      = 0xF8, // raw EasyFlash offset, little endian
+   AGIPicReg_Source1      = 0xF9,
+   AGIPicReg_Source2      = 0xFA,
+   AGIPicReg_Error        = 0xFB,
+   AGIPicReg_DecodeMS0    = 0xFC,
+   AGIPicReg_DecodeMS1    = 0xFD,
+   AGIPicReg_VideoStandard = 0xFE, // normalized by caller: 1 NTSC, 0 PAL
+   AGIPicReg_Reserved     = 0xFF,
+};
+
+enum enumAGIPictureCommand : uint8_t
+{
+   AGIPicCmd_Acknowledge = 0x00,
+   AGIPicCmd_DecodeDMA   = 0x01,
+   AGIPicCmd_DecodeOnly  = 0x02,
+   AGIPicCmd_DMAProbe    = 0x03,
+   AGIPicCmd_Reset       = 0x7F,
+};
+
+enum enumAGIPictureStatus : uint8_t
+{
+   AGIPicStatus_Ready    = 0x00,
+   AGIPicStatus_Decoding = 0x01,
+   AGIPicStatus_DMA      = 0x02,
+   AGIPicStatus_DoneDMA  = 0x80,
+   AGIPicStatus_DoneDecodeOnly = 0x81,
+   AGIPicStatus_DoneDMAProbe = 0x82,
+   AGIPicStatus_ErrorBase = 0xE0,
+};
+
+enum enumAGIPictureError : uint8_t
+{
+   AGIPicError_None           = 0,
+   AGIPicError_Locked         = 1,
+   AGIPicError_Busy           = 2,
+   AGIPicError_BadCommand     = 3,
+   AGIPicError_InvalidSource  = 4,
+   AGIPicError_SwappedSource  = 5,
+   AGIPicError_MalformedRLE   = 6,
+   AGIPicError_NoWorkspace    = 7,
+   AGIPicError_DMAUnavailable = 8,
+   AGIPicError_DMAProbeMismatch = 9,
+   AGIPicError_DMATimeout     = 10,
+};
+
+static constexpr uint8_t AGIPicProtocolVersion = 2;
+static constexpr uint8_t AGIPicCapability_C64RLE_DMA = 0x01;
+static constexpr uint8_t AGIPicCapability_C64RLE_DecodeOnly = 0x02;
+static constexpr uint8_t AGIPicCapability_DMAProbe = 0x04;
+static constexpr uint8_t AGIPicCapability_VideoTiming = 0x08;
+static constexpr uint32_t AGIPicPhysicalPrefixSize = 24u * 16384u;
+static constexpr uint16_t AGIPicBitmapLength = 8000;
+static constexpr uint16_t AGIPicScreenLength = 1000;
+static constexpr uint16_t AGIPicColourLength = 1000;
+static constexpr uint16_t AGIPicDMAProbeAddress = 0x0400;
+static constexpr uint8_t AGIPicDMAProbeLength = 16;
+static constexpr uint8_t AGIPicDMAProbeSeed[AGIPicDMAProbeLength] =
+{
+   0xA5, 0xA4, 0xA7, 0xA6, 0xA1, 0xA0, 0xA3, 0xA2,
+   0xAD, 0xAC, 0xAF, 0xAE, 0xA9, 0xA8, 0xAB, 0xAA,
+};
+
+static volatile uint8_t AGIPicRegisters[16];
+static volatile uint8_t AGIPicUnlockStage;
+static volatile bool AGIPicActive;
+// Zero is the acknowledge/no-work command, so the command byte also serves as
+// the pending marker without a second ISR-shared flag.
+static volatile uint8_t AGIPicPendingCommand;
+static uint8_t AGIPicDMAProbeBuffer[AGIPicDMAProbeLength];
+
+static void AGIPictureSetError(uint8_t Error)
+{
+   AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = Error;
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] =
+      AGIPicStatus_ErrorBase | (Error & 0x1F);
+}
+
+static void AGIPictureActivate()
+{
+   memset((void *)AGIPicRegisters, 0, sizeof(AGIPicRegisters));
+   AGIPicRegisters[AGIPicReg_ID0 - AGIPicReg_ID0] = 'A';
+   AGIPicRegisters[AGIPicReg_ID1 - AGIPicReg_ID0] = 'G';
+   AGIPicRegisters[AGIPicReg_ID2 - AGIPicReg_ID0] = 'I';
+   AGIPicRegisters[AGIPicReg_ID3 - AGIPicReg_ID0] = '+';
+   AGIPicRegisters[AGIPicReg_Version - AGIPicReg_ID0] = AGIPicProtocolVersion;
+   AGIPicRegisters[AGIPicReg_Capabilities - AGIPicReg_ID0] =
+      AGIPicCapability_C64RLE_DMA |
+      AGIPicCapability_C64RLE_DecodeOnly |
+      AGIPicCapability_DMAProbe |
+      AGIPicCapability_VideoTiming;
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_Ready;
+   AGIPicPendingCommand = AGIPicCmd_Acknowledge;
+   AGIPicActive = true;
+}
+
+void AGIPictureInit()
+{
+   memset((void *)AGIPicRegisters, 0, sizeof(AGIPicRegisters));
+   AGIPicUnlockStage = 0;
+   AGIPicActive = false;
+   AGIPicPendingCommand = AGIPicCmd_Acknowledge;
+}
+
+void AGIPictureBankChanged()
+{
+   // Any bank write between unlock bytes invalidates the partial sequence.
+   // Once active, bank changes after terminal results leave the session alive
+   // so repeated accelerated pictures do not need a second unlock.
+   if (!AGIPicActive) AGIPicUnlockStage = 0;
+}
+
+static void AGIPictureUnlockWrite(uint8_t Address, uint8_t Data)
+{
+   // Preserve ordinary EasyFlash IO2 RAM while locked.
+   EZFlashRAM[Address] = Data;
+
+   if (Address == AGIPicReg_ID0 && Data == 'A')
+   {
+      AGIPicUnlockStage = 1;
+   }
+   else if (Address == AGIPicReg_ID1 && Data == 'G' && AGIPicUnlockStage == 1)
+   {
+      AGIPicUnlockStage = 2;
+   }
+   else if (Address == AGIPicReg_ID2 && Data == 'I' && AGIPicUnlockStage == 2)
+   {
+      AGIPicUnlockStage = 3;
+   }
+   else if (Address == AGIPicReg_ID3 && Data == '+' && AGIPicUnlockStage == 3)
+   {
+      AGIPicUnlockStage = 4;
+   }
+   else if (Address == AGIPicReg_Version && Data == AGIPicProtocolVersion &&
+            AGIPicUnlockStage == 4)
+   {
+      AGIPicUnlockStage = 0;
+      AGIPictureActivate();
+   }
+   else
+   {
+      AGIPicUnlockStage = 0;
+   }
+}
+
+static void AGIPictureCommandWrite(uint8_t Command)
+{
+   uint8_t Status = AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0];
+
+   // Do not let a reset/re-unlock create a new mailbox session around work
+   // that the polling handler has already taken ownership of.
+   if (Status == AGIPicStatus_Decoding || Status == AGIPicStatus_DMA)
+   {
+      AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_Busy;
+      return;
+   }
+
+   if (Command == AGIPicCmd_Reset)
+   {
+      AGIPicPendingCommand = AGIPicCmd_Acknowledge;
+      AGIPicUnlockStage = 0;
+      AGIPicActive = false;
+      return;
+   }
+
+   if (Command == AGIPicCmd_Acknowledge)
+   {
+      AGIPicPendingCommand = AGIPicCmd_Acknowledge;
+      AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_None;
+      AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_Ready;
+      return;
+   }
+
+   if (Command == AGIPicCmd_DecodeDMA || Command == AGIPicCmd_DecodeOnly)
+   {
+      AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_None;
+      AGIPicRegisters[AGIPicReg_DecodeMS0 - AGIPicReg_ID0] = 0;
+      AGIPicRegisters[AGIPicReg_DecodeMS1 - AGIPicReg_ID0] = 0;
+      AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_Decoding;
+      AGIPicPendingCommand = Command;
+      return;
+   }
+
+   if (Command == AGIPicCmd_DMAProbe)
+   {
+      AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_None;
+      AGIPicRegisters[AGIPicReg_DecodeMS0 - AGIPicReg_ID0] = 0;
+      AGIPicRegisters[AGIPicReg_DecodeMS1 - AGIPicReg_ID0] = 0;
+      AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_DMA;
+      AGIPicPendingCommand = Command;
+      return;
+   }
+
+   AGIPictureSetError(AGIPicError_BadCommand);
+}
+
+bool AGIPictureIO2Hndlr(uint8_t Address, bool R_Wn, bool HelperBankSelected)
+{
+   if (Address < AGIPicReg_ID0)
+   {
+      if (!AGIPicActive) AGIPicUnlockStage = 0;
+      return false;
+   }
+
+   if (!AGIPicActive)
+   {
+      // Intercept only the five-byte unlock window. Reads and writes retain
+      // ordinary EasyFlash RAM behavior until the exact sequence is complete.
+      if (Address <= AGIPicReg_Version)
+      {
+         if (R_Wn)
+         {
+            DataPortWriteWaitLog(EZFlashRAM[Address]);
+            AGIPicUnlockStage = 0;
+         }
+         else
+         {
+            uint8_t Data = DataPortWaitRead();
+            TraceLogAddValidData(Data);
+            if (!HelperBankSelected)
+            {
+               EZFlashRAM[Address] = Data;
+               AGIPicUnlockStage = 0;
+            }
+            else AGIPictureUnlockWrite(Address, Data);
+         }
+         return true;
+      }
+
+      // An unrelated access breaks a partial sequence but otherwise retains
+      // the stock EasyFlash IO2 path.
+      AGIPicUnlockStage = 0;
+      return false;
+   }
+
+   uint8_t Register = Address - AGIPicReg_ID0;
+   if (R_Wn)
+   {
+      DataPortWriteWaitLog(AGIPicRegisters[Register]);
+      return true;
+   }
+
+   uint8_t Data = DataPortWaitRead();
+   TraceLogAddValidData(Data);
+
+   if (Address == AGIPicReg_Command)
+   {
+      AGIPictureCommandWrite(Data);
+   }
+   else if ((Address >= AGIPicReg_Source0 && Address <= AGIPicReg_Source2) ||
+            Address == AGIPicReg_VideoStandard)
+   {
+      uint8_t Status = AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0];
+      if (Status != AGIPicStatus_Decoding && Status != AGIPicStatus_DMA)
+         AGIPicRegisters[Register] = Data;
+      else
+         AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_Busy;
+   }
+
+   // ID, result, timing and capability registers are read-only. Source and
+   // video-standard writes above are accepted only while no command is active.
+   return true;
+}
+
+bool AGIPictureBusy()
+{
+   if (!AGIPicActive) return false;
+   uint8_t Status = AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0];
+   return Status == AGIPicStatus_Decoding || Status == AGIPicStatus_DMA;
+}
+
+static bool AGIPictureBorrowWorkspace(uint8_t **Bitmap, uint8_t **Tail)
+{
+   uint8_t Found = 0;
+
+   for (uint8_t BuffNum = 0; BuffNum < Num8kSwapBuffers; BuffNum++)
+   {
+      uint8_t *Candidate = SwapBuffers[BuffNum].Image;
+      if (Candidate == LOROM_Image || Candidate == HIROM_Image) continue;
+
+      // This slot may have cached an overflow CRT half-bank.  Invalidating its
+      // tag makes it available to the ordinary replacement path after use.
+      SwapBuffers[BuffNum].Offset = 0;
+      if (Found == 0) *Bitmap = Candidate;
+      else
+      {
+         *Tail = Candidate;
+         return true;
+      }
+      Found++;
+   }
+
+   return false;
+}
+
+static bool AGIPictureReadResidentByte(uint32_t *RawOffset, uint8_t *Data,
+                                       uint8_t *Error)
+{
+   uint32_t Offset = *RawOffset;
+   if (Offset >= AGIPicPhysicalPrefixSize)
+   {
+      *Error = AGIPicError_InvalidSource;
+      return false;
+   }
+
+   uint8_t Bank = Offset >> 14;
+   uint8_t Half = (Offset >> 13) & 1;
+   uint8_t *Source = BankDecode[Bank][Half];
+
+   if (Source == NULL)
+   {
+      *Error = AGIPicError_InvalidSource;
+      return false;
+   }
+   if (((uint32_t)Source & SwapSeekAddrMask) == SwapSeekAddrMask)
+   {
+      *Error = AGIPicError_SwappedSource;
+      return false;
+   }
+
+   *Data = Source[Offset & 0x1FFF];
+   *RawOffset = Offset + 1;
+   return true;
+}
+
+static bool AGIPictureDecodeC64RLE(uint32_t *RawOffset, uint8_t *Output,
+                                   uint16_t OutputLength, uint8_t *Error)
+{
+   uint16_t Produced = 0;
+
+   while (Produced < OutputLength)
+   {
+      uint8_t Control;
+      if (!AGIPictureReadResidentByte(RawOffset, &Control, Error)) return false;
+
+      if (Control & 0x80)
+      {
+         uint16_t Length = (Control & 0x7F) + 3;
+         uint8_t Value;
+         if (Length > OutputLength - Produced ||
+             !AGIPictureReadResidentByte(RawOffset, &Value, Error))
+         {
+            if (*Error == AGIPicError_None) *Error = AGIPicError_MalformedRLE;
+            return false;
+         }
+         memset(Output + Produced, Value, Length);
+         Produced += Length;
+      }
+      else
+      {
+         uint16_t Length = Control + 1;
+         if (Length > OutputLength - Produced)
+         {
+            *Error = AGIPicError_MalformedRLE;
+            return false;
+         }
+         while (Length--)
+         {
+            if (!AGIPictureReadResidentByte(RawOffset, Output + Produced, Error))
+               return false;
+            Produced++;
+         }
+      }
+   }
+
+   return true;
+}
+
+static void AGIPictureApplyVideoTiming()
+{
+   bool NTSC = AGIPicRegisters[AGIPicReg_VideoStandard - AGIPicReg_ID0] != 0;
+   nS_DMASetup = NTSC ? Def_nS_DMASetupNTSC : Def_nS_DMASetupPAL;
+   nS_MaxAdj = NTSC ? Def_nS_MaxAdjNTSC : Def_nS_MaxAdjPAL;
+}
+
+static void AGIPictureSetDone(uint8_t Status, uint32_t StartMS)
+{
+   uint16_t ElapsedMS = (uint16_t)(millis() - StartMS);
+   AGIPicRegisters[AGIPicReg_DecodeMS0 - AGIPicReg_ID0] = ElapsedMS;
+   AGIPicRegisters[AGIPicReg_DecodeMS1 - AGIPicReg_ID0] = ElapsedMS >> 8;
+   AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = AGIPicError_None;
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = Status;
+}
+
+static void AGIPictureDMAProbe(uint32_t StartMS)
+{
+   if (DMA_State != DMA_S_DisableReady)
+   {
+      AGIPictureSetError(AGIPicError_DMAUnavailable);
+      return;
+   }
+
+   // The matching C64 diagnostic saves $0400-$040f, writes this seed there,
+   // and restores the original bytes on every exit. Read and validate before
+   // making the one bounded write, so a bad read never modifies C64 memory.
+   AGIPictureApplyVideoTiming();
+   if (!PerformDMA(true, AGIPicDMAProbeAddress, AGIPicDMAProbeBuffer,
+                   AGIPicDMAProbeLength, false) || !CloseDMA())
+   {
+      AGIPictureSetError(AGIPicError_DMATimeout);
+      return;
+   }
+   if (memcmp(AGIPicDMAProbeBuffer, AGIPicDMAProbeSeed,
+              AGIPicDMAProbeLength) != 0)
+   {
+      AGIPictureSetError(AGIPicError_DMAProbeMismatch);
+      return;
+   }
+
+   for (uint8_t Index = 0; Index < AGIPicDMAProbeLength; Index++)
+      AGIPicDMAProbeBuffer[Index] ^= 0xFF;
+   if (!PerformDMA(false, AGIPicDMAProbeAddress, AGIPicDMAProbeBuffer,
+                   AGIPicDMAProbeLength, false) || !CloseDMA())
+   {
+      AGIPictureSetError(AGIPicError_DMATimeout);
+      return;
+   }
+   AGIPictureSetDone(AGIPicStatus_DoneDMAProbe, StartMS);
+}
+
+void AGIPicturePollingHndlr()
+{
+   if (!AGIPicActive || !AGIPicPendingCommand) return;
+
+   // Status was changed to Decoding before the ISR published this request, so
+   // source-register writes are now rejected.  Copy the offset once here.
+   uint8_t Command = AGIPicPendingCommand;
+   AGIPicPendingCommand = AGIPicCmd_Acknowledge;
+   uint32_t StartMS = millis();
+
+   if (Command == AGIPicCmd_DMAProbe)
+   {
+      AGIPictureDMAProbe(StartMS);
+      return;
+   }
+
+   if (Command != AGIPicCmd_DecodeDMA && Command != AGIPicCmd_DecodeOnly)
+   {
+      AGIPictureSetError(AGIPicError_BadCommand);
+      return;
+   }
+
+   uint32_t RawOffset =
+      (uint32_t)AGIPicRegisters[AGIPicReg_Source0 - AGIPicReg_ID0] |
+      ((uint32_t)AGIPicRegisters[AGIPicReg_Source1 - AGIPicReg_ID0] << 8) |
+      ((uint32_t)AGIPicRegisters[AGIPicReg_Source2 - AGIPicReg_ID0] << 16);
+   uint8_t Error = AGIPicError_None;
+   uint8_t *Bitmap = NULL;
+   uint8_t *Tail = NULL;
+
+   if (RawOffset >= AGIPicPhysicalPrefixSize)
+   {
+      AGIPictureSetError(AGIPicError_InvalidSource);
+      return;
+   }
+
+   if (!AGIPictureBorrowWorkspace(&Bitmap, &Tail))
+   {
+      AGIPictureSetError(AGIPicError_NoWorkspace);
+      return;
+   }
+
+   // Decode everything before the first DMA.  A malformed later stream thus
+   // leaves all three C64 destinations untouched and the caller can fall back.
+   if (!AGIPictureDecodeC64RLE(&RawOffset, Bitmap, AGIPicBitmapLength, &Error) ||
+       !AGIPictureDecodeC64RLE(&RawOffset, Tail, AGIPicScreenLength, &Error) ||
+       !AGIPictureDecodeC64RLE(&RawOffset, Tail + AGIPicScreenLength,
+                               AGIPicColourLength, &Error))
+   {
+      AGIPictureSetError(Error == AGIPicError_None ?
+                         AGIPicError_MalformedRLE : Error);
+      return;
+   }
+
+   if (Command == AGIPicCmd_DecodeOnly)
+   {
+      AGIPictureSetDone(AGIPicStatus_DoneDecodeOnly, StartMS);
+      return;
+   }
+
+   // A bank-switch miss also uses DMA_State to pause the C64. The matching
+   // cartridge keeps bank 62 stable (and runs with IRQs masked) while waiting.
+   // Detect an already-active swap before starting the first transfer.
+   if (DMA_State != DMA_S_DisableReady)
+   {
+      AGIPictureSetError(AGIPicError_DMAUnavailable);
+      return;
+   }
+
+   AGIPictureApplyVideoTiming();
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_DMA;
+   if (!PerformDMA(false, 0x6000, Bitmap, AGIPicBitmapLength, false) ||
+       !CloseDMA() ||
+       !PerformDMA(false, 0x5C00, Tail, AGIPicScreenLength, false) ||
+       !CloseDMA() ||
+       !PerformDMA(false, 0xD800, Tail + AGIPicScreenLength,
+                   AGIPicColourLength, false) ||
+       !CloseDMA())
+   {
+      AGIPictureSetError(AGIPicError_DMATimeout);
+      return;
+   }
+
+   AGIPictureSetDone(AGIPicStatus_DoneDMA, StartMS);
+}
