+// Once the outer MPI2 envelope and VAG1 dispatch shape have validated, report
+// a typed startup-stage failure through the same correlated MPO2 commit.  A
+// malformed outer envelope never reaches this helper and remains deliberately
+// silent.  Some startup stages can emergency-release /DMA, so publication can
+// either continue the held transaction or reacquire the bus for the response.
+static FLASHMEM bool MPEThinVirtualPublishStartupError(uint32_t Sequence,
+                                                       uint32_t SessionNonce,
+                                                       uint8_t ErrorCode)
+{
+   uint8_t Frame[MPEThinPayloadBytes];
+   memset(Frame, 0, sizeof(Frame));
+   memcpy(Frame, "FRA2", 4);
+   Frame[4] = 1;
+   Frame[7] = ErrorCode;
+
+   memset(MPEThinOutput, 0, sizeof(MPEThinOutput));
+   memcpy(MPEThinOutput, "MPO2", 4);
+   MPEThinOutput[4] = MPEThinProtocolVersion;
+   MPEThinOutput[5] = MPEThinOutputError;
+   MPEThinOutput[6] = MPEThinPayloadBytes;
+   MPEThinOutput[7] = MPEThinOutputResync;
+   MPEThinWrite32(MPEThinOutput + 8, Sequence);
+   MPEThinWrite32(MPEThinOutput + 12, SessionNonce);
+   memcpy(MPEThinOutput + MPEThinPayloadOffset, Frame,
+          MPEThinPayloadBytes);
+   MPEThinWrite16(MPEThinOutput + MPEThinCRCOffset,
+                  MPEThinCRC16(MPEThinOutput, MPEThinCRCOffset));
+   MPEThinWrite32(MPEThinOutput + MPEThinCommitOffset, Sequence);
+
+   if (DMA_State == DMA_S_TransferComplete)
+      return AGIContinueDMA(false, MPEThinOutputAddress, MPEThinOutput,
+                            MPEThinEnvelopeBytes, false);
+   if (DMA_State == DMA_S_DisableReady)
+      return PerformDMA(false, MPEThinOutputAddress, MPEThinOutput,
+                        MPEThinEnvelopeBytes, false);
+   return false;
+}
