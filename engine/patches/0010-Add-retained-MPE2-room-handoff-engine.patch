+// MPE2 room profiles are supplied by the cartridge.  Nothing in this retained
+// state identifies SQ1 (or any other title): a future game can hand off a room
+// by providing the same bounded grid and ordinary AGI actor state.
+struct MPEThinRoomState
+{
+   bool Active;
+   uint8_t Room, X, Y, Direction;
+   uint32_t Tick;
+   uint8_t OriginX, OriginY, GridWidth, GridHeight;
+   uint8_t CellShiftX, CellShiftY, StepSize, CycleTicks;
+   uint8_t MaxCel, LookMessageID, Loop, Cel, Priority;
+   uint8_t Passability[MPEThinRoomMapBytes];
+   uint16_t RoomGeneration;
+   uint32_t LastSequence;
+   uint16_t LastRequestCRC;
+   uint8_t LastResultFlags, LastParserResult, LastParserMessageID;
+};
+static MPEThinRoomState MPEThinRoom;
 
 // Room graphics live in RAM2 independently of the three decode/prefetch swap
 // slots.  Thus a prepared next picture cannot evict the immutable current-room
@@ -4689,13 +4729,311 @@ static bool MPEThinEnvelopeValid(const uint8_t *Packet)
    return true;
 }
 
+static bool MPEThinBytesZero(const uint8_t *Data, uint8_t First,
+                             uint8_t Limit)
+{
+   for (uint8_t Index = First; Index < Limit; Index++)
+      if (Data[Index]) return false;
+   return true;
+}
+
+static bool MPEThinSequenceNewer(uint32_t Candidate, uint32_t Reference)
+{
+   uint32_t Delta = Candidate - Reference;
+   return Delta && Delta < 0x80000000UL;
+}
+
+static bool MPEThinRoomMapPassable(const MPEThinRoomState &State,
+                                   uint8_t X, uint8_t Y)
+{
+   if (X < State.OriginX || Y < State.OriginY) return false;
+   uint8_t Column = (uint8_t)((X - State.OriginX) >> State.CellShiftX);
+   uint8_t Row = (uint8_t)((Y - State.OriginY) >> State.CellShiftY);
+   if (Column >= State.GridWidth || Row >= State.GridHeight) return false;
+   uint8_t Cell = (uint8_t)(Row * State.GridWidth + Column);
+   return (State.Passability[Cell >> 3] & (1U << (Cell & 7))) != 0;
+}
+
+static bool MPEThinRoomPriorityPassable(uint8_t Room,
+                                        uint16_t RoomGeneration,
+                                        uint8_t X, uint8_t Y)
+{
+   if (!AGIPicRoomValid || !RoomGeneration ||
+       AGIPicRoomGeneration != RoomGeneration || AGIPicRoomToken != Room ||
+       !AGIPicRoomPriorityLength ||
+       (AGIPicRoomPriorityFormat != 2 && AGIPicRoomPriorityFormat != 3))
+      return false;
+   uint8_t Priority;
+   if (!AGIPictureRoomPriorityAt(X, Y, &Priority)) return false;
+   // Default AGI ego policy: control colors 0 and 1 block; trigger, water,
+   // priority, and visual values pass. The supplied grid may further restrict
+   // the proof profile, but it can never bypass the retained room priority.
+   return Priority != 0 && Priority != 1;
+}
+
+static bool MPEThinRoomFootPassable(const MPEThinRoomState &State,
+                                    uint8_t X, uint8_t Y)
+{
+   // The proof uses the generic 12-column CSPR3 envelope instead of trusting
+   // a game-specific cel width. This may block a narrow cel early, but it
+   // cannot allow the visible ego footprint through a retained priority wall.
+   if (X > 255 - (MPEThinRoomFootWidth - 1)) return false;
+   for (uint8_t Offset = 0; Offset < MPEThinRoomFootWidth; Offset++)
+      if (!MPEThinRoomMapPassable(State, (uint8_t)(X + Offset), Y) ||
+          !MPEThinRoomPriorityPassable(State.Room, State.RoomGeneration,
+                                       (uint8_t)(X + Offset), Y)) return false;
+   return true;
+}
+
+static bool MPEThinRoomHandoffValid(const uint8_t *Payload,
+                                    uint8_t PayloadLength)
+{
+   if (PayloadLength != MPEThinRoomPayloadBytes ||
+       memcmp(Payload, "HOF1", 4) != 0 ||
+       Payload[7] > MPEThinRoomDirectionMax ||
+       !Payload[14] || Payload[14] > 16 ||
+       !Payload[15] || Payload[15] > 8 ||
+       (uint16_t)Payload[14] * Payload[15] > 128 ||
+       Payload[16] > 4 || Payload[17] > 4 ||
+       Payload[18] != 1 ||
+       Payload[18] > (1U << Payload[16]) ||
+       Payload[18] > (1U << Payload[17]) ||
+       !Payload[19] || Payload[19] > 16 ||
+       Payload[20] > 15 || !Payload[21] ||
+       Payload[22] > Payload[20] || (Payload[23] & 0xC0)) return false;
+
+   uint16_t Width = (uint16_t)Payload[14] << Payload[16];
+   uint16_t Height = (uint16_t)Payload[15] << Payload[17];
+   if ((uint16_t)Payload[12] + Width > 256 ||
+       (uint16_t)Payload[13] + Height > 256) return false;
+
+   uint8_t Cells = (uint8_t)(Payload[14] * Payload[15]);
+   uint8_t UsedBytes = (uint8_t)((Cells + 7) >> 3);
+   if (Cells & 7)
+   {
+      uint8_t LastMask = (uint8_t)((1U << (Cells & 7)) - 1);
+      if (Payload[24 + UsedBytes - 1] & ~LastMask) return false;
+   }
+   if (!MPEThinBytesZero(Payload, (uint8_t)(24 + UsedBytes), 40)) return false;
+
+   MPEThinRoomState Candidate = {};
+   Candidate.Room = Payload[4];
+   Candidate.OriginX = Payload[12];
+   Candidate.OriginY = Payload[13];
+   Candidate.GridWidth = Payload[14];
+   Candidate.GridHeight = Payload[15];
+   Candidate.CellShiftX = Payload[16];
+   Candidate.CellShiftY = Payload[17];
+   Candidate.RoomGeneration = AGIPicRoomGeneration;
+   memcpy(Candidate.Passability, Payload + 24, MPEThinRoomMapBytes);
+   return MPEThinRoomFootPassable(Candidate, Payload[5], Payload[6]);
+}
+
+static bool MPEThinRoomInputValid(const uint8_t *Payload,
+                                  uint8_t PayloadLength,
+                                  uint8_t EnvelopeFlags)
+{
+   if (!MPEThinRoom.Active || PayloadLength != MPEThinRoomPayloadBytes ||
+       memcmp(Payload, "INP1", 4) != 0 ||
+       (EnvelopeFlags & ~(MPEThinRoomInputParserSubmitted |
+                          MPEThinRoomEnvelopeControllerEdges)) ||
+       Payload[4] != MPEThinRoom.Room ||
+       Payload[5] > MPEThinRoomDirectionMax ||
+       (Payload[6] & ~MPEThinRoomInputParserSubmitted) ||
+       Payload[7] > MPEThinRoomParserLook ||
+       MPEThinRead32(Payload + 8) != MPEThinRoom.Tick ||
+       !MPEThinBytesZero(Payload, 12, 40)) return false;
+   bool Submitted = (Payload[6] & MPEThinRoomInputParserSubmitted) != 0;
+   bool Look = Payload[7] == MPEThinRoomParserLook;
+   bool EnvelopeSubmitted = (EnvelopeFlags & 0x01) != 0;
+   return Submitted == Look && Submitted == EnvelopeSubmitted;
+}
+
+static uint8_t MPEThinRoomLoopForDirection(uint8_t Direction,
+                                           uint8_t Previous)
+{
+   if (!Direction) return Previous;
+   if (Direction == 1) return 3;
+   if (Direction >= 2 && Direction <= 4) return 0;
+   if (Direction == 5) return 2;
+   return 1;
+}
+
+static uint8_t MPEThinRoomPriorityForY(uint8_t Y)
+{
+   uint8_t Priority = (uint8_t)(Y / 12 + 1);
+   if (Priority < 4) Priority = 4;
+   if (Priority > 15) Priority = 15;
+   return Priority;
+}
+
+static void MPEThinRoomBuildFrame(uint8_t *Payload)
+{
+   memset(Payload, 0, MPEThinRoomPayloadBytes);
+   memcpy(Payload, "FRM1", 4);
+   Payload[4] = MPEThinRoom.Room;
+   Payload[5] = MPEThinRoom.X;
+   Payload[6] = MPEThinRoom.Y;
+   Payload[7] = MPEThinRoom.Direction;
+   MPEThinWrite32(Payload + 8, MPEThinRoom.Tick);
+   Payload[12] = MPEThinRoom.Loop;
+   Payload[13] = MPEThinRoom.Cel;
+   Payload[14] = MPEThinRoom.Priority;
+   Payload[15] = MPEThinRoom.LastResultFlags;
+   Payload[16] = MPEThinRoom.LastParserResult;
+   Payload[17] = MPEThinRoom.LastParserMessageID;
+}
+
+static void MPEThinRoomAcceptHandoff(const uint8_t *Payload,
+                                     uint32_t Sequence, uint16_t RequestCRC)
+{
+   memset(&MPEThinRoom, 0, sizeof(MPEThinRoom));
+   MPEThinRoom.Active = true;
+   MPEThinRoom.Room = Payload[4];
+   MPEThinRoom.X = Payload[5];
+   MPEThinRoom.Y = Payload[6];
+   MPEThinRoom.Direction = Payload[7];
+   MPEThinRoom.Tick = MPEThinRead32(Payload + 8);
+   MPEThinRoom.OriginX = Payload[12];
+   MPEThinRoom.OriginY = Payload[13];
+   MPEThinRoom.GridWidth = Payload[14];
+   MPEThinRoom.GridHeight = Payload[15];
+   MPEThinRoom.CellShiftX = Payload[16];
+   MPEThinRoom.CellShiftY = Payload[17];
+   MPEThinRoom.StepSize = Payload[18];
+   MPEThinRoom.CycleTicks = Payload[19];
+   MPEThinRoom.MaxCel = Payload[20];
+   MPEThinRoom.LookMessageID = Payload[21];
+   MPEThinRoom.Cel = Payload[22];
+   MPEThinRoom.Loop = Payload[23] & 0x03;
+   MPEThinRoom.Priority = (Payload[23] >> 2) & 0x0F;
+   memcpy(MPEThinRoom.Passability, Payload + 24, MPEThinRoomMapBytes);
+   MPEThinRoom.RoomGeneration = AGIPicRoomGeneration;
+   MPEThinRoom.LastSequence = Sequence;
+   MPEThinRoom.LastRequestCRC = RequestCRC;
+   MPEThinRoom.LastResultFlags = MPEThinRoomResultHandoff |
+      MPEThinRoomResultRoomChanged;
+}
+
+static void MPEThinRoomAcceptInput(const uint8_t *Payload,
+                                   uint32_t Sequence, uint16_t RequestCRC)
+{
+   uint8_t Direction = Payload[5];
+   uint8_t CandidateX = MPEThinRoom.X;
+   uint8_t CandidateY = MPEThinRoom.Y;
+   bool CoordinateValid = true;
+   MPEThinRoom.LastResultFlags = 0;
+   MPEThinRoom.LastParserResult = MPEThinRoomParserResultNone;
+   MPEThinRoom.LastParserMessageID = 0;
+   MPEThinRoom.Direction = Direction;
+   MPEThinRoom.Tick++;
+
+   int16_t DX = 0, DY = 0;
+   if (Direction == 1 || Direction == 2 || Direction == 8) DY = -MPEThinRoom.StepSize;
+   if (Direction == 4 || Direction == 5 || Direction == 6) DY = MPEThinRoom.StepSize;
+   if (Direction == 2 || Direction == 3 || Direction == 4) DX = MPEThinRoom.StepSize;
+   if (Direction == 6 || Direction == 7 || Direction == 8) DX = -MPEThinRoom.StepSize;
+   int16_t WideX = (int16_t)MPEThinRoom.X + DX;
+   int16_t WideY = (int16_t)MPEThinRoom.Y + DY;
+   if (WideX < 0 || WideX > 255 || WideY < 0 || WideY > 255)
+      CoordinateValid = false;
+   else
+   {
+      CandidateX = (uint8_t)WideX;
+      CandidateY = (uint8_t)WideY;
+   }
+
+   if (Direction)
+   {
+      if (CoordinateValid && MPEThinRoomFootPassable(MPEThinRoom,
+                                                     CandidateX, CandidateY))
+      {
+         MPEThinRoom.X = CandidateX;
+         MPEThinRoom.Y = CandidateY;
+         MPEThinRoom.Priority = MPEThinRoomPriorityForY(MPEThinRoom.Y);
+         MPEThinRoom.LastResultFlags |= MPEThinRoomResultMoved;
+      }
+      else MPEThinRoom.LastResultFlags |= MPEThinRoomResultBlocked;
+      MPEThinRoom.Loop = MPEThinRoomLoopForDirection(Direction, MPEThinRoom.Loop);
+      if ((MPEThinRoom.Tick % MPEThinRoom.CycleTicks) == 0)
+      {
+         MPEThinRoom.Cel = MPEThinRoom.Cel == MPEThinRoom.MaxCel ?
+            0 : (uint8_t)(MPEThinRoom.Cel + 1);
+         MPEThinRoom.LastResultFlags |= MPEThinRoomResultAnimation;
+      }
+   }
+
+   if (Payload[7] == MPEThinRoomParserLook)
+   {
+      MPEThinRoom.LastResultFlags |= MPEThinRoomResultParser;
+      MPEThinRoom.LastParserResult = MPEThinRoomParserResultMessage;
+      MPEThinRoom.LastParserMessageID = MPEThinRoom.LookMessageID;
+   }
+   MPEThinRoom.LastSequence = Sequence;
+   MPEThinRoom.LastRequestCRC = RequestCRC;
+}
+
+static bool MPEThinRoomRequest(uint8_t Opcode, uint8_t EnvelopeFlags,
+                               uint32_t Sequence, uint32_t SessionNonce,
+                               uint8_t *Frame, uint8_t &OutputFlags)
+{
+   if (!MPEThinStarted || SessionNonce != MPEThinSessionNonce) return false;
+   if (MPEThinRoom.Active &&
+       (!AGIPicRoomValid || AGIPicRoomToken != MPEThinRoom.Room ||
+        AGIPicRoomGeneration != MPEThinRoom.RoomGeneration)) return false;
+   uint16_t RequestCRC = MPEThinRead16(MPEThinInput + MPEThinCRCOffset);
+   if (MPEThinRoom.Active && Sequence == MPEThinRoom.LastSequence)
+   {
+      if (RequestCRC != MPEThinRoom.LastRequestCRC) return false;
+      MPEThinRoomBuildFrame(Frame);
+      OutputFlags = MPEThinRoom.LastParserResult == MPEThinRoomParserResultMessage ?
+         MPEThinOutputHostEvent : 0;
+      return true;
+   }
+   uint32_t Reference = MPEThinRoom.Active ? MPEThinRoom.LastSequence :
+      MPEThinLastStartSequence;
+   if (!MPEThinSequenceNewer(Sequence, Reference)) return false;
+
+   const uint8_t *Payload = MPEThinInput + MPEThinPayloadOffset;
+   uint8_t PayloadLength = MPEThinInput[6];
+   // HOF1 grants retained authority only in the START path. INPUT_SNAPSHOT
+   // must never reset an active room after retained movement has advanced it.
+   if (Opcode == MPEThinInputSnapshot &&
+       MPEThinRoomInputValid(Payload, PayloadLength, EnvelopeFlags))
+      MPEThinRoomAcceptInput(Payload, Sequence, RequestCRC);
+   else if (Opcode == MPEThinInputResync && MPEThinRoom.Active &&
+            !PayloadLength)
+   {
+      MPEThinRoom.LastSequence = Sequence;
+      MPEThinRoom.LastRequestCRC = RequestCRC;
+      MPEThinRoom.LastResultFlags = 0;
+      MPEThinRoom.LastParserResult = MPEThinRoomParserResultNone;
+      MPEThinRoom.LastParserMessageID = 0;
+   }
+   else return false;
+
+   MPEThinRoomBuildFrame(Frame);
+   OutputFlags = MPEThinRoom.LastParserResult == MPEThinRoomParserResultMessage ?
+      MPEThinOutputHostEvent : 0;
+   return true;
+}
+
 static void MPEThinReset()
 {
    memset(MPEThinInput, 0, sizeof(MPEThinInput));
    memset(MPEThinOutput, 0, sizeof(MPEThinOutput));
+   memset(&MPEThinRoom, 0, sizeof(MPEThinRoom));
    MPEThinLastStartSequence = 0;
+   MPEThinLastStartCRC = 0;
+   MPEThinSessionNonce = 0;
+   MPEThinLastStartWasHandoff = false;
+   MPEThinLastStopSequence = 0;
+   MPEThinLastStopCRC = 0;
+   MPEThinLastStopNonce = 0;
+   MPEThinLastStopValid = false;
    MPEThinStarted = false;
    MPEThinVBlankHinted = false;
+   MPEThinUpgradeStage = 0;
 }
 
 static bool MPEThinReadRequestHeld()
@@ -4716,15 +5051,21 @@ static bool MPEThinCloseHeld()
 }
 
 static bool MPEThinPublishHeld(uint8_t Status, uint32_t Sequence,
-                               uint32_t SessionNonce)
+                               uint32_t SessionNonce, uint8_t OutputFlags,
+                               const uint8_t *Payload, uint8_t PayloadLength)
 {
+   if (PayloadLength > MPEThinPayloadBytes || (PayloadLength && !Payload))
+      return false;
    memset(MPEThinOutput, 0, sizeof(MPEThinOutput));
    memcpy(MPEThinOutput, "MPO2", 4);
    MPEThinOutput[4] = MPEThinProtocolVersion;
    MPEThinOutput[5] = Status;
-   MPEThinOutput[6] = 0;
+   MPEThinOutput[6] = PayloadLength;
+   MPEThinOutput[7] = OutputFlags;
    MPEThinWrite32(MPEThinOutput + 8, Sequence);
    MPEThinWrite32(MPEThinOutput + 12, SessionNonce);
+   if (PayloadLength)
+      memcpy(MPEThinOutput + MPEThinPayloadOffset, Payload, PayloadLength);
    MPEThinWrite16(MPEThinOutput + MPEThinCRCOffset,
                   MPEThinCRC16(MPEThinOutput, MPEThinCRCOffset));
 
@@ -4752,6 +5093,10 @@ static void MPEThinKick()
    uint32_t Sequence = 0;
    uint32_t SessionNonce = 0;
    uint8_t Status = MPEThinOutputIdle;
+   uint8_t OutputFlags = 0;
+   uint8_t PayloadLength = 0;
+   uint8_t Frame[MPEThinRoomPayloadBytes];
+   const uint8_t *Payload = nullptr;
    bool Written = false;
    if (Valid)
    {
@@ -4761,18 +5106,109 @@ static void MPEThinKick()
       Status = MPEThinOutputIdle;
       if (Opcode == MPEThinInputStart)
       {
-         // Re-kicking the same START is intentionally idempotent: it emits
-         // the original BOOT envelope instead of starting a second engine.
-         if (!MPEThinStarted || Sequence != MPEThinLastStartSequence)
+         uint16_t RequestCRC = MPEThinRead16(MPEThinInput + MPEThinCRCOffset);
+         uint8_t InputLength = MPEThinInput[6];
+         const uint8_t *InputPayload = MPEThinInput + MPEThinPayloadOffset;
+         bool SameStart = MPEThinStarted &&
+            Sequence == MPEThinLastStartSequence &&
+            SessionNonce == MPEThinSessionNonce;
+         if (SameStart)
          {
-            MPEThinLastStartSequence = Sequence;
-            MPEThinStarted = true;
+            // Immediate STOP-and-wait re-kicks replay the prior BOOT/FRAME
+            // only for the exact committed request. A HOF1 START becomes
+            // stale as soon as a later INPUT has advanced retained state.
+            if (RequestCRC != MPEThinLastStartCRC) Valid = false;
+            else if (MPEThinLastStartWasHandoff)
+            {
+               if (!MPEThinRoom.Active ||
+                   MPEThinRoom.LastSequence != Sequence ||
+                   MPEThinRoom.LastRequestCRC != RequestCRC) Valid = false;
+               else
+               {
+                  MPEThinRoomBuildFrame(Frame);
+                  Status = MPEThinOutputFrame;
+                  Payload = Frame;
+                  PayloadLength = MPEThinRoomPayloadBytes;
+               }
+            }
+            else Status = MPEThinOutputBoot;
          }
-         Status = MPEThinOutputBoot;
+         else
+         {
+            uint32_t Reference = MPEThinRoom.Active ?
+               MPEThinRoom.LastSequence : MPEThinLastStartSequence;
+            bool SameSession = MPEThinStarted &&
+               SessionNonce == MPEThinSessionNonce;
+            bool EmptyStart = !InputLength && !MPEThinInput[7];
+            bool HandoffStart = !MPEThinInput[7] &&
+               MPEThinRoomHandoffValid(InputPayload, InputLength);
+            if ((SameSession && !MPEThinSequenceNewer(Sequence, Reference)) ||
+                (!EmptyStart && !HandoffStart)) Valid = false;
+            else
+            {
+               memset(&MPEThinRoom, 0, sizeof(MPEThinRoom));
+               MPEThinLastStartSequence = Sequence;
+               MPEThinLastStartCRC = RequestCRC;
+               MPEThinSessionNonce = SessionNonce;
+               MPEThinLastStartWasHandoff = HandoffStart;
+               MPEThinStarted = true;
+               if (HandoffStart)
+               {
+                  MPEThinRoomAcceptHandoff(InputPayload, Sequence, RequestCRC);
+                  MPEThinRoomBuildFrame(Frame);
+                  Status = MPEThinOutputFrame;
+                  Payload = Frame;
+                  PayloadLength = MPEThinRoomPayloadBytes;
+               }
+               else Status = MPEThinOutputBoot;
+            }
+         }
+      }
+      else if (Opcode == MPEThinInputStop)
+      {
+         uint16_t RequestCRC = MPEThinRead16(MPEThinInput + MPEThinCRCOffset);
+         uint32_t Reference = MPEThinRoom.Active ?
+            MPEThinRoom.LastSequence : MPEThinLastStartSequence;
+         bool ExactStoppedReplay = !MPEThinStarted && MPEThinLastStopValid &&
+            Sequence == MPEThinLastStopSequence &&
+            SessionNonce == MPEThinLastStopNonce &&
+            RequestCRC == MPEThinLastStopCRC &&
+            !MPEThinInput[6] && !MPEThinInput[7];
+         if (ExactStoppedReplay) Status = MPEThinOutputIdle;
+         else if (!MPEThinStarted || SessionNonce != MPEThinSessionNonce ||
+                  MPEThinInput[6] || MPEThinInput[7] ||
+                  !MPEThinSequenceNewer(Sequence, Reference)) Valid = false;
+         else
+         {
+            // Publish the correlated IDLE response from this held transaction,
+            // but release all engine authority before the C64 resumes.
+            memset(&MPEThinRoom, 0, sizeof(MPEThinRoom));
+            MPEThinLastStartSequence = 0;
+            MPEThinLastStartCRC = 0;
+            MPEThinSessionNonce = 0;
