+++ b/Source/Teensy/MinimalBoot/tests/mpe-thin-room-engine-conformance.mjs
@@ -0,0 +1,182 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import fs from "node:fs";
+
+const sourcePath = process.argv[2] ?? new URL(
+  "../Common/IO_Handlers/IOH_AGIPicture.c", import.meta.url);
+const firmware = fs.readFileSync(sourcePath, "utf8");
+function section(start, end) {
+  const first = firmware.indexOf(start);
+  const last = firmware.indexOf(end, first + start.length);
+  assert.ok(first >= 0 && last > first, `missing ${start}`);
+  return firmware.slice(first, last);
+}
+
+for (const [name, value] of Object.entries({
+  MPEThinRoomPayloadBytes: "40",
+  MPEThinRoomMapBytes: "16",
+  MPEThinRoomFootWidth: "12",
+  MPEThinRoomDirectionMax: "8",
+  MPEThinRoomParserLook: "0x01",
+  MPEThinRoomResultMoved: "0x01",
+  MPEThinRoomResultBlocked: "0x02",
+  MPEThinRoomResultParser: "0x04",
+  MPEThinRoomResultHandoff: "0x08",
+  MPEThinRoomResultAnimation: "0x10",
+  MPEThinRoomResultRoomChanged: "0x20"
+})) assert.match(firmware, new RegExp(`\\b${name}\\s*=\\s*${value}\\b`));
+
+const state = section("struct MPEThinRoomState", "static MPEThinRoomState MPEThinRoom");
+assert.match(state, /bool Active[^]*?uint8_t Room, X, Y, Direction[^]*?uint32_t Tick/);
+assert.match(state, /OriginX, OriginY, GridWidth, GridHeight[^]*?Passability\[MPEThinRoomMapBytes\]/);
+assert.match(state, /RoomGeneration[^]*?LastSequence[^]*?LastRequestCRC[^]*?LastResultFlags/);
+assert.match(firmware, /MPEThinLastStartSequence[^]*?MPEThinLastStartCRC[^]*?MPEThinSessionNonce[^]*?MPEThinLastStartWasHandoff/);
+assert.match(firmware, /MPEThinLastStopSequence[^]*?MPEThinLastStopCRC[^]*?MPEThinLastStopNonce[^]*?MPEThinLastStopValid/);
+
+const handoff = section("static bool MPEThinRoomHandoffValid", "static bool MPEThinRoomInputValid");
+assert.match(handoff, /PayloadLength != MPEThinRoomPayloadBytes[^]*?memcmp\(Payload, "HOF1", 4\)/);
+assert.match(handoff, /Payload\[14\] > 16[^]*?Payload\[15\] > 8[^]*?> 128/);
+assert.match(handoff, /Payload\[18\] != 1/,
+  "the first retained-engine gate accepts only unit steps until swept collision exists");
+assert.match(handoff, /Payload\[24 \+ UsedBytes - 1\] & ~LastMask[^]*?MPEThinBytesZero\(Payload,[^]*?24 \+ UsedBytes/);
+assert.match(handoff, /Candidate.Room = Payload\[4\][^]*?Candidate.RoomGeneration = AGIPicRoomGeneration[^]*?MPEThinRoomFootPassable\(Candidate, Payload\[5\], Payload\[6\]\)/);
+
+const input = section("static bool MPEThinRoomInputValid", "static uint8_t MPEThinRoomLoopForDirection");
+assert.match(input, /memcmp\(Payload, "INP1", 4\)[^]*?Payload\[4\] != MPEThinRoom.Room/);
+assert.match(input, /MPEThinRead32\(Payload \+ 8\) != MPEThinRoom.Tick[^]*?MPEThinBytesZero\(Payload, 12, 40\)/);
+assert.match(input, /EnvelopeFlags & ~\(MPEThinRoomInputParserSubmitted[^]*?MPEThinRoomEnvelopeControllerEdges\)/);
+assert.match(input, /Submitted == Look && Submitted == EnvelopeSubmitted/);
+const loopMapping = section("static uint8_t MPEThinRoomLoopForDirection",
+  "static uint8_t MPEThinRoomPriorityForY");
+assert.match(loopMapping,
+  /!Direction[^]*?return Previous[^]*?Direction == 1[^]*?return 3[^]*?Direction >= 2 && Direction <= 4[^]*?return 0[^]*?Direction == 5[^]*?return 2[^]*?return 1/);
+const loopForDirection = (direction, previous = 2) => direction === 0 ? previous
+  : direction === 1 ? 3 : direction <= 4 ? 0 : direction === 5 ? 2 : 1;
+assert.deepEqual(Array.from({ length: 9 }, (_, direction) => loopForDirection(direction)),
+  [2, 3, 0, 0, 0, 2, 1, 1, 1], "AGI direction-to-loop table");
+
+const frame = section("static void MPEThinRoomBuildFrame", "static void MPEThinRoomAcceptHandoff");
+assert.match(frame, /memcpy\(Payload, "FRM1", 4\)/);
+for (const [offset, field] of [[4, "Room"], [5, "X"], [6, "Y"], [7, "Direction"],
+  [12, "Loop"], [13, "Cel"], [14, "Priority"], [15, "LastResultFlags"],
+  [16, "LastParserResult"], [17, "LastParserMessageID"]]) {
+  assert.match(frame, new RegExp(`Payload\\[${offset}\\] = MPEThinRoom\\.${field}`));
+}
+assert.match(frame, /MPEThinWrite32\(Payload \+ 8, MPEThinRoom.Tick\)/);
+
+const applyHandoff = section("static void MPEThinRoomAcceptHandoff", "static void MPEThinRoomAcceptInput");
+assert.match(applyHandoff, /MPEThinRoom.Room = Payload\[4\][^]*?MPEThinRoom.Tick = MPEThinRead32\(Payload \+ 8\)/);
+assert.match(applyHandoff, /MPEThinRoom.Loop = Payload\[23\] & 0x03[^]*?Priority = \(Payload\[23\] >> 2\) & 0x0F/);
+assert.match(applyHandoff, /memcpy\(MPEThinRoom.Passability, Payload \+ 24, MPEThinRoomMapBytes\)/);
+assert.match(applyHandoff, /MPEThinRoom.RoomGeneration = AGIPicRoomGeneration/);
+assert.match(applyHandoff, /MPEThinRoomResultHandoff[^]*?MPEThinRoomResultRoomChanged/);
+
+const applyInput = section("static void MPEThinRoomAcceptInput", "static bool MPEThinRoomRequest");
+assert.match(applyInput, /MPEThinRoom.Tick\+\+/);
+assert.match(applyInput, /MPEThinRoomFootPassable\(MPEThinRoom,[^]*?CandidateX, CandidateY\)/);
+assert.match(applyInput, /MPEThinRoomResultMoved[^]*?else MPEThinRoom.LastResultFlags \|= MPEThinRoomResultBlocked/);
+assert.match(applyInput, /MPEThinRoom.Tick % MPEThinRoom.CycleTicks[^]*?MPEThinRoomResultAnimation/);
+assert.match(applyInput, /Payload\[7\] == MPEThinRoomParserLook[^]*?MPEThinRoomParserResultMessage[^]*?LookMessageID/);
+const collision = section("static bool MPEThinRoomFootPassable", "static bool MPEThinRoomHandoffValid");
+assert.match(collision, /MPEThinRoomFootWidth - 1[^]*?Offset < MPEThinRoomFootWidth/);
+assert.match(collision, /MPEThinRoomMapPassable[^]*?MPEThinRoomPriorityPassable/);
+
+const request = section("static bool MPEThinRoomRequest", "static void MPEThinReset");
+assert.match(request, /!MPEThinStarted \|\| SessionNonce != MPEThinSessionNonce/);
+assert.match(request, /AGIPicRoomToken != MPEThinRoom.Room[^]*?AGIPicRoomGeneration != MPEThinRoom.RoomGeneration/);
+assert.match(request, /Sequence == MPEThinRoom.LastSequence[^]*?RequestCRC != MPEThinRoom.LastRequestCRC/);
+assert.match(request, /Sequence == MPEThinRoom.LastSequence[^]*?MPEThinRoomBuildFrame\(Frame\)[^]*?return true[^]*?!MPEThinSequenceNewer\(Sequence, Reference\)/,
+  "duplicate INPUT must replay the retained frame before any state mutation");
+assert.match(request, /!MPEThinSequenceNewer\(Sequence, Reference\)/);
+assert.doesNotMatch(request, /MPEThinRoomHandoffValid|MPEThinRoomAcceptHandoff/,
+  "HOF1 is START-only and INPUT_SNAPSHOT cannot reset retained authority");
+assert.match(request, /MPEThinInputSnapshot[^]*?MPEThinRoomInputValid[^]*?MPEThinRoomAcceptInput/);
+assert.match(request, /else return false[^]*?MPEThinRoomBuildFrame/);
+
+const publisher = section("static bool MPEThinPublishHeld", "static void MPEThinKick");
+assert.match(publisher, /MPEThinOutput\[6\] = PayloadLength[^]*?MPEThinOutput\[7\] = OutputFlags/);
+assert.match(publisher, /memcpy\(MPEThinOutput \+ MPEThinPayloadOffset, Payload, PayloadLength\)/);
+assert.equal((publisher.match(/AGIContinueDMA\(false/g) ?? []).length, 1);
+assert.doesNotMatch(publisher, /PerformDMA|CloseDMA/);
+const kick = section("static void MPEThinKick", "static void AGIPictureResetSession");
+assert.equal((kick.match(/MPEThinReadRequestHeld\(\)/g) ?? []).length, 1);
+assert.equal((kick.match(/MPEThinPublishHeld\(/g) ?? []).length, 1);
+assert.match(kick, /MPEThinRoomRequest\(Opcode, MPEThinInput\[7\], Sequence,[^]*?PayloadLength = MPEThinRoomPayloadBytes/);
+assert.match(kick, /if \(Valid\)[^]*?MPEThinPublishHeld[^]*?MPEThinCloseHeld\(\)/);
+assert.match(kick, /Opcode == MPEThinInputStart[^]*?SameStart[^]*?RequestCRC != MPEThinLastStartCRC[^]*?MPEThinLastStartWasHandoff[^]*?MPEThinRoomBuildFrame\(Frame\)[^]*?MPEThinOutputFrame[^]*?else Status = MPEThinOutputBoot/,
+  "duplicate exact START must replay its prior BOOT or HOF1 FRAME without mutation");
+assert.match(kick, /EmptyStart = !InputLength && !MPEThinInput\[7\][^]*?HandoffStart = !MPEThinInput\[7\][^]*?MPEThinRoomHandoffValid/);
+assert.match(kick, /SameSession && !MPEThinSequenceNewer\(Sequence, Reference\)[^]*?!EmptyStart && !HandoffStart[^]*?Valid = false/);
+assert.match(kick, /MPEThinLastStartWasHandoff = HandoffStart[^]*?MPEThinRoomAcceptHandoff[^]*?MPEThinRoomBuildFrame[^]*?MPEThinOutputFrame/,
+  "a 40-byte HOF1 START must return FRM1 while empty START remains BOOT-compatible");
+assert.match(kick, /Opcode == MPEThinInputStop[^]*?ExactStoppedReplay[^]*?MPEThinLastStopSequence[^]*?MPEThinLastStopNonce[^]*?MPEThinLastStopCRC[^]*?Status = MPEThinOutputIdle/,
+  "exact duplicate STOP must replay the same correlated IDLE");
+assert.match(kick, /memset\(&MPEThinRoom[^]*?MPEThinSessionNonce = 0[^]*?MPEThinStarted = false[^]*?MPEThinLastStopValid = true/,
+  "STOP must clear engine authority before retaining only its replay key");
+assert.match(request, /Opcode == MPEThinInputResync[^]*?MPEThinRoom.Active[^]*?!PayloadLength[^]*?MPEThinRoomBuildFrame/,
+  "FORCE_FULL_RESYNC must publish the retained FRAME without advancing it");
+
+const activation = section("static void MPEThinClientActivate", "static bool MPEThinUpgradeWrite");
+assert.match(activation, /PreserveRoom = AGIPicActive[^]*?AGIPicRoomValid[^]*?AGIPicRoomGeneration/);
+assert.match(activation, /AGIPictureActivate\(AGIPicProtocolV3, Layout, PreserveRoom\)/);
+const upgrade = section("static bool MPEThinUpgradeWrite", "void AGIPictureInit");
+assert.match(upgrade, /!MHSPEActive[^]*?HelperProtocol != AGIPicProtocolV3[^]*?Layout != AGIPicLayout/);
+assert.match(upgrade, /Address == AGIPicReg_Error && Data == AGIPicV3Challenge[^]*?MPEThinUpgradeStage = 1/);
+assert.match(upgrade, /'M', 'P', 'E', '\+', 2/);
+assert.match(upgrade, /Address != UpgradeAddress\[Step - 1\][^]*?Data != UpgradeData\[Step - 1\][^]*?MPEThinUpgradeStage = 0/);
+assert.match(upgrade, /!AGIPicRoomValid[^]*?!AGIPicRoomGeneration[^]*?!AGIPicRoomPriorityLength[^]*?MPEThinClientActivate\(Layout\)/);
+const ioHandler = section("bool AGIPictureIO2Hndlr", "bool AGIPictureBusy");
+assert.match(ioHandler, /if \(R_Wn\)[^]*?MPEThinUpgradeStage = 0/);
+assert.match(ioHandler, /MPEThinUpgradeWrite\(Address, Data, HelperProtocol, Layout\)/);
+
+// An exact wire vector keeps the cartridge, host codec, and firmware offsets
+// pinned even though this test deliberately does not emulate ARM code.
+const handoffVector = Buffer.alloc(40);
+handoffVector.write("HOF1", 0, "ascii");
+handoffVector[4] = 2; handoffVector[5] = 0; handoffVector[6] = 1;
+handoffVector[7] = 3; handoffVector.writeUInt32LE(10, 8);
+handoffVector[12] = 0; handoffVector[13] = 0;
+handoffVector[14] = 8; handoffVector[15] = 2;
+handoffVector[16] = 2; handoffVector[17] = 2;
+handoffVector[18] = 1; handoffVector[19] = 2;
+handoffVector[20] = 2; handoffVector[21] = 1;
+handoffVector[22] = 0; handoffVector[23] = 2 | (6 << 2);
+handoffVector[24] = 0b00000111; // cells 0-2 fit the 12-column foot; cell 3 is wall.
+handoffVector[25] = 0xff;
+assert.equal(handoffVector.length, 40);
+assert.equal(handoffVector.subarray(0, 4).toString("ascii"), "HOF1");
+assert.equal(handoffVector.readUInt32LE(8), 10);
+assert.equal(handoffVector[23] & 3, 2);
+assert.equal((handoffVector[23] >> 2) & 15, 6);
+const passable = (x, y) => {
+  const column = (x - handoffVector[12]) >> handoffVector[16];
+  const row = (y - handoffVector[13]) >> handoffVector[17];
+  if (column < 0 || column >= handoffVector[14] || row < 0 || row >= handoffVector[15]) return false;
+  const cell = row * handoffVector[14] + column;
+  return (handoffVector[24 + (cell >> 3)] & (1 << (cell & 7))) !== 0;
+};
+assert.equal(passable(0, 1), true);
+assert.equal(passable(11, 1), true);
+assert.equal(passable(12, 1), false);
+assert.equal(passable(0, 8), false);
+const footPassable = (x, y) => Array.from({ length: 12 }, (_, offset) => x + offset)
+  .every(sampleX => passable(sampleX, y));
+assert.equal(footPassable(0, 1), true);
+assert.equal(footPassable(1, 1), false, "conservative foot sweep blocks before wall overlap");
+
+const inputVector = Buffer.alloc(40);
+inputVector.write("INP1", 0, "ascii"); inputVector[4] = 2;
+inputVector[5] = 3; inputVector[6] = 1; inputVector[7] = 1;
+inputVector.writeUInt32LE(10, 8);
+assert.equal(inputVector.subarray(12).every(byte => byte === 0), true);
+
+const frameVector = Buffer.alloc(40);
+frameVector.write("FRM1", 0, "ascii"); frameVector[4] = 2;
+frameVector[5] = 0; frameVector[6] = 1; frameVector[7] = 3;
+frameVector.writeUInt32LE(11, 8); frameVector[12] = 2;
+frameVector[13] = 0; frameVector[14] = 6;
+frameVector[15] = 0x02 | 0x04; frameVector[16] = 1; frameVector[17] = 1;
+assert.equal(frameVector[15] & 3, 2, "a blocked frame cannot also report movement");
+assert.deepEqual([...frameVector.subarray(18)], Array(22).fill(0));
+
+console.log("MPE2 retained room engine firmware conformance: PASS");
