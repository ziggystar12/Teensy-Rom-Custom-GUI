diff --git a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
--- a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
+++ b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
@@ -102,6 +102,8 @@ struct MPEVirtualAGIState
    uint8_t EasyFlashControl;
    uint8_t ProcessorPort;
    uint8_t CIA2TimerBControl;
+   uint8_t CIA1PortAInput;
+   uint8_t CIA1PortBInput;
    uint8_t KeyRead;
    uint8_t KeyWrite;
    uint8_t PresentedRoom;
@@ -465,6 +467,14 @@ static bool MPEVirtualCartridgeRead(uint16_t Address, uint8_t *Value)
    return true;
 }
 
+static uint8_t MPEVirtualCIA1PortRead(uint16_t Port, uint16_t DDR,
+                                      uint8_t Input)
+{
+   uint8_t Direction = MPEVirtualRAM[DDR];
+   return (MPEVirtualRAM[Port] & Direction) |
+      (Input & (uint8_t)~Direction);
+}
+
 static uint8_t MPEVirtualMemoryRead(uint16_t Address, bool DebugRead)
 {
    (void)DebugRead;
@@ -496,6 +506,12 @@ static uint8_t MPEVirtualMemoryRead(uint16_t Address, bool DebugRead)
          return MPEVirtualColour[Address - MPEVirtualColourBase];
       if (Address == 0xDE00) return MPEVirtualState.EasyFlashBank;
       if (Address == 0xDE02) return MPEVirtualState.EasyFlashControl;
+      if (Address == 0xDC00)
+         return MPEVirtualCIA1PortRead(0xDC00, 0xDC02,
+                                       MPEVirtualState.CIA1PortAInput);
+      if (Address == 0xDC01)
+         return MPEVirtualCIA1PortRead(0xDC01, 0xDC03,
+                                       MPEVirtualState.CIA1PortBInput);
       if (Address == 0xDC04) return (uint8_t)MPEVirtualState.CIA1TimerA;
       if (Address == 0xDC05) return (uint8_t)(MPEVirtualState.CIA1TimerA >> 8);
       if (Address == 0xDD06) return (uint8_t)MPEVirtualState.CIA2TimerB;
@@ -893,6 +909,8 @@ static FLASHMEM bool MPEVirtualAGIBoot(const uint8_t *Descriptor,
    MPEVirtualState.ProcessorPort = Descriptor[11];
    MPEVirtualState.CIA1TimerA = 0xACE1;
    MPEVirtualState.CIA2TimerB = 0xFFFF;
+   MPEVirtualState.CIA1PortAInput = 0xFF;
+   MPEVirtualState.CIA1PortBInput = 0xFF;
    MPEVirtualRAM[0] = 0x2F;
    MPEVirtualRAM[1] = Descriptor[11];
    MPEVirtualRAM[0x02A6] = 0; // MPE2 physical target currently proves NTSC.
@@ -1211,10 +1229,23 @@ static uint8_t MPEVirtualAGIHostEvent()
    return 0;
 }
 
-static void MPEVirtualAGISetJoystick(uint8_t Held)
+static void MPEVirtualAGISetControllers(uint8_t Held, bool MouseSample,
+                                        uint8_t MousePotX,
+                                        uint8_t MousePotY,
+                                        uint8_t MouseButtons)
 {
-   // INT2 is active high; CIA port B is active low.  Bits 5..7 remain neutral.
-   MPEVirtualRAM[0xDC01] = (uint8_t)((~Held & 0x1F) | 0xE0);
+   // INT2 joystick state is active high; physical port 2 is CIA 1 port A.
+   // Keep the external pin state separate from the virtual output latch so a
+   // runtime POT-select write to $dc00 cannot overwrite the staged joystick.
+   MPEVirtualState.CIA1PortAInput = (uint8_t)((~Held & 0x1F) | 0xE0);
+
+   // A 1351 on physical port 1 owns CIA 1 port B fire and SID POT X/Y. The
+   // queue-backed KERNAL keyboard trap remains the only keyboard authority;
+   // this active-low input bit is therefore visible only to direct CIA reads.
+   MPEVirtualState.CIA1PortBInput =
+      (MouseSample && (MouseButtons & 0x10)) ? 0xEF : 0xFF;
+   MPEVirtualSID[0x19] = MouseSample ? MousePotX : 0xFF;
+   MPEVirtualSID[0x1A] = MouseSample ? MousePotY : 0xFF;
 }
 
 static bool MPEVirtualAGIQueueInputKey(uint8_t Key)
diff --git a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c
