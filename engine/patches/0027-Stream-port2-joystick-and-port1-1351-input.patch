@@ -5167,15 +5167,18 @@ static bool MPEThinVirtualInputHeld(const uint8_t *Payload,
 {
    if (!Payload || !GenerationMismatch ||
        memcmp(Payload, "INT2", 4) != 0 || Payload[4] != 1 ||
-       (Payload[5] & ~0x3F) ||
+       (Payload[5] & ~0x7F) ||
        MPEThinVirtualEnvelopeFlags(Payload[5]) != EnvelopeFlags ||
-       Payload[15] || !MPEThinBytesZero(Payload, 21, 24) ||
+       Payload[15] ||
        !MPEThinBytesZero(Payload, 28, 40)) return false;
 
    uint8_t StreamFlags = Payload[5];
+   bool MouseSample = (StreamFlags & 0x40) != 0;
    uint8_t TextLength = Payload[14];
    bool TextSubmitted = (StreamFlags & 0x02) != 0;
    if (TextSubmitted != (TextLength != 0) || TextLength > 36) return false;
+   if ((Payload[23] & ~0x10) ||
+       (!MouseSample && !MPEThinBytesZero(Payload, 21, 24))) return false;
    if (((StreamFlags & 0x08) != 0) != (Payload[18] != 0) ||
        ((StreamFlags & 0x10) != 0) != (Payload[19] != 0) ||
        ((StreamFlags & 0x20) != 0) != (Payload[20] != 0)) return false;
@@ -5199,7 +5202,8 @@ static bool MPEThinVirtualInputHeld(const uint8_t *Payload,
 
    *GenerationMismatch = MPEThinRead32(Payload + 24) !=
       MPEVirtualState.PresentationGeneration;
-   MPEVirtualAGISetJoystick(Payload[6]);
+   MPEVirtualAGISetControllers(Payload[6], MouseSample,
+                               Payload[21], Payload[22], Payload[23]);
    return MPEVirtualAGIQueueInputKey(Payload[8]);
 }
 
