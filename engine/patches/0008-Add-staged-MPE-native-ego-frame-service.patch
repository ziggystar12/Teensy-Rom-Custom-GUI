+static uint32_t MHSNativeEgoRead24(const uint8_t *Data)
+{
+   return (uint32_t)Data[0] | ((uint32_t)Data[1] << 8) |
+      ((uint32_t)Data[2] << 16);
+}
+
+// The game package header is fixed at raw $004000 for both supported cartridge
+// layouts. Resolve the immutable generic GBC1 index and native-ego root there;
+// the $45 caller never has to expose cartridge pointers or preload sprite data.
+FLASHMEM static bool MHSNativeEgoResolvePack(uint32_t *GBC1Root,
+                                     uint32_t *ActorRoot,
+                                     uint16_t *ActorLength,
+                                     uint8_t *LegacyView, uint8_t *Error)
+{
+   if (!AGIPictureReadRawBytes(MHSNativePackHeaderRaw,
+                               MHSNativeEgoPackHeader,
+                               sizeof(MHSNativeEgoPackHeader), Error))
+      return false;
+   const uint8_t *Header = MHSNativeEgoPackHeader;
+   uint16_t HeaderBytes = Header[8] | ((uint16_t)Header[9] << 8);
+   uint16_t ViewCount = Header[119] | ((uint16_t)Header[120] << 8);
+   *ActorRoot = MHSNativeEgoRead24(Header + 66);
+   *ActorLength = Header[69] | ((uint16_t)Header[70] << 8);
+   *LegacyView = Header[72];
+   *GBC1Root = MHSNativeEgoRead24(Header + 112);
+   if (memcmp(Header, "CAGI", 4) != 0 || Header[4] != 1 ||
+       HeaderBytes != MHSNativePackHeaderBytes || Header[116] != 1 ||
+       !ViewCount || !*ActorLength || *ActorLength < 32 ||
+       !*ActorRoot || *ActorRoot == 0xFFFFFFu ||
+       !*GBC1Root || *GBC1Root == 0xFFFFFFu ||
+       !AGIPictureRawSpanValid(*ActorRoot, *ActorLength) ||
+       !AGIPictureRawSpanValid(*GBC1Root, AGIPicGBC1IndexBytes))
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   return true;
+}
+
+// CAGI +66 may identify one legacy CSPR3 stream or a canonical CSPM1 bundle.
+// Validate the complete CSPM directory before retaining the selected VIEW span;
+// a duplicate id, gap, overlap, short member, or wrapped raw pointer fails shut.
+FLASHMEM static bool MHSNativeEgoResolveStream(uint32_t ActorRoot,
+                                       uint16_t ActorLength,
+                                       uint8_t LegacyView, uint8_t View,
+                                       uint32_t *StreamRaw,
+                                       uint16_t *StreamLength,
+                                       uint8_t *Error)
+{
+   uint8_t Header[8];
+   if (!AGIPictureReadRawBytes(ActorRoot, Header, sizeof(Header), Error))
+      return false;
+   if (memcmp(Header, "CSPR", 4) == 0)
+   {
+      if (LegacyView != View)
+      {
+         *Error = AGIPicError_NativeResultState;
+         return false;
+      }
+      *StreamRaw = ActorRoot;
+      *StreamLength = ActorLength;
+      return true;
+   }
+   if (memcmp(Header, "CSPM", 4) != 0 || Header[4] != 1 || Header[5] < 2 ||
+       Header[6] != 3 || Header[7] || LegacyView != 0xFF)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   uint8_t Count = Header[5];
+   uint16_t DirectoryEnd = 8u + (uint16_t)Count * 3u;
+   if (DirectoryEnd > ActorLength)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   memset(MHSNativeEgoViewSeen, 0, sizeof(MHSNativeEgoViewSeen));
+   uint8_t PriorView = 0;
+   uint16_t PriorOffset = 0;
+   bool Found = false;
+   for (uint16_t Index = 0; Index < Count; Index++)
+   {
+      uint8_t Entry[3];
+      if (!AGIPictureReadRawBytes(ActorRoot + 8u + Index * 3u,
+                                  Entry, sizeof(Entry), Error)) return false;
+      uint8_t EntryView = Entry[0];
+      uint8_t SeenMask = 1u << (EntryView & 7u);
+      if (MHSNativeEgoViewSeen[EntryView >> 3] & SeenMask)
+      {
+         *Error = AGIPicError_NativeResultState;
+         return false;
+      }
+      MHSNativeEgoViewSeen[EntryView >> 3] |= SeenMask;
+      uint16_t Offset = Entry[1] | ((uint16_t)Entry[2] << 8);
+      if ((Index ? Offset <= PriorOffset ||
+                   (uint16_t)(Offset - PriorOffset) < (uint16_t)32 :
+                   Offset != DirectoryEnd) ||
+          Offset > ActorLength ||
+          (uint16_t)(ActorLength - Offset) < (uint16_t)32)
+      {
+         *Error = AGIPicError_NativeResultState;
+         return false;
+      }
+      if (Index && PriorView == View)
+      {
+         *StreamRaw = ActorRoot + PriorOffset;
+         *StreamLength = Offset - PriorOffset;
+         Found = true;
+      }
+      PriorView = EntryView;
+      PriorOffset = Offset;
+   }
+   if (PriorView == View)
+   {
+      *StreamRaw = ActorRoot + PriorOffset;
+      *StreamLength = ActorLength - PriorOffset;
+      Found = true;
+   }
+   if (!Found || *StreamRaw < ActorRoot ||
+       !AGIPictureRawSpanValid(*StreamRaw, *StreamLength))
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   return true;
+}
+
+// Select exactly one immutable CSPR3 frame. Requiring the directory-derived
+// frame count to consume the complete stream prevents stale padding or a CSPM
+// member boundary from being interpreted as sprite bytes.
+FLASHMEM static bool MHSNativeEgoLoadPair(uint32_t StreamRaw,
+                                  uint16_t StreamLength,
+                                  const stcAGIActorCel *Ego,
+                                  uint8_t *Error)
+{
+   uint8_t Header[32];
+   if (!AGIPictureReadRawBytes(StreamRaw, Header, sizeof(Header), Error))
+      return false;
+   if (memcmp(Header, "CSPR", 4) != 0 || Header[4] != 3 ||
+       Header[5] > 15 || Header[6] > 15 || Header[7] > 15 || Header[8] > 15 ||
+       !Header[9] || Header[9] > 4 || Header[10] != MHSNativeEgoOutputBytes)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   uint16_t FrameCount = 0;
+   for (uint8_t Loop = 0; Loop < Header[9]; Loop++)
+   {
+      uint8_t Start = Header[11 + Loop * 2u];
+      uint8_t Count = Header[12 + Loop * 2u];
+      if (Start != FrameCount || !Count || FrameCount + Count > 255u)
+      {
+         *Error = AGIPicError_NativeResultState;
+         return false;
+      }
+      FrameCount += Count;
+   }
+   uint32_t Required = 32u + (uint32_t)FrameCount * MHSNativeEgoOutputBytes;
+   if (Required != StreamLength || Ego->State.Loop >= Header[9])
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   uint8_t First = Header[11 + Ego->State.Loop * 2u];
+   uint8_t Count = Header[12 + Ego->State.Loop * 2u];
+   if (Ego->State.Cel >= Count)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   uint16_t Frame = (uint16_t)First + Ego->State.Cel;
+   uint32_t FrameRaw = StreamRaw + 32u +
+      (uint32_t)Frame * MHSNativeEgoOutputBytes;
+   if (FrameRaw < StreamRaw ||
+       !AGIPictureRawSpanValid(FrameRaw, MHSNativeEgoOutputBytes) ||
+       !AGIPictureReadRawBytes(FrameRaw, MHSNativeEgoPair,
+                               MHSNativeEgoOutputBytes, Error)) return false;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeEgoPixelOccluded(const stcAGIActorCel *Ego,
+                                        uint8_t TargetX, uint8_t TargetY,
+                                        bool *Occluded, uint8_t *Error)
+{
+   *Occluded = !AGIPictureRoomPriorityAllows(TargetX, TargetY,
+                                              Ego->EffectivePriority);
+   if (*Occluded) return true;
+   for (uint8_t Object = 1; Object < AGIPicActorCount; Object++)
+   {
+      stcAGIActorCel *Actor = &AGIPicCurrentActors[Object];
+      if (!Actor->Drawn || Actor->EffectivePriority < Ego->EffectivePriority)
+         continue;
+      if (Actor->EffectivePriority == Ego->EffectivePriority &&
+          !(Actor->State.Flags & 0x80) && !(Ego->State.Flags & 0x80) &&
+          Actor->State.Y < Ego->State.Y) continue;
+      if (TargetX < Actor->State.X ||
+          TargetX >= (uint16_t)Actor->State.X + Actor->State.Width ||
+          TargetY > Actor->State.Y) continue;
+      int16_t Top = (int16_t)Actor->State.Y + 1 - Actor->State.Height;
+      if ((int16_t)TargetY < Top) continue;
+      uint8_t Colour = 0;
+      bool Opaque = false;
+      if (!AGIPictureActorPixel(Actor, TargetX - Actor->State.X,
+                                (uint8_t)((int16_t)TargetY - Top),
+                                &Colour, &Opaque, Error)) return false;
+      if (Opaque && AGIPictureRoomPriorityAllows(TargetX, TargetY,
+                                                  Actor->EffectivePriority))
+      {
+         *Occluded = true;
+         return true;
+      }
+   }
+   return true;
+}
+
+FLASHMEM static bool MHSNativeEgoMaskPair(const stcAGIActorCel *Ego,
+                                  bool *Masked, uint8_t *Error)
+{
+   *Masked = false;
+   int16_t Top = (int16_t)Ego->State.Y + 1 - Ego->State.Height;
+   for (uint8_t SourceY = 0; SourceY < Ego->State.Height; SourceY++)
+      for (uint8_t SourceX = 0; SourceX < Ego->State.Width; SourceX++)
+      {
+         uint16_t Byte = (SourceY >= 21 ? 64u : 0u) +
+            (uint16_t)(SourceY % 21u) * 3u + (SourceX >> 2);
+         uint8_t Bits = 0xC0u >> ((SourceX & 3u) * 2u);
+         if (!(MHSNativeEgoPair[Byte] & Bits)) continue;
+         int16_t X = (int16_t)Ego->State.X + SourceX;
+         int16_t Y = Top + SourceY;
+         bool Occluded = X < 0 || X >= 160 || Y < 0 || Y >= 168;
+         if (!Occluded &&
+             !MHSNativeEgoPixelOccluded(Ego, (uint8_t)X, (uint8_t)Y,
+                                        &Occluded, Error)) return false;
+         if (Occluded)
+         {
+            MHSNativeEgoPair[Byte] &= ~Bits;
+            *Masked = true;
+         }
+      }
+   return true;
+}
+
+// $45 is deliberately a one-way publication into compiler-reserved inert RAM.
+// Every input is read-only; all parsing and masking complete in Teensy memory;
+// then one exact 128-byte DMA publishes $5A70-$5AEF. No live sprite, bitmap,
+// object, or interpreter byte is ever a DMA destination on this path.
+FLASHMEM static bool MHSNativeEgoFrame(uint16_t ObjectBase, uint8_t Picture,
+                               uint16_t OutputAddress, uint8_t OutputLength,
+                               uint8_t MachineFlags, uint8_t RequestToken,
+                               uint8_t *Width, uint8_t *Height,
+                               uint8_t *Checksum, bool *Masked,
+                               uint8_t *Error)
+{
+   if (!MHSPEActive || !AGIPicRoomValid || Picture != AGIPicRoomToken ||
+       !AGIPicRoomGeneration || !RequestToken ||
+       OutputAddress != MHSNativeEgoOutputAddress ||
+       OutputLength != MHSNativeEgoOutputBytes ||
+       (MachineFlags & ~AGIPicMachine_NTSC) || ObjectBase < 0x0200 ||
+       ObjectBase > 0x10000u - AGIPicActorTableBytes ||
+       (MHSNativeEgoLastRoomGeneration == AGIPicRoomGeneration &&
+        MHSNativeEgoLastRequestToken == RequestToken))
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   if (DMA_State != DMA_S_DisableReady)
+   {
+      *Error = AGIPicError_DMAUnavailable;
+      return false;
+   }
+   AGIPictureApplyVideoTiming();
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] = AGIPicStatus_DMA;
+   if (!AGIPictureDMAReadRoomSegment(ObjectBase, AGIPicActorTable,
+                                      AGIPicActorTableBytes))
+   {
+      *Error = AGIPicError_DMATimeout;
+      return false;
+   }
+
+   uint16_t RoomGeneration = AGIPicRoomGeneration;
+   uint32_t GBC1Root, ActorRoot, StreamRaw;
+   uint16_t ActorLength, StreamLength;
+   uint8_t LegacyView, ActorCount;
+   bool Okay = MHSNativeEgoResolvePack(&GBC1Root, &ActorRoot, &ActorLength,
+                                       &LegacyView, Error) &&
+      AGIPictureBuildActorOrder(GBC1Root, 0, &ActorCount, Error);
+   stcAGIActorCel *Ego = &AGIPicCurrentActors[0];
+   if (Okay && (!Ego->Drawn || !Ego->State.Width || Ego->State.Width > 12 ||
+                !Ego->State.Height || Ego->State.Height > 42))
+   {
+      *Error = AGIPicError_NativeResultState;
+      Okay = false;
+   }
+   if (Okay)
+      Okay = MHSNativeEgoResolveStream(ActorRoot, ActorLength, LegacyView,
+                                       Ego->State.View, &StreamRaw,
+                                       &StreamLength, Error) &&
+         MHSNativeEgoLoadPair(StreamRaw, StreamLength, Ego, Error) &&
+         MHSNativeEgoMaskPair(Ego, Masked, Error);
+   AGIPictureReleaseSource();
+   if (!Okay) return false;
+   if (!AGIPicRoomValid || AGIPicRoomToken != Picture ||
+       AGIPicRoomGeneration != RoomGeneration ||
+       DMA_State != DMA_S_DisableReady)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+
+   *Width = Ego->State.Width;
+   *Height = Ego->State.Height;
+   uint8_t XOR = 0;
+   for (uint8_t Index = 0; Index < MHSNativeEgoOutputBytes; Index++)
+      XOR ^= MHSNativeEgoPair[Index];
+   *Checksum = XOR;
+   bool Started = false;
+   bool Written = AGIPictureDMAWriteSegment(&Started, OutputAddress,
+                                             MHSNativeEgoPair,
+                                             MHSNativeEgoOutputBytes);
+   bool Closed = AGIPictureCloseScatter(Started);
+   if (!Written || !Closed)
+   {
+      if (DMA_State != DMA_S_DisableReady) CloseDMA();
+      *Error = AGIPicError_DMATimeout;
+      return false;
+   }
+   MHSNativeEgoLastRoomGeneration = RoomGeneration;
+   MHSNativeEgoLastRequestToken = RequestToken;
+   return true;
+}
+
+static void MHSNativeSetEgoResult(uint8_t Width, uint8_t Height,
+                                  uint8_t Checksum, bool Masked,
+                                  uint8_t RequestToken)
+{
+   AGIPicHoldHelperBank = false;
+   AGIPicRegisters[AGIPicReg_Source0 - AGIPicReg_ID0] = 'E';
+   AGIPicRegisters[AGIPicReg_Source1 - AGIPicReg_ID0] = 'G';
+   AGIPicRegisters[AGIPicReg_Source2 - AGIPicReg_ID0] = 'O';
+   AGIPicRegisters[AGIPicReg_Error - AGIPicReg_ID0] = Checksum;
+   AGIPicRegisters[AGIPicReg_Argument0 - AGIPicReg_ID0] = Width;
+   AGIPicRegisters[AGIPicReg_Argument1 - AGIPicReg_ID0] = Height;
+   AGIPicRegisters[AGIPicReg_MachineFlags - AGIPicReg_ID0] = Masked ?
+      MHSNativeEgoResultMasked : MHSNativeEgoResultPristine;
+   AGIPicRegisters[AGIPicReg_Token - AGIPicReg_ID0] = RequestToken;
+   AGIPicRegisters[AGIPicReg_Status - AGIPicReg_ID0] =
+      AGIPicStatus_MPENativeEgoFrame;
+}
