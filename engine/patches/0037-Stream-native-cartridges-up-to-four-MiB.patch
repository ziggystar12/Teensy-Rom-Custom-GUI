@@ -0,0 +1,54 @@
+// Native MPE cartridge directory. Upper CHIP banks are SD resources only;
+// the C64 EasyFlash bank register and its reserved bank 58 stay unchanged.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#ifndef MPE4_CART_CODE
+#define MPE4_CART_CODE
+#endif
+#ifndef MPE4_CART_RODATA
+#define MPE4_CART_RODATA
+#endif
+namespace mpe4cart {
+static constexpr uint32_t PhysicalLimit=0x400000u;
+static constexpr uint32_t HoleStart=0xE8000u, HoleBytes=0x4000u;
+static constexpr uint32_t LogicalLimit=PhysicalLimit-HoleBytes;
+struct Index { uint32_t pages[512]; bool native; };
+static MPE4_CART_CODE bool matches(const uint8_t *h)
+{
+   static const char name[32] MPE4_CART_RODATA="SQ1 MPE3 TITLE PULL";
+   static const char signature[] MPE4_CART_RODATA="C64 CARTRIDGE   ";
+   return !memcmp(h,signature,16) && h[16]==0 && h[17]==0 &&
+      h[18]==0 && h[19]==64 && h[20]==1 && h[21]==0 && h[22]==0 &&
+      h[23]==32 && !memcmp(h+32,name,32);
+}
+static MPE4_CART_CODE uint16_t be16(const uint8_t *p)
+{ return ((uint16_t)p[0]<<8)|p[1]; }
+static MPE4_CART_CODE uint32_t be32(const uint8_t *p)
+{ return ((uint32_t)be16(p)<<16)|be16(p+2); }
+// Every accepted entry points to a complete 8 KiB payload in this same file.
+// Zero is the missing-page sentinel; CHIP payloads cannot start before 0x50.
+static MPE4_CART_CODE uint8_t add(Index &index,const uint8_t *h,uint32_t payload,uint32_t fileBytes)
+{
+   static const char marker[4] MPE4_CART_RODATA={'C','H','I','P'};
+   if(memcmp(h,marker,4)||be32(h+4)!=0x2010u||be16(h+14)!=0x2000u)return 1;
+   uint16_t type=be16(h+8),bank=be16(h+10),address=be16(h+12);
+   if((type!=0&&type!=2)||bank>=256||bank==58||(address!=0x8000&&address!=0xA000))return 2;
+   if(payload<0x50u||payload>fileBytes||0x2000u>fileBytes-payload)return 3;
+   uint16_t page=bank*2u+(address==0xA000);
+   if(index.pages[page])return 4;
+   if((!index.pages[0]&&page!=0)||(index.pages[0]&&!index.pages[1]&&page!=1))return 5;
+   index.pages[page]=payload;
+   return 0;
+}
+// Limit each physical read at the reserved mailbox hole. The caller repeats
+// this for a cache request that straddles the logical 0xE8000 boundary.
+static MPE4_CART_CODE bool span(uint32_t logical,uint16_t count,uint32_t &physical,uint16_t &part)
+{
+   if(!count||logical>=LogicalLimit||count>LogicalLimit-logical)return false;
+   physical=logical;part=count;
+   if(logical>=HoleStart)physical+=HoleBytes;
+   else if(part>HoleStart-logical)part=(uint16_t)(HoleStart-logical);
+   return true;
+}
+}
