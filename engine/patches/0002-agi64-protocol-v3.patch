+      {
+         *Error = AGIPicError_MalformedPriority;
+         return false;
+      }
+      uint16_t Offset = Address - 0x8000;
+      if (Offset > Length - 2)
+      {
+         *Error = AGIPicError_MalformedPriority;
+         return false;
+      }
+      uint8_t Runs = AGIPicRoomPriority[Offset];
+      uint16_t Capacity = AGIPicRoomPriority[Offset + 1];
