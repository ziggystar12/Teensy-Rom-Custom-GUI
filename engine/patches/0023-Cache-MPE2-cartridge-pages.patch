+       !MPEVirtualAGIResolveCartridgePage(Raw, &Low, &Error) ||
+       !MPEVirtualAGIResolveCartridgePage(
+          Raw + MPEVirtualCartridgePageBytes, &High, &Error))
+   {
+      MPEVirtualState.Faulted = true;
+      return false;
+   }
