+      {
+         ResolvedSlot = (int8_t)Slot;
+         break;
+      }
+
+   bool Owned = false;
+   if (ResolvedSlot >= 0)
+   {
+      uint8_t Slot = (uint8_t)ResolvedSlot;
+      if (AGIPicSourceSlot == ResolvedSlot)
+      {
+         // Promote the freshly loaded source page into the persistent cache.
+         AGIPicSourceSlot = -1;
+         Owned = true;
+      }
+      else if (Resolved != LOROM_Image && Resolved != HIROM_Image)
+      {
+         uint32_t InterruptMask = __get_primask();
+         __disable_irq();
+         if (!AGIPicSlotOwned[Slot])
+         {
+            AGIPicSlotOwned[Slot] = true;
+            Owned = true;
+         }
+         __set_primask(InterruptMask);
+      }
