+       MPEVirtualActiveCartridgePage[0] &&
+       MPEVirtualActiveCartridgePage[1]) return true;
+
+   MPEVirtualState.EasyFlashBank = Bank;
+   MPEVirtualActiveCartridgePage[0] = nullptr;
+   MPEVirtualActiveCartridgePage[1] = nullptr;
+   uint32_t Raw = MPEVirtualState.CartridgeRawRoot +
+      (uint32_t)Bank * MPEVirtualEasyFlashBankBytes;
+   uint8_t *Low = nullptr;
