+   if (!AGIPictureResolveRawPage(Raw, &Resolved, Error) &&
+       *Error == AGIPicError_NoWorkspace)
+   {
+      // All non-active buffers are already cached. Reuse the least-recently
+      // selected owned page without releasing it between the two operations;
+      // ResolveRawPage can refill that exact source slot atomically.
+      int16_t VictimPage = MPEVirtualAGILRUOwnedPage();
+      if (VictimPage >= 0)
+      {
