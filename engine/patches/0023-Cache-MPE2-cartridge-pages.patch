+static uint32_t MPEVirtualAGINextPageStamp()
+{
+   if (++MPEVirtualPageCacheClock) return MPEVirtualPageCacheClock;
+   // A wrap would otherwise make the newest page look oldest. It requires
+   // billions of bank selections, but rebasing keeps arbitrarily long games
+   // deterministic without a 64-bit counter on the read path.
+   for (uint16_t Page = 0; Page < MPEVirtualCartridgePages; Page++)
+      if (MPEVirtualPageCache[Page].Valid)
+         MPEVirtualPageCache[Page].LastUse = 0;
+   MPEVirtualPageCacheClock = 1;
+   return MPEVirtualPageCacheClock;
+}
+
+static FLASHMEM __attribute__((noinline)) void
+   MPEVirtualAGIPageCacheSlotWillOverwrite(uint8_t Slot)
+{
+   if (Slot >= Num8kSwapBuffers) return;
+   int16_t Page = MPEVirtualSlotPage[Slot];
+   if (Page >= 0 && Page < MPEVirtualCartridgePages)
+   {
+      MPEVirtualCartridgePage *Entry = &MPEVirtualPageCache[Page];
+      if (Entry->Valid && Entry->Slot == (int8_t)Slot)
+      {
+         for (uint8_t Half = 0; Half < 2; Half++)
+            if (MPEVirtualActiveCartridgePage[Half] == Entry->Data)
+               MPEVirtualActiveCartridgePage[Half] = nullptr;
+         memset(Entry, 0, sizeof(*Entry));
+      }
+   }
+   MPEVirtualSlotPage[Slot] = -1;
+}
+
+static void MPEVirtualAGIResetPageCache()
+{
+   for (uint8_t Slot = 0; Slot < Num8kSwapBuffers; Slot++)
+   {
+      int16_t Page = MPEVirtualSlotPage[Slot];
+      if (Page >= 0 && Page < MPEVirtualCartridgePages)
+      {
+         MPEVirtualCartridgePage *Entry = &MPEVirtualPageCache[Page];
+         if (Entry->Valid && Entry->Owned &&
+             Entry->Slot == (int8_t)Slot && AGIPicSlotOwned[Slot])
+            AGIPicSlotOwned[Slot] = false;
+      }
+      MPEVirtualSlotPage[Slot] = -1;
+   }
+   memset(MPEVirtualPageCache, 0, sizeof(MPEVirtualPageCache));
+   memset(MPEVirtualActiveCartridgePage, 0,
+          sizeof(MPEVirtualActiveCartridgePage));
+   MPEVirtualPageCacheClock = 0;
+}
+
+static int16_t MPEVirtualAGILRUOwnedPage()
+{
+   int16_t OldestPage = -1;
+   uint32_t OldestStamp = UINT32_MAX;
+   uint16_t ActiveFirst = (uint16_t)MPEVirtualState.EasyFlashBank * 2u;
+   for (uint16_t Page = 0; Page < MPEVirtualCartridgePages; Page++)
+   {
+      MPEVirtualCartridgePage *Entry = &MPEVirtualPageCache[Page];
+      if (!Entry->Valid || !Entry->Owned || Entry->Slot < 0 ||
+          Page == ActiveFirst || Page == ActiveFirst + 1u) continue;
+      if (OldestPage < 0 || Entry->LastUse < OldestStamp)
+      {
+         OldestPage = (int16_t)Page;
+         OldestStamp = Entry->LastUse;
+      }
+   }
+   return OldestPage;
+}
