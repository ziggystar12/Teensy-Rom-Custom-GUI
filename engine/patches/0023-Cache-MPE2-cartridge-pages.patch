+   uint32_t Stamp = MPEVirtualAGINextPageStamp();
+   uint16_t FirstPage = (uint16_t)Bank * 2u;
+   MPEVirtualPageCache[FirstPage].LastUse = Stamp;
+   MPEVirtualPageCache[FirstPage + 1u].LastUse = Stamp;
+   MPEVirtualActiveCartridgePage[0] = Low;
+   MPEVirtualActiveCartridgePage[1] = High;
+   return true;
+}
