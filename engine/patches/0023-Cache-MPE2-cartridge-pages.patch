+            &MPEVirtualPageCache[VictimPage];
+         uint8_t VictimSlot = (uint8_t)Victim->Slot;
+         MPEVirtualSlotPage[VictimSlot] = -1;
+         memset(Victim, 0, sizeof(*Victim));
+         AGIPicSourceSlot = (int8_t)VictimSlot;
+         *Error = AGIPicError_None;
+         if (!AGIPictureResolveRawPage(Raw, &Resolved, Error))
+         {
