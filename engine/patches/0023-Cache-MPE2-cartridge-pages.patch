+            SwapBuffers[Slot].Image == Entry->Data &&
+            SwapBuffers[Slot].Offset == Entry->Tagged &&
+            (Entry->Owned ? AGIPicSlotOwned[Slot] :
+                            !AGIPicSlotOwned[Slot]);
+      }
+      if (Current)
+      {
+         *Page = Entry->Data;
+         return true;
+      }
+      if (Entry->Slot >= 0 && Entry->Slot < Num8kSwapBuffers &&
+          MPEVirtualSlotPage[(uint8_t)Entry->Slot] == (int16_t)PageIndex)
+         MPEVirtualSlotPage[(uint8_t)Entry->Slot] = -1;
+      memset(Entry, 0, sizeof(*Entry));
+   }
