+      // remaining uncached is still the safe fallback if that invariant ever
+      // changes. The current byte is valid from the resolved pointer.
+      if (!Owned && Resolved != LOROM_Image && Resolved != HIROM_Image)
+      {
+         *Page = Resolved;
+         return true;
+      }
