+   if (Page == 5)
+   {
+      // Native AGI is a retained, transactional service. It never publishes
+      // directly into live interpreter or video state: one bounded input DMA
+      // stages a tick, and one later bounded output DMA targets inert C64
+      // staging. The host validates sequence, epoch, state hash, and CRC before
+      // acknowledging the staged result.
+      MHSPowerEngineSetResultTag('N', 'A', 'G',
+                                 MHSPEServiceNativeAGI,
