+// OPEN publishes a 16-bit epoch in DFFC/DFFD. Never reuse it within one
+// firmware uptime: the 65,536th OPEN fails closed and a hardware reset starts
+// a new uptime domain. MTI1 retains a 32-bit field for a future protocol.
+static uint16_t MHSNativeEpochCounter;
+static uint32_t MHSNativeEngineEpoch;
+static uint32_t MHSNativeLastSequence;
+static uint32_t MHSNativePendingSequence;
+static uint32_t MHSNativePackageRaw;
+static uint32_t MHSNativePackageLength;
+static uint32_t MHSNativePackageBodyCRC;
+static uint8_t MHSNativePendingToken;
