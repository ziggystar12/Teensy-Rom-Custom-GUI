+  packet.write("MTI1", 0, "ascii");
+  packet[4] = 1;
+  packet[5] = 0x20;
+  packet[6] = 0x41;
+  write32(packet, 8, sequence);
+  write32(packet, 12, epoch);
+  packet[32] = token;
+  write32(packet, 60, crc32(packet.subarray(0, 60)));
+  return packet;
