+#!/usr/bin/env node
+
+// Host conformance checks for the first MPE Native AGI firmware milestone.
+// This milestone qualifies immutable package validation plus one input-DMA /
+// staged-result-DMA transaction. It deliberately produces a no-op tick until
+// the differential-tested AGI engine is installed behind the same contract.
+
+import assert from "node:assert/strict";
+import fs from "node:fs";
+
+const firmware = fs.readFileSync(new URL(
+  "../Common/IO_Handlers/IOH_AGIPicture.c", import.meta.url), "utf8");
+
+const constants = {
+  AGIPicCmd_MPENativeOpen: "0x40",
+  AGIPicCmd_MPENativePost: "0x41",
+  AGIPicCmd_MPENativeStatus: "0x42",
+  AGIPicCmd_MPENativeCommit: "0x43",
+  AGIPicCmd_MPENativeAck: "0x44",
+  AGIPicStatus_MPENativeOpened: "0xC0",
+  AGIPicStatus_MPENativeReady: "0xC1",
+  AGIPicStatus_MPENativeStatus: "0xC2",
+  AGIPicStatus_MPENativeCommitted: "0xC3",
+  AGIPicStatus_MPENativeAcked: "0xC4",
+  MHSPEServiceNativeAGI: "0x20"
+};
+for (const [name, value] of Object.entries(constants))
+  assert.match(firmware, new RegExp(`\\b${name}\\s*=\\s*${value}\\b`));
+
+assert.match(firmware,
+  /Page == 5[^]*?MHSPowerEngineSetResultTag\('N', 'A', 'G'[^]*?MHSNativeCapabilities/);
+assert.match(firmware,
+  /MHSNativeOpenPackage[^]*?memcmp\(Header, "MGA1", 4\)[^]*?MHSNativeValidateCompatibility[^]*?MHSNativeValidateDirectory[^]*?BodyCRC/);
+assert.match(firmware,
+  /DirectoryOffset == CompatibilityOffset \+ CompatibilityLength[^]*?DataOffset == DirectoryOffset \+ DirectoryLength/);
+assert.match(firmware,
+  /MHSNativeTagValid[^]*?Tag\[Index\] == '_'/);
+assert.match(firmware,
+  /MHSNativeEpochCounter == 0xFFFFu[^]*?AGIPicError_NativeResultState[^]*?MHSNativeEpochCounter\+\+/);
+assert.match(firmware,
+  /MHSNativeStagingAddress\s*=\s*0x5A80/);
+assert.match(firmware,
+  /MHSNativeValidateTick[^]*?Address != MHSNativeStagingAddress[^]*?PerformDMA\(true[^]*?CloseDMA\(\)[^]*?memcmp\(Input, "MTI1", 4\)[^]*?MHSNativeCRC32/);
+assert.match(firmware,
+  /MHSNativeCommitResult[^]*?Capacity != MHSNativeTickBytes[^]*?Address != MHSNativeStagingAddress[^]*?PerformDMA\(false[^]*?MHSNativeTickResult[^]*?CloseDMA\(\)/);
+assert.match(firmware,
+  /MHSNativeAcknowledge[^]*?MHSNativeResultTransferred[^]*?MHSNativeLastSequence = MHSNativePendingSequence/);
+assert.match(firmware,
+  /first firmware milestone qualifies retained sequencing and staged[^]*?if \(Input\[7\] \|\| PayloadLength \|\| EventCount\)/);
+assert.doesNotMatch(firmware,
+  /MHSNativeCommitResult[^]*?AGIContinueDMA/,
+  "native commit must remain one contiguous write into inert staging");
+const activation = firmware.match(
+  /static void AGIPictureActivate\(uint8_t Protocol, uint8_t Layout\)\s*\{([^]*?)\n\}/)?.[1] ?? "";
+assert.ok(activation.length > 0, "AGIPictureActivate must remain present");
+assert.doesNotMatch(activation, /MHSNativeResetState\(\)/,
+  "normal picture activation must preserve an open Native AGI session");
