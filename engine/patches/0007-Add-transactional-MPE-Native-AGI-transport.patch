+static void MHSNativeResetState()
+{
+   MHSNativeOpen = false;
+   MHSNativeResultReady = false;
+   MHSNativeResultTransferred = false;
+   MHSNativeEngineEpoch = 0;
+   MHSNativeLastSequence = 0;
+   MHSNativePendingSequence = 0;
+   MHSNativePackageRaw = 0;
+   MHSNativePackageLength = 0;
+   MHSNativePackageBodyCRC = 0;
+   MHSNativePendingToken = 0;
+   memset(MHSNativeStateHash, 0, sizeof(MHSNativeStateHash));
+   memset(MHSNativeTickInput, 0, sizeof(MHSNativeTickInput));
+   memset(MHSNativeTickResult, 0, sizeof(MHSNativeTickResult));
+}
