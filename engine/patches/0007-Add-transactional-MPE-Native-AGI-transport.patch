 }
 
+// Native v1 intentionally accepts exactly one compiler-reserved, ordinary-RAM
+// exchange window.  Validate it before starting DMA so POST cannot read I/O or
+// ROM-shadowed addresses supplied by an untrusted C64 caller.
+static constexpr uint16_t MHSNativeStagingAddress = 0x5A80;
+static constexpr uint32_t MHSNativePackageFlagMask = 0x00000003u;
+static constexpr uint8_t MHSNativeInputFlagMask = 0x3F;
+
+FLASHMEM static uint16_t MHSNativeRead16(const uint8_t *Data)
+{
+   return (uint16_t)Data[0] | ((uint16_t)Data[1] << 8);
+}
+
+FLASHMEM static uint32_t MHSNativeRead32(const uint8_t *Data)
+{
+   return (uint32_t)Data[0] | ((uint32_t)Data[1] << 8) |
+      ((uint32_t)Data[2] << 16) | ((uint32_t)Data[3] << 24);
+}
+
+FLASHMEM static void MHSNativeWrite32(uint8_t *Data, uint32_t Value)
+{
+   Data[0] = (uint8_t)Value;
+   Data[1] = (uint8_t)(Value >> 8);
+   Data[2] = (uint8_t)(Value >> 16);
+   Data[3] = (uint8_t)(Value >> 24);
+}
+
+FLASHMEM static uint32_t MHSNativeCRC32Byte(uint32_t CRC, uint8_t Byte)
+{
+   CRC ^= Byte;
+   for (uint8_t Bit = 0; Bit < 8; Bit++)
+      CRC = (CRC >> 1) ^ ((CRC & 1) ? 0xEDB88320u : 0);
+   return CRC;
+}
+
+FLASHMEM static uint32_t MHSNativeCRC32(const uint8_t *Data, uint32_t Length)
+{
+   uint32_t CRC = 0xFFFFFFFFu;
+   for (uint32_t Index = 0; Index < Length; Index++)
+      CRC = MHSNativeCRC32Byte(CRC, Data[Index]);
+   return ~CRC;
+}
+
+FLASHMEM static bool MHSNativeZero(const uint8_t *Data, uint16_t Length)
+{
+   for (uint16_t Index = 0; Index < Length; Index++)
+      if (Data[Index]) return false;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeValidateCompatibility(const uint8_t *Data)
+{
+   if (memcmp(Data, "CMP1", 4) != 0 || Data[4] != 1 ||
+       (Data[5] != 2 && Data[5] != 3) || Data[6] != 1 || Data[7] != 3 ||
+       MHSNativeRead16(Data + 8) != 1 ||
+       MHSNativeRead16(Data + 10) != 1 ||
+       Data[18] < 1 || Data[18] > 20 ||
+       Data[19] < 1 || Data[19] > 8 ||
+       Data[20] < 1 || Data[20] > 20 ||
+       Data[21] < 1 || Data[21] > 25 ||
+       (MHSNativeRead32(Data + 22) & 0xFFFFFF00u) ||
+       Data[26] != 1 || Data[27] != 1 || !Data[28] ||
+       !MHSNativeZero(Data + 68, 8) ||
+       MHSNativeRead32(Data + 76) != MHSNativeCRC32(Data, 76)) return false;
+
+   bool Terminated = false;
+   for (uint8_t Index = 0; Index < 8; Index++)
+   {
+      uint8_t Character = Data[28 + Index];
+      if (!Character) Terminated = true;
+      else if (Terminated || Character < 0x20 || Character > 0x7E) return false;
+   }
+   return !MHSNativeZero(Data + 36, 32);
+}
+
+FLASHMEM static bool MHSNativeTagValid(const uint8_t Tag[4])
+{
+   for (uint8_t Index = 0; Index < 4; Index++)
+      if (!((Tag[Index] >= 'A' && Tag[Index] <= 'Z') ||
+            (Tag[Index] >= '0' && Tag[Index] <= '9') ||
+            Tag[Index] == '_')) return false;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeValidateDirectory(uint32_t Raw,
+                                                uint32_t TotalLength,
+                                                uint32_t DirectoryOffset,
+                                                uint16_t SectionCount,
+                                                uint32_t DataOffset,
+                                                uint8_t *Error)
+{
+   if (!SectionCount || SectionCount > 64) return false;
+   uint8_t Entry[MHSNativeDirectoryEntryBytes];
+   uint8_t PriorTag[4] = {0, 0, 0, 0};
+   uint32_t Cursor = DataOffset;
+   for (uint16_t Section = 0; Section < SectionCount; Section++)
+   {
+      if (!AGIPictureReadRawBytes(Raw + DirectoryOffset +
+                                  (uint32_t)Section * sizeof(Entry),
+                                  Entry, sizeof(Entry), Error)) return false;
+      uint32_t Offset = MHSNativeRead32(Entry + 4);
+      uint32_t Length = MHSNativeRead32(Entry + 8);
+      uint32_t ExpectedCRC = MHSNativeRead32(Entry + 12);
+      uint32_t Flags = MHSNativeRead32(Entry + 16);
+      uint16_t Alignment = MHSNativeRead16(Entry + 20);
+      if (!MHSNativeTagValid(Entry) ||
+          (Section && memcmp(PriorTag, Entry, 4) >= 0) || !Length ||
+          (Flags & ~7u) || !Alignment || Alignment > 4096 ||
+          (Alignment & (Alignment - 1u)) || MHSNativeRead16(Entry + 22))
+         return false;
+      uint32_t Aligned = (Cursor + Alignment - 1u) & ~(uint32_t)(Alignment - 1u);
+      if (Aligned < Cursor || Offset != Aligned || Offset > TotalLength ||
+          Length > TotalLength - Offset) return false;
+      for (uint32_t Padding = Cursor; Padding < Offset; Padding++)
+      {
+         uint8_t Byte;
+         if (!AGIPictureReadRaw(Raw + Padding, &Byte, Error) || Byte) return false;
+      }
+      uint32_t CRC = 0xFFFFFFFFu;
+      for (uint32_t Index = 0; Index < Length; Index++)
+      {
+         uint8_t Byte;
+         if (!AGIPictureReadRaw(Raw + Offset + Index, &Byte, Error)) return false;
+         CRC = MHSNativeCRC32Byte(CRC, Byte);
+      }
+      if (~CRC != ExpectedCRC) return false;
+      memcpy(PriorTag, Entry, sizeof(PriorTag));
+      Cursor = Offset + Length;
+   }
+   return Cursor == TotalLength;
+}
+
+FLASHMEM static bool MHSNativeOpenPackage(uint32_t Raw, uint8_t *Error)
+{
+   MHSNativeResetState();
+   if (!AGIPictureReadRawBytes(Raw, MHSNativePackageHeader,
+                               sizeof(MHSNativePackageHeader), Error))
+   {
+      AGIPictureReleaseSource();
+      *Error = AGIPicError_InvalidNativePackage;
+      return false;
+   }
+
+   const uint8_t *Header = MHSNativePackageHeader;
+   uint32_t TotalLength = MHSNativeRead32(Header + 8);
+   uint32_t CompatibilityOffset = MHSNativeRead32(Header + 12);
+   uint16_t CompatibilityLength = MHSNativeRead16(Header + 16);
+   uint16_t SectionCount = MHSNativeRead16(Header + 18);
+   uint32_t DirectoryOffset = MHSNativeRead32(Header + 20);
+   uint32_t DirectoryLength = MHSNativeRead32(Header + 24);
+   uint32_t DataOffset = MHSNativeRead32(Header + 28);
+   uint32_t Flags = MHSNativeRead32(Header + 32);
+   uint32_t BodyCRC = MHSNativeRead32(Header + 36);
+   uint32_t HeaderCRC = MHSNativeRead32(Header + 60);
+   bool HeaderValid = memcmp(Header, "MGA1", 4) == 0 &&
+      Header[4] == 1 && Header[5] == MHSPEServiceNativeAGI &&
+      Header[6] == MHSNativePackageHeaderBytes &&
+      Header[7] == MHSNativeDirectoryEntryBytes &&
+      TotalLength >= MHSNativePackageHeaderBytes + MHSNativeCompatibilityBytes &&
+      CompatibilityOffset == MHSNativePackageHeaderBytes &&
+      CompatibilityLength == MHSNativeCompatibilityBytes &&
+      SectionCount &&
+      DirectoryLength == (uint32_t)SectionCount * MHSNativeDirectoryEntryBytes &&
+      DirectoryOffset == CompatibilityOffset + CompatibilityLength &&
+      DirectoryOffset <= TotalLength && DirectoryLength <= TotalLength - DirectoryOffset &&
+      DataOffset == DirectoryOffset + DirectoryLength && DataOffset <= TotalLength &&
+      !(Flags & ~MHSNativePackageFlagMask) && MHSNativeZero(Header + 40, 20) &&
+      HeaderCRC == MHSNativeCRC32(Header, 60) &&
+      AGIPictureRawSpanValid(Raw, TotalLength);
+   if (!HeaderValid ||
+       !AGIPictureReadRawBytes(Raw + CompatibilityOffset,
+                               MHSNativeCompatibility,
+                               sizeof(MHSNativeCompatibility), Error) ||
+       !MHSNativeValidateCompatibility(MHSNativeCompatibility) ||
+       !MHSNativeValidateDirectory(Raw, TotalLength, DirectoryOffset,
+                                   SectionCount, DataOffset, Error))
+   {
+      AGIPictureReleaseSource();
+      *Error = AGIPicError_InvalidNativePackage;
+      return false;
+   }
+
+   // OPEN is the one place where the complete immutable package is checked.
+   // This is intentionally cartridge/SD work, never work performed while
+   // /DMA owns the C64 bus. Later ticks can therefore trust the retained image
+   // identity without re-reading mutable source data during a transaction.
+   uint32_t CRC = 0xFFFFFFFFu;
+   for (uint32_t Offset = MHSNativePackageHeaderBytes; Offset < TotalLength;
+        Offset++)
+   {
+      uint8_t Byte;
+      if (!AGIPictureReadRaw(Raw + Offset, &Byte, Error))
+      {
+         AGIPictureReleaseSource();
+         *Error = AGIPicError_InvalidNativePackage;
+         return false;
+      }
+      CRC = MHSNativeCRC32Byte(CRC, Byte);
+   }
+   AGIPictureReleaseSource();
+   if (~CRC != BodyCRC)
+   {
+      *Error = AGIPicError_InvalidNativePackage;
+      return false;
+   }
+
+   if (MHSNativeEpochCounter == 0xFFFFu)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   MHSNativeEpochCounter++;
+   MHSNativeEngineEpoch = MHSNativeEpochCounter;
+   MHSNativePackageRaw = Raw;
+   MHSNativePackageLength = TotalLength;
+   MHSNativePackageBodyCRC = BodyCRC;
+   MHSNativeOpen = true;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeValidateTick(uint16_t Address, uint16_t Length,
+                                           uint8_t Token, uint8_t *Error)
+{
+   if (!MHSNativeOpen || Length != MHSNativeTickBytes ||
+       Address != MHSNativeStagingAddress ||
+       DMA_State != DMA_S_DisableReady)
+   {
+      *Error = AGIPicError_InvalidNativeTick;
+      return false;
+   }
+   bool Transferred = PerformDMA(true, Address, MHSNativeTickInput,
+                                 MHSNativeTickBytes, false);
+   bool Closed = CloseDMA();
+   if (!Transferred || !Closed || DMA_State != DMA_S_DisableReady)
+   {
+      if (DMA_State != DMA_S_DisableReady) CloseDMA();
+      *Error = AGIPicError_DMATimeout;
+      return false;
+   }
+
+   const uint8_t *Input = MHSNativeTickInput;
+   uint32_t Sequence = MHSNativeRead32(Input + 8);
+   uint32_t Epoch = MHSNativeRead32(Input + 12);
+   uint8_t PayloadLength = Input[33];
+   uint16_t EventCount = MHSNativeRead16(Input + 36);
+   bool PacketValid = memcmp(Input, "MTI1", 4) == 0 && Input[4] == 1 &&
+      Input[5] == MHSPEServiceNativeAGI &&
+      Input[6] == AGIPicCmd_MPENativePost &&
+      !(Input[7] & ~MHSNativeInputFlagMask) &&
+      Sequence && Sequence == MHSNativeLastSequence + 1u &&
+      Epoch == MHSNativeEngineEpoch &&
+      memcmp(Input + 16, MHSNativeStateHash, sizeof(MHSNativeStateHash)) == 0 &&
+      Input[32] == Token && PayloadLength <= MHSNativeMaximumTickPayload &&
+      !MHSNativeRead16(Input + 38) &&
+      MHSNativeZero(Input + 40 + PayloadLength,
+                    MHSNativeMaximumTickPayload - PayloadLength) &&
+      MHSNativeRead32(Input + 60) == MHSNativeCRC32(Input, 60);
+   if (!PacketValid)
+   {
+      *Error = Sequence != MHSNativeLastSequence + 1u ||
+         Epoch != MHSNativeEngineEpoch ? AGIPicError_StaleNativeTick :
+         AGIPicError_InvalidNativeTick;
+      return false;
+   }
+
+   // The first firmware milestone qualifies retained sequencing and staged
+   // transport only. It rejects every event-bearing tick rather than silently
+   // ignoring game input. A later engine patch will consume these fields and
+   // change the state hash before this exact transactional publication step.
+   if (Input[7] || PayloadLength || EventCount)
+   {
+      *Error = AGIPicError_InvalidNativeTick;
+      return false;
+   }
+
+   memset(MHSNativeTickResult, 0, sizeof(MHSNativeTickResult));
+   memcpy(MHSNativeTickResult, "MTR1", 4);
+   MHSNativeTickResult[4] = 1;
+   MHSNativeTickResult[5] = MHSPEServiceNativeAGI;
+   MHSNativeTickResult[6] = 2; // successful no-op transport milestone
+   MHSNativeWrite32(MHSNativeTickResult + 8, Sequence);
+   MHSNativeWrite32(MHSNativeTickResult + 12, Epoch);
+   memcpy(MHSNativeTickResult + 16, MHSNativeStateHash,
+          sizeof(MHSNativeStateHash));
+   MHSNativeTickResult[32] = Token;
+   MHSNativeWrite32(MHSNativeTickResult + 60,
+                    MHSNativeCRC32(MHSNativeTickResult, 60));
+   MHSNativePendingSequence = Sequence;
+   MHSNativePendingToken = Token;
+   MHSNativeResultReady = true;
+   MHSNativeResultTransferred = false;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeCommitResult(uint16_t Address,
+                                           uint16_t Capacity,
+                                           uint8_t Token, uint8_t *Error)
+{
+   if (!MHSNativeOpen || !MHSNativeResultReady ||
+       MHSNativeResultTransferred || Token != MHSNativePendingToken)
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   if (Capacity != MHSNativeTickBytes ||
+       Address != MHSNativeStagingAddress ||
+       DMA_State != DMA_S_DisableReady)
+   {
+      *Error = AGIPicError_InvalidNativeTick;
+      return false;
+   }
+   bool Transferred = PerformDMA(false, Address, MHSNativeTickResult,
+                                 MHSNativeTickBytes, false);
+   bool Closed = CloseDMA();
+   if (!Transferred || !Closed || DMA_State != DMA_S_DisableReady)
+   {
+      if (DMA_State != DMA_S_DisableReady) CloseDMA();
+      *Error = AGIPicError_DMATimeout;
+      return false;
+   }
+   MHSNativeResultTransferred = true;
+   return true;
+}
+
+FLASHMEM static bool MHSNativeAcknowledge(uint8_t Flags, uint8_t Token,
+                                          bool *Accepted, uint8_t *Error)
+{
+   if (Flags & ~MHSNativeAckAccept || !MHSNativeResultReady ||
+       Token != MHSNativePendingToken ||
+       ((Flags & MHSNativeAckAccept) && !MHSNativeResultTransferred))
+   {
+      *Error = AGIPicError_NativeResultState;
+      return false;
+   }
+   *Accepted = (Flags & MHSNativeAckAccept) != 0;
+   if (*Accepted)
+   {
+      MHSNativeLastSequence = MHSNativePendingSequence;
+      memcpy(MHSNativeStateHash, MHSNativeTickResult + 16,
+             sizeof(MHSNativeStateHash));
+   }
+   MHSNativePendingSequence = 0;
+   MHSNativePendingToken = 0;
+   MHSNativeResultReady = false;
+   MHSNativeResultTransferred = false;
+   memset(MHSNativeTickInput, 0, sizeof(MHSNativeTickInput));
+   memset(MHSNativeTickResult, 0, sizeof(MHSNativeTickResult));
+   return true;
+}
+
+FLASHMEM static uint8_t MHSNativeState()
+{
+   return (MHSNativeOpen ? MHSNativeStateOpen : 0) |
+      (MHSNativeResultReady ? MHSNativeStateResultReady : 0) |
+      (MHSNativeResultTransferred ? MHSNativeStateTransferred : 0);
+}
+
 static bool AGIPictureReadRaw16(uint32_t Raw, uint16_t *Value,
                                  uint8_t *Error)
 {
@@ -3798,6 +4230,7 @@ static void AGIPictureResetSession()
    AGIPictureReleasePicture();
    AGIPictureReleaseScene();
    AGIPictureInvalidateLivePicture();
+   MHSNativeResetState();
    memset((void *)AGIPicRegisters, 0, sizeof(AGIPicRegisters));
    AGIPicUnlockStage = 0;
    AGIPicChallengeSeen = false;
@@ -3814,6 +4247,8 @@ static void AGIPictureResetSession()
 
 static void AGIPictureActivate(uint8_t Protocol, uint8_t Layout)
 {
+   // A normal helper activation occurs for every picture.  Preserve an open
+   // Native AGI session here; OPEN, reset, and emergency abort own its reset.
    MHSPEScanValidated = false;
    MHSPEActive = false;
    AGIPicLivePictureValid = false;
@@ -3960,8 +4395,10 @@ static void AGIPictureCommandWrite(uint8_t Command)
       Command == AGIPicCmd_V3PatchDMA || Command == AGIPicCmd_V3PrefetchScene ||
       Command == AGIPicCmd_V3RoomSeed || Command == AGIPicCmd_V3ActorFrame;
    bool MPE = Command == AGIPicCmd_MPEQuery ||
-      Command == AGIPicCmd_MPEPowerVM || Command == AGIPicCmd_MPEAGIScan ||
-      Command == AGIPicCmd_MPEPriorityLine;
+       Command == AGIPicCmd_MPEPowerVM || Command == AGIPicCmd_MPEAGIScan ||
+       Command == AGIPicCmd_MPEPriorityLine ||
+       (Command >= AGIPicCmd_MPENativeOpen &&
