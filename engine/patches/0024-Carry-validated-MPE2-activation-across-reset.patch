diff --git a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c
--- a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c
+++ b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_AGIPicture.c
@@ -6241,5 +6241,37 @@ FLASHMEM void AGIPicturePollingHndlr()
 {
-   if (AGIPicResetPending) { AGIPictureResetSession(); return; }
+   if (AGIPicResetPending)
+   {
+      // $7f cancels any identity that preceded it. Therefore this combination
+      // can only be the exact MPE+2 identity accepted after the reset write.
+      // Wait for its final $50 boundary so DFFE/$50 cannot arrive during the
+      // reset-heavy session teardown, then carry only those validated fields
+      // into an ordinary fresh activation. Partial identities, bad timing,
+      // wrong commands, and unexpected IO2 accesses still cancel fail-closed.
+      if (MPEThinUpgradePending && !MPEThinFreshActivationPending)
+      {
+         if (!MPEThinQueuedKick) return;
+         uint8_t Layout = MPEThinUpgradeLayout;
+         bool QueuedMachineFlagsValid = MPEThinQueuedMachineFlagsValid;
+         uint8_t QueuedMachineFlags = MPEThinQueuedMachineFlags;
+
+         AGIPictureResetSession();
+
+         // AGIPictureResetSession deliberately clears every unlock and MPE2
+         // latch. Restore no parser stage or challenge state: only the exact
+         // completed identity, validated timing, and legal one-way kick cross
+         // this ordered reset boundary.
+         MPEThinUpgradeLayout = Layout;
+         MPEThinQueuedKick = true;
+         MPEThinQueuedMachineFlagsValid = QueuedMachineFlagsValid;
+         MPEThinQueuedMachineFlags = QueuedMachineFlagsValid ?
+            QueuedMachineFlags : 0;
+         MPEThinFreshActivationPending = true;
+         MPEThinUpgradePending = true;
+         return;
+      }
+      AGIPictureResetSession();
+      return;
+   }
    if (AGIPicAbortRequested)
    {
       AGIPictureAbort();
