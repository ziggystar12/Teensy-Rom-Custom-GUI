+++ b/Source/Teensy/MinimalBoot/tests/mpe-thin-deferred-upgrade-conformance.mjs
@@ -32,5 +32,9 @@ const poller = section("FLASHMEM void AGIPicturePollingHndlr", "if (Command
 assert.match(poller, /MPEThinUpgradePending[^]*?DMA_State != DMA_S_DisableReady[^]*?return[^]*?!MPEThinQueuedKick[^]*?return[^]*?MPEThinClientActivate\(Layout\)[^]*?QueuedMachineFlagsValid[^]*?QueuedVBlank[^]*?QueuedKick[^]*?AGIPicPendingCommand = AGIPicCmd_MPEThinKick/,
   "poller activates after quiescence and the final kick, then restores timing and services that kick");
+assert.match(poller, /AGIPicResetPending[^]*?MPEThinUpgradePending && !MPEThinFreshActivationPending[^]*?!MPEThinQueuedKick[^]*?return[^]*?AGIPictureResetSession\(\)[^]*?MPEThinUpgradeLayout = Layout[^]*?MPEThinQueuedKick = true[^]*?MPEThinFreshActivationPending = true[^]*?MPEThinUpgradePending = true/,
+  "a complete post-reset identity, timing, and kick must become one fresh activation");
+assert.doesNotMatch(poller, /MPEThinUpgradeStage =|AGIPicChallengeSeen = true/,
+  "partial unlock state must never cross reset");
 
