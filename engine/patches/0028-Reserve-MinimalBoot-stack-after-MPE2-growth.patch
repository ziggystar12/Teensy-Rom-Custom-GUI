+++ b/Source/Teensy/MinimalBoot/tests/mpe-thin-client-conformance.mjs
@@ -26,7 +26,10 @@ assert.match(activation,
   /PreserveRoom = !MPEThinClientActive && AGIPicActive[^]*?AGIPicRoomValid[^]*?AGIPictureActivate\(AGIPicProtocolV3, Layout, PreserveRoom\)[^]*?MPEThinReset\(\)/,
   "legacy upgrade may preserve a seed, but warm MPE2 reactivation must reset retained authority");
