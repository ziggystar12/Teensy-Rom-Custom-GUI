diff --git a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
--- a/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
+++ b/Source/Teensy/MinimalBoot/Common/IO_Handlers/IOH_MPEVirtualAGI.c
@@ -1473,15 +1473,18 @@ static bool MPEVirtualAGINextDirtyRun(bool TextMode, uint16_t *Cursor,
       *Cursor = Cell;
       return false;
    }
    uint16_t RowEnd = (uint16_t)(((Cell / 40u) + 1u) * 40u);
-   uint16_t End = Cell + 1u;
-   while (End < RowEnd &&
-          (TextMode ? MPEVirtualTextCellTouched(End) :
-                      MPEVirtualBitmapCellTouched(End)))
-      End++;
+   // Publish one span per affected row. The DMA helpers source every cell
+   // from the VM's final view, so unchanged gaps cannot retain stale C64
+   // bytes between changed cells.
+   uint16_t End = RowEnd;
+   while (End > Cell + 1u &&
+          !(TextMode ? MPEVirtualTextCellTouched(End - 1u) :
+                       MPEVirtualBitmapCellTouched(End - 1u)))
+      End--;
    Run->FirstCell = Cell;
    Run->CellCount = (uint8_t)(End - Cell);
-   *Cursor = End;
+   *Cursor = RowEnd;
    return true;
 }
 
