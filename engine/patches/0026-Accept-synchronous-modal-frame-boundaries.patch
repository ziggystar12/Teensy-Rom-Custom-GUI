@@ -52,5 +52,6 @@ static constexpr uint8_t MPEVirtualKeyQueueBytes = 64;
 static constexpr uint32_t MPEVirtualBootCycleBudget = 12000000u;
 static constexpr uint32_t MPEVirtualFrameCycleBudget = 4000000u;
+static constexpr uint16_t MPEVirtualModalFrameService = 0x7FE5;
 
 enum MPEVirtualFullFrameReason : uint8_t
 {
@@ -1120,6 +1121,7 @@ static bool MPEVirtualAGIRunToFrameBoundary(bool Initial)
    const uint16_t StartPC = vrEmu6502GetPC(MPEVirtualState.CPU);
    bool LeftFrameLoop = StartPC != FrameLoop;
    bool SawStableService = false;
+   bool SawModalFrameService = false;
    uint32_t ServiceVideoGeneration = 0;
    while (MPEVirtualState.Cycles - StartCycles < Budget)
