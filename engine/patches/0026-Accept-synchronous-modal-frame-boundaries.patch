@@ -1147,6 +1149,20 @@ static bool MPEVirtualAGIRunToFrameBoundary(bool Initial)
          ServiceVideoGeneration = MPEVirtualState.VideoWriteGeneration;
       }
 
+      // The bank-61 synchronous print policy does not call FrameService. Once
+      // per modal frame it tail-jumps to the fixed low-RAM $7fe5 wrapper after
+      // the raster wait and mouse update; that wrapper advances sound and
+      // restores bank 61. Observe two entries so every request executes one
+      // complete modal frame even when it resumes at $7fe5. Unlike the generic
+      // stable-service detector, video writes between entries are allowed:
+      // moving the modal mouse is itself a coherent per-frame update.
+      if (!Initial && PC == MPEVirtualModalFrameService &&
+          (MPEVirtualVIC[0x11] & 0x10))
+      {
+         if (SawModalFrameService) return true;
+         SawModalFrameService = true;
+      }
