diff --git a/Source/Teensy/MinimalBoot/MPEVirtual6502Bridge.c b/Source/Teensy/MinimalBoot/MPEVirtual6502Bridge.c
new file mode 100644
index 00000000..854a071b
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/MPEVirtual6502Bridge.c
@@ -0,0 +1,83 @@
+// C-only bridge around the byte-exact upstream vrEmu6502 source.  Arduino
+// builds sketch-root .c files as C, while the AGI I/O handler is C++.
+#define VR_EMU_6502_STATIC
+#include "Common/ThirdParty/vrEmu6502/vrEmu6502.c"
+#include "MPEVirtual6502Bridge.h"
+
+VrEmu6502 *MPEVrEmu6502New6510(vrEmu6502MemRead Read,
+                                vrEmu6502MemWrite Write)
+{
+   if (!Read || !Write) return NULL;
+   VrEmu6502 *CPU = (VrEmu6502 *)malloc(sizeof(VrEmu6502));
+   if (!CPU) return NULL;
+   // MPE2 only virtualizes the C64's undocumented-opcode 6510. Bypassing the
+   // multi-model constructor lets section garbage collection discard four
+   // unused 3 KiB opcode tables and their CMOS-only handlers from scarce
+   // Teensy DTCM, while the executed table remains byte-exact upstream code.
+   CPU->model = CPU_6502;
+   CPU->readFn = Read;
+   CPU->writeFn = Write;
+   CPU->intPin = IntCleared;
+   CPU->nmiPin = IntCleared;
+   CPU->step = 0;
+   CPU->currentOpcode = 0;
+   CPU->currentOpcodeAddr = 0;
+   CPU->wai = false;
+   CPU->stp = false;
+   CPU->pc = 0;
+   CPU->ac = 0;
+   CPU->ix = 0;
+   CPU->iy = 0;
+   CPU->sp = 0xFD;
+   CPU->flags = 0x34;
+   CPU->zpBase = 0;
+   CPU->spBase = 0x100;
+   CPU->tmpAddr = 0;
+   CPU->opcodes = _std6502U;
+   return CPU;
+}
+
+void MPEVrEmu6502Initialize(VrEmu6502 *CPU, uint16_t PC)
+{
+   CPU->ac = 0;
+   CPU->ix = 0;
+   CPU->iy = 0;
+   CPU->sp = 0xFD;
+   CPU->flags = 0x34;
+   CPU->step = 0;
+   CPU->wai = false;
+   CPU->stp = false;
+   CPU->pc = PC;
+}
+
+uint8_t MPEVrEmu6502GetFlags(VrEmu6502 *CPU)
+{
+   return CPU->flags;
+}
+
+void MPEVrEmu6502SetFlags(VrEmu6502 *CPU, uint8_t Flags)
+{
+   CPU->flags = Flags;
+}
+
+void MPEVrEmu6502SetAccumulator(VrEmu6502 *CPU, uint8_t Value)
+{
+   CPU->ac = Value;
+}
+
+void MPEVrEmu6502SetX(VrEmu6502 *CPU, uint8_t Value)
+{
+   CPU->ix = Value;
+}
+
+void MPEVrEmu6502SetY(VrEmu6502 *CPU, uint8_t Value)
+{
+   CPU->iy = Value;
+}
+
+void MPEVrEmu6502KernalRTS(VrEmu6502 *CPU, uint8_t *RAM)
+{
+   uint8_t Lo = RAM[0x0100u | ++CPU->sp];
+   uint8_t Hi = RAM[0x0100u | ++CPU->sp];
+   CPU->pc = (uint16_t)((Lo | ((uint16_t)Hi << 8)) + 1u);
+}
