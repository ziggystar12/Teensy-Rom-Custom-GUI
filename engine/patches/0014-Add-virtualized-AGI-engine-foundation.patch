+// MPE2 virtual C64/AGI execution foundation.
+//
+// This module is included by IOH_AGIPicture.c after the canonical cartridge
+// reader and CRC helpers are defined.  It deliberately owns no physical C64
+// bus protocol: MPE2's stop-and-wait mailbox remains the sole authority
+// boundary.  A VAG1 boot descriptor is accepted only after the complete R65B
+// section and stripped PRG image have both passed independent CRC-32 checks.
+
+#include "../../MPEVirtual6502Bridge.h"
+
+static constexpr uint8_t MPEVirtualBootDescriptorBytes = 40;
+static constexpr uint8_t MPEVirtualRuntimeHeaderBytes = 64;
+static constexpr uint8_t MPEVirtualBootDirectTitle = 0x01;
+static constexpr uint8_t MPEVirtualRuntimeVersion = 1;
+static constexpr uint8_t MPEVirtualRuntimeCPU6510 = 1;
+static constexpr uint8_t MPEVirtualRuntimeLinkedImage = 0x01;
+static constexpr uint8_t MPEVirtualEasyFlashBanks = 64;
+static constexpr uint32_t MPEVirtualEasyFlashBankBytes = 0x4000u;
+static constexpr uint16_t MPEVirtualTextScreenBase = 0x0400;
+static constexpr uint16_t MPEVirtualTerminalTextBase = 0x0800;
+static constexpr uint16_t MPEVirtualBitmapScreenBase = 0x5C00;
+static constexpr uint16_t MPEVirtualBitmapBase = 0x6000;
+static constexpr uint16_t MPEVirtualColourBase = 0xD800;
+static constexpr uint16_t MPEVirtualDisplayCells = 1000;
+static constexpr uint16_t MPEVirtualBitmapBytes = 8000;
+static constexpr uint16_t MPEVirtualParserScreenBase = 0x47C0;
+static constexpr uint16_t MPEVirtualParserFontBase = 0x5000;
+static constexpr uint16_t MPEVirtualParserSplitRequested = 0x5B15;
+static constexpr uint16_t MPEVirtualParserFirstCell = 960;
+static constexpr uint8_t MPEVirtualParserCells = 40;
+static constexpr uint16_t MPEVirtualCharacterROMStageBase = 0x0C00;
+static constexpr uint16_t MPEVirtualCharacterROMBytes = 512;
+static constexpr uint8_t MPEVirtualDirtyBytes =
+   (MPEVirtualDisplayCells + 7u) / 8u;
+static constexpr uint8_t MPEVirtualVICBytes = 0x40;
+static constexpr uint8_t MPEVirtualSIDBytes = 0x20;
+static constexpr uint8_t MPEVirtualVICDirtyBytes =
+   (MPEVirtualVICBytes + 7u) / 8u;
+static constexpr uint8_t MPEVirtualSIDDirtyBytes =
+   (MPEVirtualSIDBytes + 7u) / 8u;
+static constexpr uint16_t MPEVirtualSpritePairBase = 0x5840;
+static constexpr uint16_t MPEVirtualSpriteSecondBase = 0x58C0;
+static constexpr uint16_t MPEVirtualSpritePointerBase = 0x5FFA;
+static constexpr uint8_t MPEVirtualSpritePairBytes = 128;
+static constexpr uint8_t MPEVirtualSpriteBytes = 64;
+static constexpr uint16_t MPEVirtualNTSCScanlines = 263;
+static constexpr uint16_t MPEVirtualNTSCCyclesPerLine = 65;
+static constexpr uint32_t MPEVirtualNTSC50msCycles = 51136u;
+static constexpr uint8_t MPEVirtualKeyQueueBytes = 64;
+static constexpr uint32_t MPEVirtualBootCycleBudget = 12000000u;
+static constexpr uint32_t MPEVirtualFrameCycleBudget = 3000000u;
+
+enum MPEVirtualFullFrameReason : uint8_t
+{
+   MPEVirtualFullFrameNone = 0,
+   MPEVirtualFullFrameInitial = 1,
+   MPEVirtualFullFrameRoomTransition = 2,
+   MPEVirtualFullFrameModeChange = 3,
+   MPEVirtualFullFrameForcedResync = 4,
+};
+
+struct MPEVirtualDirtyRun
+{
+   uint16_t FirstCell;
+   uint8_t CellCount;
+};
+
+struct MPEVirtualAGIState
+{
+   VrEmu6502 *CPU;
+   uint32_t CartridgeRawRoot;
+   uint32_t CartridgeRawBytes;
+   uint32_t RuntimeRaw;
+   uint32_t RuntimeBytes;
+   uint32_t RuntimeCRC32;
+   uint32_t Cycles;
+   uint32_t PresentationGeneration;
+   uint32_t VideoWriteGeneration;
+   uint32_t RasterCycles;
+   uint32_t Timer50msCycles;
+   uint16_t LoadAddress;
+   uint16_t ImageBytes;
+   uint16_t EntryPC;
+   uint16_t RasterLine;
+   uint16_t CIA1TimerA;
+   uint16_t CIA2TimerB;
+   uint8_t EasyFlashBank;
+   uint8_t EasyFlashControl;
+   uint8_t ProcessorPort;
+   uint8_t CIA2TimerBControl;
+   uint8_t KeyRead;
+   uint8_t KeyWrite;
+   uint8_t PresentedRoom;
+   bool PresentedTextMode;
+   bool PresentedParserSplit;
+   bool Active;
+   bool Faulted;
+   bool PresentedValid;
+   bool SpritePairTouched;
+};
+
+// Built-in Teensy RAM2 owns the virtual C64 image and presentation shadows.
+// They never alias physical C64 RAM, and VAG1 must work on stock boards that
+// have no optional PSRAM chips fitted.
+static DMAMEM uint8_t MPEVirtualRAM[0x10000];
+static DMAMEM uint8_t MPEVirtualPresentedBitmap[MPEVirtualBitmapBytes];
+static DMAMEM uint8_t MPEVirtualPresentedText[MPEVirtualDisplayCells];
+static DMAMEM uint8_t MPEVirtualPresentedScreen[MPEVirtualDisplayCells];
+static DMAMEM uint8_t MPEVirtualPresentedColour[MPEVirtualDisplayCells];
+static uint8_t MPEVirtualParserUnderlyingColour[MPEVirtualParserCells];
+static uint8_t MPEVirtualRuntimeHeader[MPEVirtualRuntimeHeaderBytes];
+static uint8_t MPEVirtualColour[MPEVirtualDisplayCells];
+static uint8_t MPEVirtualVIC[MPEVirtualVICBytes];
+static uint8_t MPEVirtualSID[MPEVirtualSIDBytes];
+static uint8_t MPEVirtualTextDirty[MPEVirtualDirtyBytes];
+static uint8_t MPEVirtualBitmapDirty[MPEVirtualDirtyBytes];
+static uint8_t MPEVirtualScreenDirty[MPEVirtualDirtyBytes];
+static uint8_t MPEVirtualColourDirty[MPEVirtualDirtyBytes];
+static uint8_t MPEVirtualVICDirty[MPEVirtualVICDirtyBytes];
+static uint8_t MPEVirtualSIDDirty[MPEVirtualSIDDirtyBytes];
+static uint8_t MPEVirtualPresentedVIC[MPEVirtualVICBytes];
+static uint8_t MPEVirtualPresentedSID[MPEVirtualSIDBytes];
+static uint8_t MPEVirtualPresentedSpritePair[MPEVirtualSpritePairBytes];
+static uint8_t MPEVirtualSpritePair[MPEVirtualSpritePairBytes];
+static uint8_t MPEVirtualPresentedSpritePointers[2];
+static DMAMEM uint8_t MPEVirtualCharacterROM[MPEVirtualCharacterROMBytes];
+static uint8_t MPEVirtualKeyQueue[MPEVirtualKeyQueueBytes];
+static MPEVirtualAGIState MPEVirtualState = {};
+
+static uint16_t MPEVirtualRead16(const uint8_t *Data)
+{
+   return Data[0] | ((uint16_t)Data[1] << 8);
+}
+
+static uint32_t MPEVirtualRead24(const uint8_t *Data)
+{
+   return (uint32_t)Data[0] | ((uint32_t)Data[1] << 8) |
+      ((uint32_t)Data[2] << 16);
+}
+
+static uint32_t MPEVirtualRead32(const uint8_t *Data)
+{
+   return (uint32_t)Data[0] | ((uint32_t)Data[1] << 8) |
+      ((uint32_t)Data[2] << 16) | ((uint32_t)Data[3] << 24);
+}
+
+static bool MPEVirtualBytesZero(const uint8_t *Data, uint8_t First,
+                                uint8_t End)
+{
+   for (uint8_t Index = First; Index < End; Index++)
+      if (Data[Index]) return false;
+   return true;
+}
+
+static void MPEVirtualSetDirty(uint8_t *Bits, uint16_t Index)
+{
+   Bits[Index >> 3] |= (uint8_t)(1u << (Index & 7));
+}
+
+static bool MPEVirtualIOVisible()
+{
+   // Inputs on the 6510 processor port float high.  CHAREN must be high and
+   // at least one of LORAM/HIRAM must be high for $D000-$DFFF I/O visibility.
+   uint8_t DDR = MPEVirtualRAM[0];
+   uint8_t Port = (MPEVirtualRAM[1] & DDR) | (uint8_t)~DDR;
+   return (Port & 0x04) && (Port & 0x03);
+}
+
+static uint8_t MPEVirtualProcessorPort()
+{
+   uint8_t DDR = MPEVirtualRAM[0];
+   return (MPEVirtualRAM[1] & DDR) | (uint8_t)~DDR;
+}
+
+static bool MPEVirtualCharacterROMVisible()
+{
+   uint8_t Port = MPEVirtualProcessorPort();
+   return !(Port & 0x04) && (Port & 0x03);
+}
+
+static bool MPEVirtualLowCartridgeVisible()
+{
+   return MPEVirtualState.EasyFlashControl == 0x87;
+}
+
+static bool MPEVirtualHighCartridgeVisible()
+{
+   // EasyFlash ROMH follows HIRAM.  The resident compositor deliberately
+   // selects $01=$35 to execute and mutate RAM beneath $A000-$BFFF.
+   return MPEVirtualLowCartridgeVisible() &&
+      (MPEVirtualProcessorPort() & 0x02);
+}
+
+static bool MPEVirtualCartridgeRead(uint16_t Address, uint8_t *Value)
+{
+   uint32_t Offset = (uint32_t)MPEVirtualState.EasyFlashBank *
+      MPEVirtualEasyFlashBankBytes + (uint32_t)(Address - 0x8000u);
+   if (Offset >= MPEVirtualState.CartridgeRawBytes)
+   {
+      MPEVirtualState.Faulted = true;
+      *Value = 0xFF;
+      return false;
+   }
+   uint32_t Raw = MPEVirtualState.CartridgeRawRoot + Offset;
+   uint8_t Error = AGIPicError_None;
+   if (Raw < MPEVirtualState.CartridgeRawRoot ||
+       !AGIPictureReadRaw(Raw, Value, &Error))
+   {
+      MPEVirtualState.Faulted = true;
+      *Value = 0xFF;
+      return false;
+   }
+   return true;
+}
+
+static uint8_t MPEVirtualMemoryRead(uint16_t Address, bool DebugRead)
+{
+   (void)DebugRead;
+   if ((Address >= 0x8000 && Address <= 0x9FFF &&
+        MPEVirtualLowCartridgeVisible()) ||
+       (Address >= 0xA000 && Address <= 0xBFFF &&
+        MPEVirtualHighCartridgeVisible()))
+   {
+      uint8_t Value = 0xFF;
+      (void)MPEVirtualCartridgeRead(Address, &Value);
+      return Value;
+   }
+   if (Address >= 0xD000 && Address <= 0xDFFF && MPEVirtualIOVisible())
+   {
+      if (Address < 0xD000 + MPEVirtualVICBytes)
+      {
+         uint8_t Index = Address - 0xD000;
+         if (Index == 0x11)
+            return (MPEVirtualVIC[Index] & 0x7F) |
+               (MPEVirtualState.RasterLine & 0x100 ? 0x80 : 0);
+         if (Index == 0x12)
+            return (uint8_t)MPEVirtualState.RasterLine;
+         return MPEVirtualVIC[Index];
+      }
+      if (Address >= 0xD400 && Address < 0xD400 + MPEVirtualSIDBytes)
+         return MPEVirtualSID[Address - 0xD400];
+      if (Address >= MPEVirtualColourBase &&
+          Address < MPEVirtualColourBase + MPEVirtualDisplayCells)
+         return MPEVirtualColour[Address - MPEVirtualColourBase];
+      if (Address == 0xDE00) return MPEVirtualState.EasyFlashBank;
+      if (Address == 0xDE02) return MPEVirtualState.EasyFlashControl;
+      if (Address == 0xDC04) return (uint8_t)MPEVirtualState.CIA1TimerA;
+      if (Address == 0xDC05) return (uint8_t)(MPEVirtualState.CIA1TimerA >> 8);
+      if (Address == 0xDD06) return (uint8_t)MPEVirtualState.CIA2TimerB;
+      if (Address == 0xDD07) return (uint8_t)(MPEVirtualState.CIA2TimerB >> 8);
+      if (Address == 0xDD0F) return MPEVirtualState.CIA2TimerBControl;
+   }
+   if (Address >= 0xD000 && Address < 0xD000 + MPEVirtualCharacterROMBytes &&
+       MPEVirtualCharacterROMVisible())
+      return MPEVirtualCharacterROM[Address - 0xD000];
+   return MPEVirtualRAM[Address];
+}
+
+static void MPEVirtualMemoryWrite(uint16_t Address, uint8_t Value)
+{
+   if (Address >= 0xD000 && Address <= 0xDFFF && MPEVirtualIOVisible())
+   {
+      if (Address < 0xD000 + MPEVirtualVICBytes)
+      {
+         uint16_t Index = Address - 0xD000;
+         if (MPEVirtualVIC[Index] != Value)
+         {
+            MPEVirtualVIC[Index] = Value;
+            MPEVirtualSetDirty(MPEVirtualVICDirty, Index);
+            MPEVirtualState.VideoWriteGeneration++;
+         }
+         return;
+      }
+      if (Address >= 0xD400 && Address < 0xD400 + MPEVirtualSIDBytes)
+      {
+         uint16_t Index = Address - 0xD400;
+         if (MPEVirtualSID[Index] != Value)
+         {
+            MPEVirtualSID[Index] = Value;
+            MPEVirtualSetDirty(MPEVirtualSIDDirty, Index);
+         }
+         return;
+      }
+      if (Address >= MPEVirtualColourBase &&
+          Address < MPEVirtualColourBase + MPEVirtualDisplayCells)
+      {
+         uint16_t Index = Address - MPEVirtualColourBase;
+         Value &= 0x0F;
+         // The runtime's raster-split publisher temporarily owns row 24
+         // colour RAM. Retain the underlying bitmap colours while the split
+         // is active so hiding the terminal row restores the final scene.
+         if (Index >= MPEVirtualParserFirstCell &&
+             !MPEVirtualRAM[MPEVirtualParserSplitRequested])
+            MPEVirtualParserUnderlyingColour[
+               Index - MPEVirtualParserFirstCell] = Value;
+         if (MPEVirtualColour[Index] != Value)
+         {
+            MPEVirtualColour[Index] = Value;
+            MPEVirtualSetDirty(MPEVirtualColourDirty, Index);
+            MPEVirtualState.VideoWriteGeneration++;
+         }
+         return;
+      }
+      if (Address == 0xDE00)
+      {
+         MPEVirtualState.EasyFlashBank =
+            Value & (MPEVirtualEasyFlashBanks - 1);
+         return;
+      }
+      if (Address == 0xDE02)
+      {
+         MPEVirtualState.EasyFlashControl = Value;
+         return;
+      }
+      if (Address == 0xDC04)
+      {
+         MPEVirtualState.CIA1TimerA =
+            (MPEVirtualState.CIA1TimerA & 0xFF00) | Value;
+         MPEVirtualRAM[Address] = Value;
+         return;
+      }
+      if (Address == 0xDC05)
+      {
+         MPEVirtualState.CIA1TimerA =
+            (MPEVirtualState.CIA1TimerA & 0x00FF) | ((uint16_t)Value << 8);
+         MPEVirtualRAM[Address] = Value;
+         return;
+      }
+      if (Address == 0xDD06)
+      {
+         MPEVirtualState.CIA2TimerB =
+            (MPEVirtualState.CIA2TimerB & 0xFF00) | Value;
+         MPEVirtualRAM[Address] = Value;
+         return;
+      }
+      if (Address == 0xDD07)
+      {
+         MPEVirtualState.CIA2TimerB =
+            (MPEVirtualState.CIA2TimerB & 0x00FF) | ((uint16_t)Value << 8);
+         MPEVirtualRAM[Address] = Value;
+         return;
+      }
+      if (Address == 0xDD0F)
+      {
+         MPEVirtualState.CIA2TimerBControl = Value;
+         MPEVirtualRAM[Address] = Value;
+         return;
+      }
+      // CIA and other I/O devices are retained as deterministic shadows until
+      // their explicit MPE2 terminal traps consume or publish them.
+      MPEVirtualRAM[Address] = Value;
+      return;
+   }
+
+   // EasyFlash ROM is immutable.  The hidden RAM underneath it still exists
+   // in the private 64 KiB image and becomes visible if later mapping grows a
+   // RAM-under-ROM mode.
+   if (Address >= 0x8000 && Address <= 0xBFFF)
+   {
+      MPEVirtualRAM[Address] = Value;
+      return;
+   }
+
+   if (MPEVirtualRAM[Address] == Value) return;
+   MPEVirtualRAM[Address] = Value;
+   if (Address == MPEVirtualParserSplitRequested)
+   {
+      for (uint16_t Cell = MPEVirtualParserFirstCell;
+           Cell < MPEVirtualDisplayCells; Cell++)
+         MPEVirtualSetDirty(MPEVirtualBitmapDirty, Cell);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualParserScreenBase &&
+       Address < MPEVirtualParserScreenBase + MPEVirtualParserCells)
+   {
+      MPEVirtualSetDirty(MPEVirtualBitmapDirty,
+         MPEVirtualParserFirstCell + Address - MPEVirtualParserScreenBase);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualParserFontBase + 0x600 &&
+       Address < MPEVirtualParserFontBase + 0x800 &&
+       MPEVirtualRAM[MPEVirtualParserSplitRequested])
+   {
+      for (uint16_t Cell = MPEVirtualParserFirstCell;
+           Cell < MPEVirtualDisplayCells; Cell++)
+         MPEVirtualSetDirty(MPEVirtualBitmapDirty, Cell);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if ((Address >= MPEVirtualSpritePairBase &&
+        Address < MPEVirtualSpritePairBase + MPEVirtualSpriteBytes) ||
+       (Address >= MPEVirtualSpriteSecondBase &&
+        Address < MPEVirtualSpriteSecondBase + MPEVirtualSpriteBytes))
+   {
+      MPEVirtualState.SpritePairTouched = true;
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualSpritePointerBase &&
+       Address < MPEVirtualSpritePointerBase + 2)
+   {
+      MPEVirtualState.SpritePairTouched = true;
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualTextScreenBase &&
+       Address < MPEVirtualTextScreenBase + MPEVirtualDisplayCells)
+   {
+      MPEVirtualSetDirty(MPEVirtualTextDirty,
+                         Address - MPEVirtualTextScreenBase);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualBitmapScreenBase &&
+       Address < MPEVirtualBitmapScreenBase + MPEVirtualDisplayCells)
+   {
+      MPEVirtualSetDirty(MPEVirtualScreenDirty,
+                         Address - MPEVirtualBitmapScreenBase);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+   if (Address >= MPEVirtualBitmapBase &&
+       Address < MPEVirtualBitmapBase + MPEVirtualBitmapBytes)
+   {
+      MPEVirtualSetDirty(MPEVirtualBitmapDirty,
+                         (Address - MPEVirtualBitmapBase) >> 3);
+      MPEVirtualState.VideoWriteGeneration++;
+   }
+}
+
+static FLASHMEM void MPEVirtualAGIClearDirty()
+{
+   memset(MPEVirtualTextDirty, 0, sizeof(MPEVirtualTextDirty));
+   memset(MPEVirtualBitmapDirty, 0, sizeof(MPEVirtualBitmapDirty));
+   memset(MPEVirtualScreenDirty, 0, sizeof(MPEVirtualScreenDirty));
+   memset(MPEVirtualColourDirty, 0, sizeof(MPEVirtualColourDirty));
+   memset(MPEVirtualVICDirty, 0, sizeof(MPEVirtualVICDirty));
+   memset(MPEVirtualSIDDirty, 0, sizeof(MPEVirtualSIDDirty));
+}
+
+static FLASHMEM void MPEVirtualAGIReset()
+{
+   if (MPEVirtualState.CPU)
+      vrEmu6502Destroy(MPEVirtualState.CPU);
+   memset(&MPEVirtualState, 0, sizeof(MPEVirtualState));
+   memset(MPEVirtualRuntimeHeader, 0, sizeof(MPEVirtualRuntimeHeader));
+   memset(MPEVirtualColour, 0, sizeof(MPEVirtualColour));
+   memset(MPEVirtualVIC, 0, sizeof(MPEVirtualVIC));
+   memset(MPEVirtualSID, 0, sizeof(MPEVirtualSID));
+   memset(MPEVirtualPresentedVIC, 0, sizeof(MPEVirtualPresentedVIC));
+   memset(MPEVirtualPresentedSID, 0, sizeof(MPEVirtualPresentedSID));
+   memset(MPEVirtualPresentedSpritePair, 0,
+          sizeof(MPEVirtualPresentedSpritePair));
+   memset(MPEVirtualPresentedSpritePointers, 0,
+          sizeof(MPEVirtualPresentedSpritePointers));
+   memset(MPEVirtualParserUnderlyingColour, 0,
+          sizeof(MPEVirtualParserUnderlyingColour));
+   memset(MPEVirtualKeyQueue, 0, sizeof(MPEVirtualKeyQueue));
+   MPEVirtualAGIClearDirty();
+}
+
+static FLASHMEM bool MPEVirtualAGILoadCharacterROMHeld()
+{
+   if (!AGIContinueDMA(true, MPEVirtualCharacterROMStageBase,
+                       MPEVirtualCharacterROM,
+                       MPEVirtualCharacterROMBytes, false))
+      return false;
+   // A missing client staging copy otherwise recreates the historical blank
+   // glyph failure.  The physical ROM is authoritative; reject an obviously
+   // floating/zero bus instead of silently booting without a font.
+   uint8_t First = MPEVirtualCharacterROM[0];
+   bool Different = false;
+   bool NonZero = First != 0;
+   for (uint16_t Index = 1; Index < MPEVirtualCharacterROMBytes; Index++)
+   {
+      Different |= MPEVirtualCharacterROM[Index] != First;
+      NonZero |= MPEVirtualCharacterROM[Index] != 0;
+   }
+   return Different && NonZero;
+}
+
+static FLASHMEM uint32_t MPEVirtualRawCRC32(uint32_t Raw, uint32_t Length,
+                                            bool *Okay)
+{
+   uint32_t CRC = 0xFFFFFFFFu;
+   uint8_t Error = AGIPicError_None;
+   *Okay = AGIPictureRawSpanValid(Raw, Length);
+   for (uint32_t Index = 0; *Okay && Index < Length; Index++)
+   {
+      uint8_t Byte;
+      if (!AGIPictureReadRaw(Raw + Index, &Byte, &Error))
+      {
+         *Okay = false;
+         break;
+      }
+      CRC = MHSNativeCRC32Byte(CRC, Byte);
+   }
+   return ~CRC;
+}
+
+static bool MPEVirtualRangeContains(uint32_t OuterRaw, uint32_t OuterBytes,
+                                    uint32_t InnerRaw, uint32_t InnerBytes)
+{
+   if (!OuterBytes || !InnerBytes || OuterRaw > UINT32_MAX - OuterBytes ||
+       InnerRaw < OuterRaw) return false;
+   uint32_t Relative = InnerRaw - OuterRaw;
+   return Relative <= OuterBytes && InnerBytes <= OuterBytes - Relative;
+}
+
+static bool MPEVirtualValidateRuntime(const uint8_t *Descriptor,
+                                      uint8_t *RuntimeHeader,
+                                      uint32_t *RuntimeRaw,
+                                      uint32_t *RuntimeBytes,
+                                      uint32_t *CartridgeRoot,
+                                      uint32_t *CartridgeBytes,
+                                      uint16_t *LoadAddress,
+                                      uint16_t *ImageBytes,
+                                      uint16_t *EntryPC)
+{
+   if (!Descriptor ||
+       memcmp(Descriptor, "VAG1", 4) != 0 ||
+       Descriptor[4] != 1 ||
+       Descriptor[5] != MPEVirtualBootDirectTitle ||
+       Descriptor[6] != MPEVirtualBootDescriptorBytes ||
+       Descriptor[7] >= MPEVirtualEasyFlashBanks ||
+       Descriptor[23] ||
+       !MPEVirtualBytesZero(Descriptor, 28, MPEVirtualBootDescriptorBytes))
+      return false;
+
+   *RuntimeRaw = MPEVirtualRead24(Descriptor + 8);
+   *RuntimeBytes = MPEVirtualRead32(Descriptor + 12);
+   uint32_t ExpectedRuntimeCRC = MPEVirtualRead32(Descriptor + 16);
+   *CartridgeRoot = MPEVirtualRead24(Descriptor + 20);
+   *CartridgeBytes = MPEVirtualRead32(Descriptor + 24);
+   if (*RuntimeBytes < MPEVirtualRuntimeHeaderBytes ||
+       *RuntimeBytes > MPEVirtualRuntimeHeaderBytes + 0xFFFFu ||
+       !AGIPictureRawSpanValid(*CartridgeRoot, *CartridgeBytes) ||
+       !MPEVirtualRangeContains(*CartridgeRoot, *CartridgeBytes,
+                                *RuntimeRaw, *RuntimeBytes) ||
+       (uint32_t)Descriptor[7] * MPEVirtualEasyFlashBankBytes >=
+          *CartridgeBytes)
+      return false;
+
+   bool Okay = false;
+   if (MPEVirtualRawCRC32(*RuntimeRaw, *RuntimeBytes, &Okay) !=
+          ExpectedRuntimeCRC || !Okay)
+      return false;
+
+   uint8_t Error = AGIPicError_None;
+   if (!AGIPictureReadRawBytes(*RuntimeRaw, RuntimeHeader,
+                               MPEVirtualRuntimeHeaderBytes, &Error) ||
+       memcmp(RuntimeHeader, "R65B", 4) != 0 ||
+       RuntimeHeader[4] != MPEVirtualRuntimeVersion ||
+       RuntimeHeader[5] != MPEVirtualRuntimeCPU6510 ||
+       RuntimeHeader[6] != MPEVirtualRuntimeHeaderBytes ||
+       RuntimeHeader[7] != MPEVirtualRuntimeLinkedImage ||
+       !MPEVirtualBytesZero(RuntimeHeader, 62, 64))
+      return false;
+
+   *LoadAddress = MPEVirtualRead16(RuntimeHeader + 8);
+   *ImageBytes = MPEVirtualRead16(RuntimeHeader + 10);
+   *EntryPC = MPEVirtualRead16(RuntimeHeader + 16);
+   if (!*ImageBytes ||
+       *RuntimeBytes != (uint32_t)MPEVirtualRuntimeHeaderBytes + *ImageBytes ||
+       (uint32_t)*LoadAddress + *ImageBytes > 0x10000u ||
+       *EntryPC < *LoadAddress ||
+       (uint32_t)*EntryPC >= (uint32_t)*LoadAddress + *ImageBytes)
+      return false;
+
+   // Every callable R65B hook is part of the linked resident image.  Refuse a
+   // descriptor whose frame boundary could jump into cartridge or blank RAM.
+   for (uint8_t Offset = 16; Offset <= 42; Offset += 2)
+   {
+      uint16_t Hook = MPEVirtualRead16(RuntimeHeader + Offset);
+      if (Hook < *LoadAddress ||
+          (uint32_t)Hook >= (uint32_t)*LoadAddress + *ImageBytes)
+         return false;
+   }
+   for (uint8_t Offset = 44; Offset <= 56; Offset += 2)
+      if (!MPEVirtualRead16(RuntimeHeader + Offset)) return false;
+
+   uint32_t ExpectedImageCRC = MPEVirtualRead32(RuntimeHeader + 12);
+   if (MPEVirtualRawCRC32(*RuntimeRaw + MPEVirtualRuntimeHeaderBytes,
+                          *ImageBytes, &Okay) != ExpectedImageCRC || !Okay)
+      return false;
+   return true;
+}
+
+static FLASHMEM bool MPEVirtualAGIBoot(const uint8_t *Descriptor,
+                                       uint8_t DescriptorLength)
+{
+   if (!Descriptor || DescriptorLength != MPEVirtualBootDescriptorBytes)
+      return false;
+
+   uint32_t RuntimeRaw, RuntimeBytes, CartridgeRoot, CartridgeBytes;
+   uint16_t LoadAddress, ImageBytes, EntryPC;
+   uint8_t RuntimeHeader[MPEVirtualRuntimeHeaderBytes];
+   if (!MPEVirtualValidateRuntime(Descriptor, RuntimeHeader,
+                                  &RuntimeRaw, &RuntimeBytes,
+                                  &CartridgeRoot, &CartridgeBytes,
+                                  &LoadAddress, &ImageBytes, &EntryPC))
+      return false;
+
+   // Validation above is read-only.  Only after both CRCs pass do we revoke a
+   // prior engine and replace its private state.
+   MPEVirtualAGIReset();
+   memset(MPEVirtualRAM, 0, sizeof(MPEVirtualRAM));
+   memset(MPEVirtualPresentedBitmap, 0,
+          sizeof(MPEVirtualPresentedBitmap));
+   memset(MPEVirtualPresentedText, 0, sizeof(MPEVirtualPresentedText));
+   memset(MPEVirtualPresentedScreen, 0, sizeof(MPEVirtualPresentedScreen));
+   memset(MPEVirtualPresentedColour, 0, sizeof(MPEVirtualPresentedColour));
+   memcpy(MPEVirtualRuntimeHeader, RuntimeHeader,
+          MPEVirtualRuntimeHeaderBytes);
+   uint8_t Error = AGIPicError_None;
+   for (uint32_t Index = 0; Index < ImageBytes; Index++)
+   {
+      if (!AGIPictureReadRaw(RuntimeRaw + MPEVirtualRuntimeHeaderBytes + Index,
+                             &MPEVirtualRAM[(uint32_t)LoadAddress + Index],
+                             &Error))
+      {
+         MPEVirtualAGIReset();
+         return false;
+      }
+   }
+
+   MPEVirtualState.CartridgeRawRoot = CartridgeRoot;
+   MPEVirtualState.CartridgeRawBytes = CartridgeBytes;
+   MPEVirtualState.RuntimeRaw = RuntimeRaw;
+   MPEVirtualState.RuntimeBytes = RuntimeBytes;
+   MPEVirtualState.RuntimeCRC32 = MPEVirtualRead32(Descriptor + 16);
+   MPEVirtualState.LoadAddress = LoadAddress;
+   MPEVirtualState.ImageBytes = ImageBytes;
+   MPEVirtualState.EntryPC = EntryPC;
+   MPEVirtualState.EasyFlashBank = Descriptor[7];
+   MPEVirtualState.ProcessorPort = Descriptor[11];
+   MPEVirtualState.CIA1TimerA = 0xACE1;
+   MPEVirtualState.CIA2TimerB = 0xFFFF;
+   MPEVirtualRAM[0] = 0x2F;
+   MPEVirtualRAM[1] = Descriptor[11];
+   MPEVirtualRAM[0x02A6] = 0; // MPE2 physical target currently proves NTSC.
+   MPEVirtualRAM[0xDC00] = 0xFF;
+   MPEVirtualRAM[0xDC01] = 0xFF;
+   MPEVirtualRAM[0xDD00] = 0xFF;
+   MPEVirtualSID[0x19] = 0xFF;
+   MPEVirtualSID[0x1A] = 0xFF;
+   MPEVirtualState.CPU = MPEVrEmu6502New6510(MPEVirtualMemoryRead,
+                                              MPEVirtualMemoryWrite);
+   if (!MPEVirtualState.CPU)
+   {
+      MPEVirtualAGIReset();
+      return false;
+   }
+   // vrEmu6502 intentionally exposes a lightweight lifecycle and does not
+   // initialize every register field.  Direct-title entry has no reset-vector
+   // prologue, so establish one deterministic 6510 power-on contract here.
+   // R65B is the sole entry authority.  The physical C64 never executes the
+   // packaged title or interpreter before this direct Teensy-owned entry.
+   MPEVrEmu6502Initialize(MPEVirtualState.CPU, EntryPC);
+   MPEVirtualState.Active = true;
+   return true;
+}
+
+static void MPEVirtualAdvanceHardware(uint8_t Cycles)
+{
+   MPEVirtualState.CIA1TimerA -= Cycles;
+   MPEVirtualState.RasterCycles += Cycles;
+   while (MPEVirtualState.RasterCycles >= MPEVirtualNTSCCyclesPerLine)
+   {
+      MPEVirtualState.RasterCycles -= MPEVirtualNTSCCyclesPerLine;
+      if (++MPEVirtualState.RasterLine >= MPEVirtualNTSCScanlines)
+         MPEVirtualState.RasterLine = 0;
+   }
+
+   // Runtime programs CIA2 Timer B to count 20 Hz Timer-A underflows. Model
+   // that externally visible down-counter directly; this is deterministic and
+   // prevents busy waits without synthesizing interrupt side effects.
+   if (MPEVirtualState.CIA2TimerBControl & 0x01)
+   {
+      MPEVirtualState.Timer50msCycles += Cycles;
+      while (MPEVirtualState.Timer50msCycles >= MPEVirtualNTSC50msCycles)
+      {
+         MPEVirtualState.Timer50msCycles -= MPEVirtualNTSC50msCycles;
+         MPEVirtualState.CIA2TimerB--;
+      }
+   }
+}
+
+static bool MPEVirtualKernalVisible()
+{
+   uint8_t DDR = MPEVirtualRAM[0];
+   uint8_t Port = (MPEVirtualRAM[1] & DDR) | (uint8_t)~DDR;
+   return (Port & 0x02) != 0;
+}
+
+static void MPEVirtualSetFlag(vrEmu6502Flag Flag, bool Set)
+{
+   uint8_t Flags = MPEVrEmu6502GetFlags(MPEVirtualState.CPU);
+   if (Set) Flags |= (uint8_t)Flag;
+   else Flags &= (uint8_t)~Flag;
+   MPEVrEmu6502SetFlags(MPEVirtualState.CPU, Flags);
+}
+
+static void MPEVirtualSetAccumulator(uint8_t Value)
+{
+   MPEVrEmu6502SetAccumulator(MPEVirtualState.CPU, Value);
+   MPEVirtualSetFlag(FlagZ, Value == 0);
+   MPEVirtualSetFlag(FlagN, (Value & 0x80) != 0);
+}
+
+static void MPEVirtualKernalRTS()
+{
+   MPEVrEmu6502KernalRTS(MPEVirtualState.CPU, MPEVirtualRAM);
+}
+
+static bool MPEVirtualQueueKey(uint8_t Key)
+{
+   uint8_t Next = (MPEVirtualState.KeyWrite + 1u) &
+      (MPEVirtualKeyQueueBytes - 1u);
+   if (Next == MPEVirtualState.KeyRead) return false;
+   MPEVirtualKeyQueue[MPEVirtualState.KeyWrite] = Key;
+   MPEVirtualState.KeyWrite = Next;
+   return true;
+}
+
+static uint8_t MPEVirtualPopKey()
+{
+   if (MPEVirtualState.KeyRead == MPEVirtualState.KeyWrite) return 0;
+   uint8_t Value = MPEVirtualKeyQueue[MPEVirtualState.KeyRead];
+   MPEVirtualState.KeyRead = (MPEVirtualState.KeyRead + 1u) &
+      (MPEVirtualKeyQueueBytes - 1u);
+   return Value;
+}
+
+static uint8_t MPEVirtualScreenCode(uint8_t PETSCII)
+{
+   if (PETSCII >= 'A' && PETSCII <= 'Z') return PETSCII - '@';
+   if (PETSCII >= 'a' && PETSCII <= 'z') return PETSCII - 0x60;
+   if (PETSCII >= 0xC1 && PETSCII <= 0xDA) return PETSCII - 0xC0;
+   return PETSCII;
+}
+
+static void MPEVirtualKernalCHROUT()
+{
+   uint8_t Character = vrEmu6502GetAcc(MPEVirtualState.CPU);
+   uint8_t Column = MPEVirtualRAM[0x00D3];
+   uint8_t Row = MPEVirtualRAM[0x00D6];
+   if (Character == 0x0D)
+   {
+      Column = 0;
+      if (Row < 24) Row++;
+   }
+   else if (Character == 0x14)
+   {
+      if (Column) Column--;
+      uint16_t Cell = (uint16_t)Row * 40u + Column;
+      if (Cell < MPEVirtualDisplayCells)
+         MPEVirtualMemoryWrite(MPEVirtualTextScreenBase + Cell, 0x20);
+   }
+   else if (Character == 0x93)
+   {
+      for (uint16_t Cell = 0; Cell < MPEVirtualDisplayCells; Cell++)
+      {
+         MPEVirtualMemoryWrite(MPEVirtualTextScreenBase + Cell, 0x20);
+         MPEVirtualMemoryWrite(MPEVirtualColourBase + Cell,
+                               MPEVirtualRAM[0x0286] & 0x0F);
+      }
+      Column = Row = 0;
+   }
+   else if (Character >= 0x20)
+   {
+      uint16_t Cell = (uint16_t)Row * 40u + Column;
+      if (Cell < MPEVirtualDisplayCells)
+      {
+         MPEVirtualMemoryWrite(MPEVirtualTextScreenBase + Cell,
+                               MPEVirtualScreenCode(Character));
+         MPEVirtualMemoryWrite(MPEVirtualColourBase + Cell,
+                               MPEVirtualRAM[0x0286] & 0x0F);
+      }
+      if (++Column >= 40)
+      {
+         Column = 0;
+         if (Row < 24) Row++;
+      }
+   }
+   MPEVirtualRAM[0x00D3] = Column;
+   MPEVirtualRAM[0x00D6] = Row;
+   MPEVirtualSetFlag(FlagC, false);
+}
+
+static bool MPEVirtualKernalTrap()
+{
+   if (!MPEVirtualKernalVisible()) return false;
+   VrEmu6502 *CPU = MPEVirtualState.CPU;
+   switch (vrEmu6502GetPC(CPU))
+   {
+      case 0xFF9F: // SCNKEY: terminal input is already an edge queue.
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFE4: // GETIN
+         MPEVirtualSetAccumulator(MPEVirtualPopKey());
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFD2: // CHROUT
+         MPEVirtualKernalCHROUT();
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFF0: // PLOT
+         if (MPEVrEmu6502GetFlags(CPU) & FlagC)
+         {
+            MPEVrEmu6502SetX(CPU, MPEVirtualRAM[0x00D6]);
+            MPEVrEmu6502SetY(CPU, MPEVirtualRAM[0x00D3]);
+         }
+         else
+         {
+            MPEVirtualRAM[0x00D6] = vrEmu6502GetX(CPU);
+            MPEVirtualRAM[0x00D3] = vrEmu6502GetY(CPU);
+         }
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFB7: // READST
+         MPEVirtualSetAccumulator(0);
+         MPEVirtualSetFlag(FlagC, false);
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFBA: // SETLFS
+      case 0xFFBD: // SETNAM
+      case 0xFFC3: // CLOSE
+      case 0xFFCC: // CLRCHN
+         MPEVirtualSetFlag(FlagC, false);
+         MPEVirtualKernalRTS();
+         return true;
+      case 0xFFC0: // OPEN: storage backend is deliberately not invented.
+      case 0xFFC6: // CHKIN
+      case 0xFFC9: // CHKOUT
+      case 0xFFCF: // CHRIN
+      case 0xFFD5: // LOAD
+      case 0xFFD8: // SAVE
+         MPEVirtualSetAccumulator(4);
+         MPEVirtualSetFlag(FlagC, true);
+         MPEVirtualKernalRTS();
+         return true;
+      default:
+         // No unvalidated zero-filled KERNAL execution is permitted. RAM
+         // beneath KERNAL remains executable when runtime selects $01=$35.
+         if (vrEmu6502GetPC(CPU) >= 0xE000)
+         {
+            MPEVirtualState.Faulted = true;
+            return true;
+         }
+         return false;
+   }
+}
+
+static bool MPEVirtualAGIRunCycles(uint32_t Budget)
+{
+   if (!MPEVirtualState.Active || !MPEVirtualState.CPU ||
+       MPEVirtualState.Faulted || !Budget) return false;
+   uint32_t Used = 0;
+   while (Used < Budget && !MPEVirtualState.Faulted)
+   {
+      if (MPEVirtualKernalTrap())
+      {
+         MPEVirtualAdvanceHardware(6);
+         Used += 6;
+         continue;
+      }
+      uint8_t InstructionCycles = vrEmu6502InstCycle(MPEVirtualState.CPU);
+      MPEVirtualAdvanceHardware(InstructionCycles ? InstructionCycles : 1);
+      Used += InstructionCycles ? InstructionCycles : 1;
+   }
+   MPEVirtualState.Cycles += Used;
+   if (MPEVirtualState.Faulted) MPEVirtualState.Active = false;
+   return MPEVirtualState.Active;
+}
+
+static bool MPEVirtualAGIRunToFrameBoundary(bool Initial)
+{
+   if (!MPEVirtualState.Active || !MPEVirtualState.CPU ||
+       MPEVirtualState.Faulted) return false;
+   const uint16_t FrameLoop = MPEVirtualRead16(MPEVirtualRuntimeHeader + 18);
+   const uint16_t FrameService = MPEVirtualRead16(MPEVirtualRuntimeHeader + 22);
+   const uint32_t Budget = Initial ? MPEVirtualBootCycleBudget :
+                                     MPEVirtualFrameCycleBudget;
+   const uint32_t StartCycles = MPEVirtualState.Cycles;
+   const uint16_t StartPC = vrEmu6502GetPC(MPEVirtualState.CPU);
+   const uint32_t StartVideoGeneration =
+      MPEVirtualState.VideoWriteGeneration;
+   bool LeftFrameLoop = StartPC != FrameLoop;
+   bool SawStableService = false;
+   uint32_t ServiceVideoGeneration = 0;
+   while (MPEVirtualState.Cycles - StartCycles < Budget)
+   {
+      uint16_t PC = vrEmu6502GetPC(MPEVirtualState.CPU);
+      if (PC == FrameLoop && (Initial || LeftFrameLoop)) return true;
+      if (PC != FrameLoop) LeftFrameLoop = true;
+
+      // Synchronous print/menu/checkpoint actions may intentionally wait
+      // inside the current LOGIC and never return to the outer loop until the
+      // next key.  Two consecutive frame-service entries with no intervening
+      // video write are a coherent, stable modal publication boundary.
+      if (!Initial && PC == FrameService &&
+          (StartPC == FrameService ||
+           MPEVirtualState.VideoWriteGeneration != StartVideoGeneration))
+      {
+         if (SawStableService &&
+             ServiceVideoGeneration == MPEVirtualState.VideoWriteGeneration)
+            return true;
+         SawStableService = true;
+         ServiceVideoGeneration = MPEVirtualState.VideoWriteGeneration;
+      }
+      if (!MPEVirtualAGIRunCycles(1)) return false;
+   }
+   MPEVirtualState.Faulted = true;
+   MPEVirtualState.Active = false;
+   return false;
+}
+
+static bool MPEVirtualAGIActive()
+{
+   return MPEVirtualState.Active && MPEVirtualState.CPU &&
+      !MPEVirtualState.Faulted;
+}
+
+static bool MPEVirtualAGITextMode()
+{
+   return (MPEVirtualVIC[0x11] & 0x20) == 0;
+}
+
+static uint8_t MPEVirtualAGICurrentRoom()
+{
+   uint16_t Variables = MPEVirtualRead16(MPEVirtualRuntimeHeader + 48);
+   return MPEVirtualRAM[Variables];
+}
+
+static uint8_t MPEVirtualAGIHostEvent()
+{
+   // R65B v1 does not encode the modal/checkpoint owner.  Raw INT2 key edges
+   // still drive title, menu and parser input, but firmware must not invent an
+   // event from a build-specific resident-variable offset.
+   return 0;
+}
+
+static void MPEVirtualAGISetJoystick(uint8_t Held)
+{
+   // INT2 is active high; CIA port B is active low.  Bits 5..7 remain neutral.
+   MPEVirtualRAM[0xDC01] = (uint8_t)((~Held & 0x1F) | 0xE0);
+}
+
+static bool MPEVirtualAGIQueueInputKey(uint8_t Key)
+{
+   return !Key || MPEVirtualQueueKey(Key);
+}
+
+static uint8_t MPEVirtualAGIPublishedVIC(uint8_t Index, bool TextMode)
+{
+   if (Index >= MPEVirtualVICBytes) return 0;
+   uint8_t Value = MPEVirtualVIC[Index];
+   // Text-mode virtual $0400 cannot be copied onto the physical MPE2 mailbox.
+   // Translate only the screen-base nibble to physical $0800.  Bitmap mode
+   // retains its packed $5C00 screen and is published independently.
+   if (TextMode && Index == 0x18 && (Value & 0xF0) == 0x10)
+      Value = (Value & 0x0F) | 0x20;
+   return Value;
+}
+
+static uint8_t MPEVirtualAGIWireVIC(uint8_t Index, bool TextMode)
+{
+   static const uint8_t Registers[25] = {
+      0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
+      0x10, 0x11, 0x15, 0x16, 0xFF, 0x18, 0x1B, 0x1C, 0x1D,
+      0x20, 0x21, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A
+   };
+   if (Index >= sizeof(Registers)) return 0;
+   if (Registers[Index] == 0xFF) return MPEVirtualRAM[0xDD00];
+   return MPEVirtualAGIPublishedVIC(Registers[Index], TextMode);
+}
+
+static void MPEVirtualAGICopySpritePair(uint8_t *Output)
+{
+   memcpy(Output, MPEVirtualRAM + MPEVirtualSpritePairBase,
+          MPEVirtualSpriteBytes);
+   memcpy(Output + MPEVirtualSpriteBytes,
+          MPEVirtualRAM + MPEVirtualSpriteSecondBase,
+          MPEVirtualSpriteBytes);
+}
+
+static bool MPEVirtualDirtySet(const uint8_t *Bits, uint16_t Index)
+{
+   return (Bits[Index >> 3] & (uint8_t)(1u << (Index & 7))) != 0;
+}
+
+static void MPEVirtualClearDirtyBit(uint8_t *Bits, uint16_t Index)
+{
+   Bits[Index >> 3] &= (uint8_t)~(1u << (Index & 7));
+}
+
+static bool MPEVirtualBitmapCellTouched(uint16_t Cell)
+{
+   return MPEVirtualDirtySet(MPEVirtualBitmapDirty, Cell) ||
+      MPEVirtualDirtySet(MPEVirtualScreenDirty, Cell) ||
+      MPEVirtualDirtySet(MPEVirtualColourDirty, Cell);
+}
+
+static bool MPEVirtualTextCellTouched(uint16_t Cell)
+{
+   return MPEVirtualDirtySet(MPEVirtualTextDirty, Cell) ||
+      MPEVirtualDirtySet(MPEVirtualColourDirty, Cell);
+}
+
+static bool MPEVirtualAGIParserSplitActive()
+{
+   return !MPEVirtualAGITextMode() &&
+      MPEVirtualRAM[MPEVirtualParserSplitRequested] != 0;
+}
+
+static uint8_t MPEVirtualAGIBitmapByte(uint16_t Cell, uint8_t Row)
+{
+   if (MPEVirtualAGIParserSplitActive() &&
+       Cell >= MPEVirtualParserFirstCell && Cell < MPEVirtualDisplayCells)
+   {
+      uint8_t Code = MPEVirtualRAM[MPEVirtualParserScreenBase +
+         Cell - MPEVirtualParserFirstCell];
+      uint8_t Source = MPEVirtualRAM[MPEVirtualParserFontBase +
+         (uint16_t)Code * 8u + Row];
+      // The terminal retains multicolour bitmap mode. Convert each useful
+      // 1-bpp glyph pair to multicolour code 01, matching ui_draw_char, so a
+      // letter cannot accidentally select all three multicolour sources.
+      uint8_t Converted = 0;
+      if (Source & 0x60) Converted |= 0x40;
+      if (Source & 0x18) Converted |= 0x10;
+      if (Source & 0x06) Converted |= 0x04;
+      return Converted;
+   }
+   return MPEVirtualRAM[MPEVirtualBitmapBase + Cell * 8u + Row];
+}
+
+static uint8_t MPEVirtualAGIBitmapScreen(uint16_t Cell)
+{
+   if (MPEVirtualAGIParserSplitActive() &&
+       Cell >= MPEVirtualParserFirstCell && Cell < MPEVirtualDisplayCells)
+   {
+      uint8_t Foreground = MPEVirtualColour[Cell] & 0x0F;
+      uint8_t Background = MPEVirtualVIC[0x21] & 0x0F;
+      return (uint8_t)((Foreground << 4) | Background);
+   }
+   return MPEVirtualRAM[MPEVirtualBitmapScreenBase + Cell];
+}
+
+static uint8_t MPEVirtualAGIBitmapColour(uint16_t Cell)
+{
+   if (MPEVirtualAGIParserSplitActive() &&
+       Cell >= MPEVirtualParserFirstCell && Cell < MPEVirtualDisplayCells)
+      return MPEVirtualColour[Cell] & 0x07;
+   if (Cell >= MPEVirtualParserFirstCell &&
+       Cell < MPEVirtualDisplayCells)
+      return MPEVirtualParserUnderlyingColour[
+         Cell - MPEVirtualParserFirstCell];
+   return MPEVirtualColour[Cell];
+}
+
+static void MPEVirtualAGICopyBitmapRun(uint16_t FirstCell,
+                                       uint8_t CellCount,
+                                       uint8_t *Bitmap,
+                                       uint8_t *Screen,
+                                       uint8_t *Colour)
+{
+   for (uint8_t Offset = 0; Offset < CellCount; Offset++)
+   {
+      uint16_t Cell = FirstCell + Offset;
+      for (uint8_t Row = 0; Row < 8; Row++)
+         Bitmap[(uint16_t)Offset * 8u + Row] =
+            MPEVirtualAGIBitmapByte(Cell, Row);
+      Screen[Offset] = MPEVirtualAGIBitmapScreen(Cell);
+      Colour[Offset] = MPEVirtualAGIBitmapColour(Cell);
+   }
+}
+
+static bool MPEVirtualBitmapCellChanged(uint16_t Cell)
+{
+   for (uint8_t Row = 0; Row < 8; Row++)
+      if (MPEVirtualAGIBitmapByte(Cell, Row) !=
+          MPEVirtualPresentedBitmap[Cell * 8u + Row]) return true;
+   return MPEVirtualAGIBitmapScreen(Cell) !=
+         MPEVirtualPresentedScreen[Cell] ||
+      MPEVirtualAGIBitmapColour(Cell) != MPEVirtualPresentedColour[Cell];
+}
+
+static bool MPEVirtualTextCellChanged(uint16_t Cell)
+{
+   return MPEVirtualRAM[MPEVirtualTextScreenBase + Cell] !=
+         MPEVirtualPresentedText[Cell] ||
+      MPEVirtualColour[Cell] != MPEVirtualPresentedColour[Cell];
+}
+
+static void MPEVirtualAGIFinalizeDirty(bool TextMode)
+{
+   if (!TextMode && MPEVirtualState.PresentedValid &&
+       MPEVirtualState.PresentedParserSplit !=
+          MPEVirtualAGIParserSplitActive())
+      for (uint16_t Cell = MPEVirtualParserFirstCell;
+           Cell < MPEVirtualDisplayCells; Cell++)
+         MPEVirtualSetDirty(MPEVirtualBitmapDirty, Cell);
+   for (uint16_t Cell = 0; Cell < MPEVirtualDisplayCells; Cell++)
+   {
+      if (TextMode && MPEVirtualTextCellTouched(Cell) &&
+          MPEVirtualState.PresentedValid &&
+          !MPEVirtualTextCellChanged(Cell))
+      {
+         MPEVirtualClearDirtyBit(MPEVirtualTextDirty, Cell);
+         MPEVirtualClearDirtyBit(MPEVirtualColourDirty, Cell);
+      }
+      if (!TextMode && MPEVirtualBitmapCellTouched(Cell) &&
+          MPEVirtualState.PresentedValid &&
+          !MPEVirtualBitmapCellChanged(Cell))
+      {
+         MPEVirtualClearDirtyBit(MPEVirtualBitmapDirty, Cell);
+         MPEVirtualClearDirtyBit(MPEVirtualScreenDirty, Cell);
+         MPEVirtualClearDirtyBit(MPEVirtualColourDirty, Cell);
+      }
+   }
+   // Presented VIC state uses FRA2 wire order rather than raw D000-relative
+   // indices. MPEVirtualAGIVICChanged compares that final image directly, so
+   // keep raw touch bits until the correlated presentation commits.
+   for (uint8_t Index = 0; Index < MPEVirtualSIDBytes; Index++)
+      if (MPEVirtualDirtySet(MPEVirtualSIDDirty, Index) &&
+          MPEVirtualState.PresentedValid &&
+          MPEVirtualSID[Index] == MPEVirtualPresentedSID[Index])
+         MPEVirtualClearDirtyBit(MPEVirtualSIDDirty, Index);
+   if (MPEVirtualState.SpritePairTouched &&
+       MPEVirtualState.PresentedValid)
+   {
+      MPEVirtualAGICopySpritePair(MPEVirtualSpritePair);
+      if (memcmp(MPEVirtualSpritePair, MPEVirtualPresentedSpritePair,
+                 MPEVirtualSpritePairBytes) == 0 &&
+          memcmp(MPEVirtualRAM + MPEVirtualSpritePointerBase,
+                 MPEVirtualPresentedSpritePointers, 2) == 0)
+         MPEVirtualState.SpritePairTouched = false;
+   }
+}
+
+static bool MPEVirtualAGIRequestFullFrame(MPEVirtualFullFrameReason Reason,
+                                          bool TextMode)
+{
+   if (Reason == MPEVirtualFullFrameNone ||
+       (Reason == MPEVirtualFullFrameInitial &&
+        MPEVirtualState.PresentedValid) ||
+       Reason > MPEVirtualFullFrameForcedResync)
+      return false;
+   memset(TextMode ? MPEVirtualTextDirty : MPEVirtualBitmapDirty,
+          0xFF, MPEVirtualDirtyBytes);
+   if (!TextMode) memset(MPEVirtualScreenDirty, 0xFF,
+                         MPEVirtualDirtyBytes);
+   memset(MPEVirtualColourDirty, 0xFF, MPEVirtualDirtyBytes);
+   memset(MPEVirtualVICDirty, 0xFF, MPEVirtualVICDirtyBytes);
+   memset(MPEVirtualSIDDirty, 0xFF, MPEVirtualSIDDirtyBytes);
+   MPEVirtualState.SpritePairTouched = true;
+   return true;
+}
+
+static bool MPEVirtualAGINextDirtyRun(bool TextMode, uint16_t *Cursor,
+                                      MPEVirtualDirtyRun *Run)
+{
+   if (!Cursor || !Run || *Cursor > MPEVirtualDisplayCells) return false;
+   uint16_t Cell = *Cursor;
+   while (Cell < MPEVirtualDisplayCells &&
+          !(TextMode ? MPEVirtualTextCellTouched(Cell) :
+                       MPEVirtualBitmapCellTouched(Cell)))
+      Cell++;
+   if (Cell == MPEVirtualDisplayCells)
+   {
+      *Cursor = Cell;
+      return false;
+   }
+   uint16_t RowEnd = (uint16_t)(((Cell / 40u) + 1u) * 40u);
+   uint16_t End = Cell + 1u;
+   while (End < RowEnd &&
+          (TextMode ? MPEVirtualTextCellTouched(End) :
+                      MPEVirtualBitmapCellTouched(End)))
+      End++;
+   Run->FirstCell = Cell;
+   Run->CellCount = (uint8_t)(End - Cell);
+   *Cursor = End;
+   return true;
+}
+
+static uint16_t MPEVirtualAGIDirtyCellCount(bool TextMode)
+{
+   uint16_t Count = 0;
+   for (uint16_t Cell = 0; Cell < MPEVirtualDisplayCells; Cell++)
+      if (TextMode ? MPEVirtualTextCellTouched(Cell) :
+                     MPEVirtualBitmapCellTouched(Cell)) Count++;
+   return Count;
+}
+
+static bool MPEVirtualAGIVICChanged(bool TextMode)
+{
+   if (!MPEVirtualState.PresentedValid) return true;
+   for (uint8_t Index = 0; Index < 25; Index++)
+      if (MPEVirtualAGIWireVIC(Index, TextMode) !=
+          MPEVirtualPresentedVIC[Index]) return true;
+   return false;
+}
+
+static bool MPEVirtualAGISIDChanged()
+{
+   if (!MPEVirtualState.PresentedValid) return true;
+   return memcmp(MPEVirtualSID, MPEVirtualPresentedSID, 25) != 0;
+}
+
+static bool MPEVirtualAGISpritePairChanged(bool TextMode)
+{
+   if (TextMode) return false;
+   MPEVirtualAGICopySpritePair(MPEVirtualSpritePair);
+   return !MPEVirtualState.PresentedValid ||
+      memcmp(MPEVirtualSpritePair, MPEVirtualPresentedSpritePair,
+             MPEVirtualSpritePairBytes) != 0 ||
+      memcmp(MPEVirtualRAM + MPEVirtualSpritePointerBase,
+             MPEVirtualPresentedSpritePointers, 2) != 0;
+}
+
+static bool MPEVirtualAGIModeChanged(bool TextMode)
+{
+   return MPEVirtualState.PresentedValid &&
+      MPEVirtualState.PresentedTextMode != TextMode;
+}
+
+static bool MPEVirtualAGIRoomChanged()
+{
+   return MPEVirtualState.PresentedValid &&
+      MPEVirtualState.PresentedRoom != MPEVirtualAGICurrentRoom();
+}
+
+static uint32_t MPEVirtualAGINextPresentationGeneration()
+{
+   uint32_t Generation = MPEVirtualState.PresentationGeneration + 1u;
+   return Generation ? Generation : 1u;
+}
+
+static void MPEVirtualAGICommitPresentation(bool TextMode)
+{
+   for (uint16_t Cell = 0; Cell < MPEVirtualDisplayCells; Cell++)
+   {
+      if (TextMode && MPEVirtualTextCellTouched(Cell))
+      {
+         MPEVirtualPresentedText[Cell] =
+            MPEVirtualRAM[MPEVirtualTextScreenBase + Cell];
+         MPEVirtualPresentedColour[Cell] = MPEVirtualColour[Cell];
+      }
+      else if (!TextMode && MPEVirtualBitmapCellTouched(Cell))
+      {
+         for (uint8_t Row = 0; Row < 8; Row++)
+            MPEVirtualPresentedBitmap[Cell * 8u + Row] =
+               MPEVirtualAGIBitmapByte(Cell, Row);
+         MPEVirtualPresentedScreen[Cell] =
+            MPEVirtualAGIBitmapScreen(Cell);
+         MPEVirtualPresentedColour[Cell] =
+            MPEVirtualAGIBitmapColour(Cell);
+      }
+   }
+   for (uint8_t Index = 0; Index < 25; Index++)
+      MPEVirtualPresentedVIC[Index] =
+         MPEVirtualAGIWireVIC(Index, TextMode);
+   memcpy(MPEVirtualPresentedSID, MPEVirtualSID, 25);
+   if (MPEVirtualState.SpritePairTouched)
+   {
+      MPEVirtualAGICopySpritePair(MPEVirtualSpritePair);
+      memcpy(MPEVirtualPresentedSpritePair, MPEVirtualSpritePair,
+             MPEVirtualSpritePairBytes);
+      memcpy(MPEVirtualPresentedSpritePointers,
+             MPEVirtualRAM + MPEVirtualSpritePointerBase, 2);
+   }
+   MPEVirtualState.PresentedTextMode = TextMode;
+   MPEVirtualState.PresentedRoom = MPEVirtualAGICurrentRoom();
+   MPEVirtualState.PresentedParserSplit =
+      MPEVirtualAGIParserSplitActive();
+   MPEVirtualState.PresentedValid = true;
+   MPEVirtualState.SpritePairTouched = false;
+   if (!++MPEVirtualState.PresentationGeneration)
+      MPEVirtualState.PresentationGeneration = 1;
+   MPEVirtualAGIClearDirty();
+}
+
+static_assert(MPEVirtualTerminalTextBase >= 0x0600,
+              "physical text output must not overlap the MPE2 mailbox");
+static_assert(sizeof(MPEVirtualRAM) == 0x10000,
+              "MPE2 must retain one complete virtual C64 address space");
+static_assert(sizeof(MPEVirtualTextDirty) == 125 &&
+              sizeof(MPEVirtualBitmapDirty) == 125 &&
+              sizeof(MPEVirtualScreenDirty) == 125 &&
+              sizeof(MPEVirtualColourDirty) == 125,
+              "each virtual video plane requires exact 1000-cell tracking");
+static_assert(MPEVirtualKeyQueueBytes == 64 &&
+              (MPEVirtualKeyQueueBytes & (MPEVirtualKeyQueueBytes - 1)) == 0,
+              "terminal GETIN queue must be a power of two");
+static_assert(8u + 1u + 1u == 10u,
+              "bitmap dirty-cell DMA is exactly eight bitmap, screen, colour bytes");
