+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const handler = fs.readFileSync(path.join(here, "..", "Common", "IO_Handlers",
+  "IOH_AGIPicture.c"), "utf8");
+const engine = fs.readFileSync(path.join(here, "..", "Common", "IO_Handlers",
+  "IOH_MPEVirtualAGI.c"), "utf8");
+const core = fs.readFileSync(path.join(here, "..", "Common", "ThirdParty",
+  "vrEmu6502", "vrEmu6502.c"), "utf8");
+const bridge = fs.readFileSync(path.join(here, "..",
+  "MPEVirtual6502Bridge.c"), "utf8");
+
+for (const required of [
+  "static DMAMEM uint8_t MPEVirtualRAM[0x10000]",
+  "MPEVrEmu6502New6510",
+  "MPEVrEmu6502Initialize(MPEVirtualState.CPU, EntryPC)",
+  "MPEVirtualCartridgeRead",
+  "MPEVirtualHighCartridgeVisible",
+  "MPEVirtualCharacterROMStageBase = 0x0C00",
+  "MPEVirtualCharacterROMBytes = 512",
+  "MPEVirtualTextDirty",
+  "MPEVirtualBitmapDirty",
+  "MPEVirtualScreenDirty",
+  "MPEVirtualColourDirty",
+  "MPEVirtualSIDDirty",
+  "MPEVirtualVICDirty",
+  "MPEVirtualPresentedBitmap",
+  "MPEVirtualPresentedSpritePair",
+  "MPEVirtualPresentedSpritePointers",
+  "MPEVirtualAGINextDirtyRun",
+  "MPEVirtualNTSCScanlines = 263",
+  "MPEVirtualNTSC50msCycles = 51136u",
+  "MPEVirtualParserFirstCell = 960",
