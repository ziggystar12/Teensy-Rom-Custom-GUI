+function crc32(data) {
+  let crc = 0xffffffff;
+  for (const byte of data) {
+    crc ^= byte;
+    for (let bit = 0; bit < 8; bit += 1) {
+      crc = (crc >>> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+    }
+  }
+  return (~crc) >>> 0;
+}
+
+function writeU24(output, offset, value) {
+  output[offset] = value & 0xff;
+  output[offset + 1] = (value >>> 8) & 0xff;
+  output[offset + 2] = (value >>> 16) & 0xff;
+}
+
+function readU24(input, offset) {
+  return input[offset] | input[offset + 1] << 8 | input[offset + 2] << 16;
+}
+
+function fixture() {
+  const image = Buffer.from([0x78, 0xd8, 0xa9, 0x00, 0x60]);
+  const header = Buffer.alloc(64);
+  header.write("R65B", 0, 4, "ascii");
+  header[4] = 1;
+  header[5] = 1;
+  header[6] = 64;
+  header[7] = 1;
+  header.writeUInt16LE(0x2000, 8);
+  header.writeUInt16LE(image.length, 10);
+  header.writeUInt32LE(crc32(image), 12);
+  header.writeUInt16LE(0x2000, 16);
+  const section = Buffer.concat([header, image]);
+  const raw = Buffer.alloc(0x10000, 0xff);
+  section.copy(raw, 0x2100);
+  const descriptor = Buffer.alloc(40);
+  descriptor.write("VAG1", 0, 4, "ascii");
+  descriptor[4] = 1;
+  descriptor[5] = 1;
+  descriptor[6] = 40;
+  descriptor[7] = 2;
+  writeU24(descriptor, 8, 0x2100);
+  descriptor[11] = 0x37;
+  descriptor.writeUInt32LE(section.length, 12);
+  descriptor.writeUInt32LE(crc32(section), 16);
+  writeU24(descriptor, 20, 0);
+  descriptor.writeUInt32LE(raw.length, 24);
+  return { descriptor, header, image, raw, section };
+}
+
+function validateBoot({ descriptor, raw }) {
+  assert.equal(descriptor.toString("ascii", 0, 4), "VAG1");
+  assert.equal(descriptor[4], 1);
+  assert.equal(descriptor[5], 1);
+  assert.equal(descriptor[6], 40);
+  assert.ok(descriptor.subarray(28).every(byte => byte === 0));
+  const runtimeRaw = readU24(descriptor, 8);
+  const runtimeBytes = descriptor.readUInt32LE(12);
+  const cartRoot = readU24(descriptor, 20);
+  const cartBytes = descriptor.readUInt32LE(24);
+  assert.ok(runtimeRaw >= cartRoot && runtimeRaw + runtimeBytes <= cartRoot + cartBytes);
+  const section = raw.subarray(runtimeRaw, runtimeRaw + runtimeBytes);
+  assert.equal(crc32(section), descriptor.readUInt32LE(16));
+  assert.equal(section.toString("ascii", 0, 4), "R65B");
+  assert.deepEqual([...section.subarray(62, 64)], [0, 0]);
+  const imageBytes = section.readUInt16LE(10);
+  assert.equal(runtimeBytes, 64 + imageBytes);
+  assert.equal(crc32(section.subarray(64)), section.readUInt32LE(12));
+  const load = section.readUInt16LE(8);
+  const entry = section.readUInt16LE(16);
+  assert.ok(entry >= load && entry < load + imageBytes);
+  return { entry, bank: descriptor[7], cartRoot, cartBytes };
+}
+
+const good = fixture();
+assert.deepEqual(validateBoot(good), {
+  entry: 0x2000,
+  bank: 2,
+  cartRoot: 0,
+  cartBytes: 0x10000
+});
+assert.equal(good.descriptor[7] * 0x4000 + (0x9abc - 0x8000), 0x9abc,
+  "EasyFlash read mapping must be bank*16K plus CPU window offset");
+const badOuter = structuredClone(good);
+badOuter.raw = Buffer.from(good.raw);
+badOuter.raw[0x2101] ^= 1;
+assert.throws(() => validateBoot(badOuter), /Expected values to be strictly equal/);
+const badReserved = structuredClone(good);
+badReserved.descriptor = Buffer.from(good.descriptor);
+badReserved.descriptor[39] = 1;
+assert.throws(() => validateBoot(badReserved));
+
+function dirtyRuns(current, presented) {
+  const changed = Array.from({ length: 1000 }, (_, cell) => {
+    const start = cell * 10;
+    return !current.subarray(start, start + 10).equals(
+      presented.subarray(start, start + 10));
+  });
+  const runs = [];
+  for (let cell = 0; cell < 1000;) {
+    while (cell < 1000 && !changed[cell]) cell += 1;
+    if (cell === 1000) break;
+    const first = cell;
+    const rowEnd = (Math.floor(first / 40) + 1) * 40;
+    while (cell < rowEnd && changed[cell]) cell += 1;
+    runs.push({ firstCell: first, cellCount: cell - first });
+  }
+  return runs;
+}
+
+const presented = Buffer.alloc(10000);
+const restored = Buffer.alloc(10000);
+restored[100] = 7;
+restored[100] = 0;
+assert.deepEqual(dirtyRuns(restored, presented), [],
+  "write then restore must publish no DMA");
+const rowBoundary = Buffer.alloc(10000);
+rowBoundary[39 * 10] = 1;
+rowBoundary[40 * 10] = 1;
+assert.deepEqual(dirtyRuns(rowBoundary, presented), [
+  { firstCell: 39, cellCount: 1 },
+  { firstCell: 40, cellCount: 1 }
+]);
+assert.ok(dirtyRuns(rowBoundary, presented)
+  .every(run => Math.floor(run.firstCell / 40) ===
+    Math.floor((run.firstCell + run.cellCount - 1) / 40)));
+assert.equal(8 + 1 + 1, 10);
+
+function translatedD018(value, textMode) {
+  return textMode && (value & 0xf0) === 0x10 ? (value & 0x0f) | 0x20 : value;
+}
+assert.equal(translatedD018(0x16, true), 0x26);
+assert.equal(translatedD018(0x16, false), 0x16);
+
+const fullFrameReasons = new Set([1, 2, 3, 4]);
+assert.ok(fullFrameReasons.has(1)); // initial title
+assert.ok(fullFrameReasons.has(2)); // room/full-screen transition
+assert.ok(fullFrameReasons.has(3)); // display-mode transition
+assert.ok(fullFrameReasons.has(4)); // explicit resync
+assert.ok(!fullFrameReasons.has(0)); // routine animation/gameplay
+
+let raster = 0;
+let rasterCycles = 0;
+for (let cycle = 0; cycle < 65 * 263; cycle += 1) {
+  rasterCycles += 1;
+  if (rasterCycles >= 65) {
+    rasterCycles -= 65;
+    raster = (raster + 1) % 263;
+  }
+}
+assert.equal(raster, 0);
+let timerB = 0xffff;
+let timerCycles = 0;
+for (let cycle = 0; cycle < 51136; cycle += 1) {
+  timerCycles += 1;
+  if (timerCycles >= 51136) {
+    timerCycles -= 51136;
+    timerB = (timerB - 1) & 0xffff;
+  }
+}
+assert.equal(timerB, 0xfffe);
