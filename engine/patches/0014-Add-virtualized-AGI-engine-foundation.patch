-static void MPEThinKick()
+static uint8_t MPEThinVirtualEnvelopeFlags(uint8_t StreamFlags)
+{
+   uint8_t Flags = 0;
+   if (StreamFlags & 0x02) Flags |= 0x01;
+   if (StreamFlags & 0x04) Flags |= 0x02;
+   if (StreamFlags & 0x08) Flags |= 0x04;
+   if (StreamFlags & 0x10) Flags |= 0x08;
+   if (StreamFlags & 0x20) Flags |= 0x10;
+   return Flags;
+}
+
+static bool MPEThinVirtualInputHeld(const uint8_t *Payload,
+                                    uint8_t EnvelopeFlags,
+                                    bool *GenerationMismatch)
+{
+   if (!Payload || !GenerationMismatch ||
+       memcmp(Payload, "INT2", 4) != 0 || Payload[4] != 1 ||
+       (Payload[5] & ~0x3F) ||
+       MPEThinVirtualEnvelopeFlags(Payload[5]) != EnvelopeFlags ||
+       Payload[15] || !MPEThinBytesZero(Payload, 21, 24) ||
+       !MPEThinBytesZero(Payload, 28, 40)) return false;
+
+   uint8_t StreamFlags = Payload[5];
+   uint8_t TextLength = Payload[14];
+   bool TextSubmitted = (StreamFlags & 0x02) != 0;
+   if (TextSubmitted != (TextLength != 0) || TextLength > 36) return false;
+   if (((StreamFlags & 0x08) != 0) != (Payload[18] != 0) ||
+       ((StreamFlags & 0x10) != 0) != (Payload[19] != 0) ||
+       ((StreamFlags & 0x20) != 0) != (Payload[20] != 0)) return false;
+
+   if (TextSubmitted)
+   {
+      if (MPEThinRead16(Payload + 12) != MPEThinTextStageAddress ||
+          !AGIContinueDMA(true, MPEThinTextStageAddress, MPEThinTextStage,
+                          TextLength + 1u, false) ||
+          MPEThinTextStage[TextLength] != 0 ||
+          MPEThinCRC16(MPEThinTextStage, TextLength) !=
+             MPEThinRead16(Payload + 16)) return false;
+      for (uint8_t Index = 0; Index < TextLength; Index++)
+         if (!MPEThinTextStage[Index]) return false;
+      // R65B v1 has no reliable input-owner field. The staging copy proves
+      // request integrity/correlation only; KeyEdge (including Return) is the
+      // sole VM input authority and is never duplicated from this text.
+   }
+   else if (MPEThinRead16(Payload + 12) || TextLength ||
+            MPEThinRead16(Payload + 16)) return false;
+
+   *GenerationMismatch = MPEThinRead32(Payload + 24) !=
+      MPEVirtualState.PresentationGeneration;
+   MPEVirtualAGISetJoystick(Payload[6]);
+   return MPEVirtualAGIQueueInputKey(Payload[8]);
+}
+
+static bool MPEThinVirtualPublishSIDHeld(uint32_t Sequence,
+                                         uint32_t SessionNonce)
+{
+   memset(MPEThinSID, 0, sizeof(MPEThinSID));
+   memcpy(MPEThinSID, "MPS2", 4);
+   MPEThinSID[4] = MPEThinProtocolVersion;
+   MPEThinSID[5] = 1;
+   MPEThinSID[6] = MPEThinPayloadBytes;
+   MPEThinWrite32(MPEThinSID + 8, Sequence);
+   MPEThinWrite32(MPEThinSID + 12, SessionNonce);
+   memcpy(MPEThinSID + MPEThinPayloadOffset, "SID2", 4);
+   MPEThinSID[MPEThinPayloadOffset + 4] = 1;
+   memcpy(MPEThinSID + MPEThinPayloadOffset + 8,
+          MPEVirtualSID, 25);
+   MPEThinWrite16(MPEThinSID + MPEThinCRCOffset,
+                  MPEThinCRC16(MPEThinSID, MPEThinCRCOffset));
+   MPEThinWrite32(MPEThinSID + MPEThinCommitOffset, Sequence);
+   return AGIContinueDMA(false, MPEThinSIDAddress, MPEThinSID,
+                         MPEThinEnvelopeBytes, false);
+}
+
+static bool MPEThinVirtualDMARunHeld(bool TextMode,
+                                     const MPEVirtualDirtyRun &Run)
+{
+   if (TextMode)
+      return AGIContinueDMA(false,
+               MPEVirtualTerminalTextBase + Run.FirstCell,
+               MPEVirtualRAM + MPEVirtualTextScreenBase + Run.FirstCell,
+               Run.CellCount, false) &&
+         AGIContinueDMA(false, MPEVirtualColourBase + Run.FirstCell,
+               MPEVirtualColour + Run.FirstCell, Run.CellCount, false);
+
+   MPEVirtualAGICopyBitmapRun(Run.FirstCell, Run.CellCount,
+                              AGIPicPatchBitmap, AGIPicPatchScreen,
+                              AGIPicPatchColour);
+   return AGIContinueDMA(false,
+            MPEVirtualBitmapBase + Run.FirstCell * 8u,
+            AGIPicPatchBitmap, (uint16_t)Run.CellCount * 8u, false) &&
+      AGIContinueDMA(false, MPEVirtualBitmapScreenBase + Run.FirstCell,
+            AGIPicPatchScreen, Run.CellCount, false) &&
+      AGIContinueDMA(false, MPEVirtualColourBase + Run.FirstCell,
+            AGIPicPatchColour, Run.CellCount, false);
+}
+
+static bool MPEThinVirtualPublishVideoHeld(bool TextMode, bool FullFrame,
+                                           bool SpritePairChanged)
+{
+   if (FullFrame)
+   {
+      if (TextMode)
+      {
+         if (!AGIContinueDMA(false, MPEVirtualTerminalTextBase,
+                             MPEVirtualRAM + MPEVirtualTextScreenBase,
+                             MPEVirtualDisplayCells, false) ||
+             !AGIContinueDMA(false, MPEVirtualColourBase,
+                             MPEVirtualColour,
+                             MPEVirtualDisplayCells, false)) return false;
+      }
+      else
+      {
+         if (!AGIContinueDMA(false, MPEVirtualBitmapBase,
+                             MPEVirtualRAM + MPEVirtualBitmapBase,
+                             MPEVirtualBitmapBytes, false) ||
+             !AGIContinueDMA(false, MPEVirtualBitmapScreenBase,
+                             MPEVirtualRAM + MPEVirtualBitmapScreenBase,
+                             MPEVirtualDisplayCells, false) ||
+             !AGIContinueDMA(false, MPEVirtualColourBase,
+                             MPEVirtualColour,
+                             MPEVirtualDisplayCells, false)) return false;
+         // Always republish row 24 through the final-view accessors. They
+         // select flattened parser glyphs while active and the retained room
+         // colours after it hides; raw colour RAM contains parser colour 1.
+         MPEVirtualDirtyRun Parser = {
+            MPEVirtualParserFirstCell, MPEVirtualParserCells
+         };
+         if (!MPEThinVirtualDMARunHeld(false, Parser)) return false;
+      }
+   }
+   else
+   {
+      uint16_t Cursor = 0;
+      MPEVirtualDirtyRun Run;
+      while (MPEVirtualAGINextDirtyRun(TextMode, &Cursor, &Run))
+         if (!MPEThinVirtualDMARunHeld(TextMode, Run)) return false;
+   }
+
+   if (SpritePairChanged)
+   {
+      MPEVirtualAGICopySpritePair(MPEVirtualSpritePair);
+      if (!AGIContinueDMA(false, MPEVirtualSpritePairBase,
+                          MPEVirtualSpritePair, MPEVirtualSpriteBytes, false) ||
+          !AGIContinueDMA(false, MPEVirtualSpriteSecondBase,
+                          MPEVirtualSpritePair + MPEVirtualSpriteBytes,
+                          MPEVirtualSpriteBytes, false) ||
+          !AGIContinueDMA(false, MPEVirtualSpritePointerBase,
+                          MPEVirtualRAM + MPEVirtualSpritePointerBase,
+                          2, false)) return false;
+   }
+   return true;
+}
+
+static void MPEThinVirtualBuildFrame(uint8_t *Frame, bool TextMode,
+                                     uint8_t HostEvent,
+                                     uint32_t Generation,
+                                     uint16_t DirtyCells)
+{
+   memset(Frame, 0, MPEThinPayloadBytes);
+   memcpy(Frame, "FRA2", 4);
+   Frame[4] = 1;
+   Frame[5] = TextMode ? 0 : 1;
+   Frame[6] = HostEvent;
+   MPEThinWrite32(Frame + 8, Generation);
+   MPEThinWrite16(Frame + 12, DirtyCells);
+   for (uint8_t Index = 0; Index < 25; Index++)
+      Frame[14 + Index] = MPEVirtualAGIWireVIC(Index, TextMode);
+}
+
+static FLASHMEM bool MPEThinVirtualPresentHeld(uint8_t Status, uint32_t Sequence,
+                                      uint32_t SessionNonce,
+                                      MPEVirtualFullFrameReason FullReason,
+                                      uint8_t *PublishedFlags)
+{
+   bool TextMode = MPEVirtualAGITextMode();
+   if (FullReason == MPEVirtualFullFrameNone)
+   {
+      if (MPEVirtualAGIModeChanged(TextMode))
+         FullReason = MPEVirtualFullFrameModeChange;
+      else if (MPEVirtualAGIRoomChanged())
+         FullReason = MPEVirtualFullFrameRoomTransition;
+   }
+   bool FullFrame = FullReason != MPEVirtualFullFrameNone;
+   if (FullFrame &&
+       !MPEVirtualAGIRequestFullFrame(FullReason, TextMode)) return false;
+   MPEVirtualAGIFinalizeDirty(TextMode);
+   uint16_t DirtyCells = MPEVirtualAGIDirtyCellCount(TextMode);
+   // A true authored full-screen transition can replace every final cell
+   // without changing room or display mode.  It is the remaining permitted
+   // full-frame case; routine animation still stays cell-granular.
+   if (!FullFrame && DirtyCells == MPEVirtualDisplayCells) FullFrame = true;
+   bool VICChanged = FullFrame || DirtyCells ||
+      MPEVirtualAGIVICChanged(TextMode);
+   // A full publication is also the repair path for physical state that may
+   // have been lost after an earlier correlated response. Republish the
+   // current SID image and bitmap-mode ego pair/pointers even when they equal
+   // Teensy's last-presented shadows; equality proves VM state, not C64 RAM.
+   bool SIDChanged = FullFrame || MPEVirtualAGISIDChanged();
+   bool SpriteChanged = !TextMode &&
+      (FullFrame || MPEVirtualAGISpritePairChanged(false));
+   uint8_t HostEvent = MPEVirtualAGIHostEvent();
+   uint8_t Flags = (FullFrame ? MPEThinOutputFullFrame :
+      (DirtyCells ? MPEThinOutputDirtyCells : 0)) |
+      (SpriteChanged ? MPEThinOutputEgoPair : 0) |
+      (VICChanged ? MPEThinOutputVIC : 0) |
+      (SIDChanged ? MPEThinOutputSID : 0) |
+      (HostEvent ? MPEThinOutputHostEvent : 0);
+
+   if ((DirtyCells || FullFrame || SpriteChanged) &&
+       !MPEThinVirtualPublishVideoHeld(TextMode, FullFrame,
+                                       SpriteChanged)) return false;
+   if (SIDChanged &&
+       !MPEThinVirtualPublishSIDHeld(Sequence, SessionNonce)) return false;
+   MPEThinVirtualBuildFrame(MPEThinVirtualLastFrame, TextMode, HostEvent,
+                            MPEVirtualAGINextPresentationGeneration(),
+                            FullFrame ? MPEVirtualDisplayCells : DirtyCells);
+   if (!MPEThinPublishHeld(Status, Sequence, SessionNonce, Flags,
+                           MPEThinVirtualLastFrame,
+                           MPEThinPayloadBytes)) return false;
+   MPEThinVirtualLastStatus = Status;
+   MPEThinVirtualLastFlags = Flags;
+   MPEThinVirtualLastSID = SIDChanged;
+   *PublishedFlags = Flags;
+   return true;
+}
+
+static bool MPEThinVirtualReplayHeld(uint32_t Sequence,
+                                     uint32_t SessionNonce)
+{
+   if (MPEThinVirtualLastSID &&
+       !AGIContinueDMA(false, MPEThinSIDAddress, MPEThinSID,
+                       MPEThinEnvelopeBytes, false)) return false;
+   return MPEThinPublishHeld(MPEThinVirtualLastStatus, Sequence, SessionNonce,
+                             MPEThinVirtualLastFlags,
+                             MPEThinVirtualLastFrame,
+                             MPEThinPayloadBytes);
+}
