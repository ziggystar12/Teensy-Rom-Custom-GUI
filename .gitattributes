* text=auto eol=lf
/engine/** -text
/gui/** -text
/releases/** -text
/engine/patches/*.patch -whitespace
/engine/custom-gui/*.patch -whitespace
/engine/vendor/vrEmu6502/** -whitespace
/engine/native-dos/vendor/8086tiny/** -whitespace
/gui/** -whitespace
/releases/** -whitespace
/gui/selected-e305/Source/** -whitespace
*.hex binary
*.bin binary
*.crt binary
*.img binary
*.prg binary
*.png binary

# Current download metadata lives outside the two-file firmware folder.
/firmware/README.md text eol=lf
/docs/DESKTOP-APPS.md text eol=lf
/docs/FILE-OPERATIONS.md text eol=lf
/docs/firmware/source.lock.json -text
/firmware-version.json -text
/dos/sd-card/** -text
# Download packages, including DOS CRLF startup files, must keep verified bytes.
/vms/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/docs/firmware/SHA256SUMS.txt text eol=lf
