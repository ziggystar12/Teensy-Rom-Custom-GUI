+// MHS native scheduling entrypoint. This bypasses all wall-clock and catch-up
+// policy and advances exactly one single-player gametic.
+#ifdef MHS_NATIVE_DOOM_ADAPTER
+boolean D_BeginExternalTicControl(void);
+boolean D_RunSingleTic(void);
