diff --git a/d_loop.c b/d_loop.c
index 1939dbd..bf2d589 100644
--- a/d_loop.c
+++ b/d_loop.c
@@ -699,6 +699,89 @@ static void SinglePlayerClear(ticcmd_set_t *set)
     }
 }
 
+#ifdef MHS_NATIVE_DOOM_ADAPTER
+static int mhs_external_tic_failure;
+static unsigned int mhs_external_tic_resyncs;
+
+int D_ExternalTicFailure(void)
+{
+    return mhs_external_tic_failure;
+}
+
+unsigned int D_ExternalTicResyncs(void)
+{
+    return mhs_external_tic_resyncs;
+}
+
+boolean D_BeginExternalTicControl(void)
+{
+    mhs_external_tic_failure = 0;
+    mhs_external_tic_resyncs = 0;
+    if (loop_interface == NULL || net_client_connected || drone || ticdup != 1)
+    {
+        mhs_external_tic_failure = 1;
+        return false;
+    }
+
+    // D_DoomMain executes one legacy frame before returning. Discard any
+    // time-derived commands it left buffered when ownership moves to MHS.
+    maketic = gametic;
+    recvtic = gametic;
+    memset(ticdata, 0, sizeof(ticdata));
+    return true;
+}
+
+// Advance exactly one local gametic. Unlike TryRunTics(), this function never
+// consults a clock, waits, catches up, or runs more than one simulation step.
+// The MHS session layer owns all 35 Hz and dropped-tic policy.
+boolean D_RunSingleTic(void)
+{
+    ticcmd_set_t *set;
+    int before = gametic;
+
+    mhs_external_tic_failure = 0;
+    if (loop_interface == NULL || net_client_connected || drone || ticdup != 1)
+    {
+        mhs_external_tic_failure = 2;
+        return false;
+    }
+
+    // No original-loop command may be buffered across the ownership boundary.
+    if (maketic != gametic)
+    {
+        // No wall-clock command may enter an MHS-owned tic. Count the leak for
+        // diagnostics and fail closed rather than silently discarding it.
+        ++mhs_external_tic_resyncs;
+        mhs_external_tic_failure = 3;
+        return false;
+    }
+    if (!BuildNewTic())
+    {
+        mhs_external_tic_failure = 4;
+        return false;
+    }
+    if (maketic != gametic + 1)
+    {
+        mhs_external_tic_failure = 5;
+        return false;
+    }
+
+    set = &ticdata[gametic % BACKUPTICS];
+    SinglePlayerClear(set);
+    memcpy(local_playeringame, set->ingame, sizeof(local_playeringame));
+    loop_interface->RunTic(set->cmds, set->ingame);
+    ++gametic;
+    TicdupSquash(set);
+
+    if (gametic != before + 1)
+    {
+        mhs_external_tic_failure = 6;
+        return false;
+    }
+    return true;
+}
+#endif
