@ECHO OFF
ECHO Updating DOS startup files...
IF EXIST C:\AUTOEXEC.OLD GOTO SAVED0
IF NOT EXIST C:\AUTOEXEC.BAT GOTO SAVED0
COPY C:\AUTOEXEC.BAT C:\AUTOEXEC.OLD >NUL
IF ERRORLEVEL 1 GOTO FAILED
:SAVED0
IF EXIST C:\CONFIG.OLD GOTO SAVED1
IF NOT EXIST C:\CONFIG.SYS GOTO SAVED1
COPY C:\CONFIG.SYS C:\CONFIG.OLD >NUL
IF ERRORLEVEL 1 GOTO FAILED
:SAVED1
IF EXIST C:\FDCONFIG.OLD GOTO SAVED2
IF NOT EXIST C:\FDCONFIG.SYS GOTO SAVED2
COPY C:\FDCONFIG.SYS C:\FDCONFIG.OLD >NUL
IF ERRORLEVEL 1 GOTO FAILED
:SAVED2
COPY /Y D:\DOSVMUPD\AUTOEXEC.BAT C:\AUTOEXEC.BAT >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y D:\DOSVMUPD\CONFIG.SYS C:\CONFIG.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y D:\DOSVMUPD\FDCONFIG.SYS C:\FDCONFIG.SYS >NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO Startup updated. Reboot to use it.
GOTO DONE
:FAILED
ECHO Update failed. Original backups are in C:\*.OLD
:DONE
